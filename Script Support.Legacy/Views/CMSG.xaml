<Window x:Class="ScriptSupport.Legacy.CMSG"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:ViewModels="clr-namespace:ScriptSupport.Legacy.ViewModels"
        Background="Transparent"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Title="{Binding Titles}"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        MinHeight="150" MaxHeight="250"
        MinWidth="300" MaxWidth="500"
        Height="auto" Width="auto" >
    <materialDesign:Card UniformCornerRadius="5"
                         BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         d:FlowDirection="LeftToRight" BorderThickness="1,0,1,1" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="50" />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    BorderBrush="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    BorderThickness="0,0,0,0" Padding="10,5" MouseLeftButtonDown="Border_MouseLeftButtonDown"  >

                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontWeight="Bold"
                           Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
            </Border>

            <Grid Grid.Row="1" Margin="15,10,15,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,15,0" >
                    <Image x:Name="MessageIcon" Width="50" Height="50"
                           Visibility="{Binding IconVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" >
                    <TextBox Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" IsReadOnly="True"
                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Text="{Binding Message, RelativeSource={RelativeSource AncestorType=Window}}"
                             materialDesign:TextFieldAssist.UnderlineBrush="Transparent" />
                </ScrollViewer>
            </Grid>

            <ItemsControl Grid.Row="2" HorizontalAlignment="Center" Margin="10,0,10,10"
                      ItemsSource="{Binding Buttons, RelativeSource={RelativeSource AncestorType=Window}}" >
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Text}"
                                Height="30" Margin="5" Padding="15,5" IsDefault="{Binding IsDefault}" Click="Button_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MessageBoxPrimaryButtonStyle}" >
                                    <Setter Property="MinWidth" Value="80"/>
                                    <Setter Property="FocusVisualStyle">
                                        <Setter.Value>
                                            <Style TargetType="Control">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Control">
                                                            <Border BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderThickness="5">
                                                                <ContentPresenter/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </materialDesign:Card>
</Window>