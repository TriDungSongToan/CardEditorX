<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="ScriptSupport.Legacy.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
      <section name="Search_Support.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="gitpath" value="C:\Program Files\Git\cmd\git.exe" />
    <add key="yamlyugiURL" value="https://github.com/DawnbrandBots/yaml-yugi" />
    <add key="CardDataURL" value="https://github.com/TriDungSongToan/CardData.git" />
    <add key="scrapiyardURL" value="https://github.com/ProjectIgnis/scrapiyard.git" />
    <add key="scrapibookURL" value="https://github.com/ProjectIgnis/scrapi-book.git" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
  <userSettings>
    <ScriptSupport.Legacy.Properties.Settings>
      <setting name="MainWindow" serializeAs="String">
        <value>100,100,600,650</value>
      </setting>
      <setting name="controlsize" serializeAs="String">
        <value>210,300,150</value>
      </setting>
      <setting name="datasource" serializeAs="String">
        <value>C:\ProjectIgnis</value>
      </setting>
      <setting name="darkmode" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="HighLight" serializeAs="String">
        <value>Default</value>
      </setting>
      <setting name="FontFamily" serializeAs="String">
        <value>Consolas</value>
      </setting>
      <setting name="FontSize" serializeAs="String">
        <value>12</value>
      </setting>
      <setting name="wordwrap" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="allowsave" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="listheadercard" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="listheaderscrapi" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="listheaderdesc" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="autosearch" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="Background" serializeAs="String">
        <value>#FF000000</value>
      </setting>
      <setting name="Foreground" serializeAs="String">
        <value>#FFFFFFFF</value>
      </setting>
      <setting name="allownew" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="Theme" serializeAs="String">
        <value>DeepPurple</value>
      </setting>
      <setting name="browserPath" serializeAs="String">
        <value />
      </setting>
      <setting name="maxItem" serializeAs="String">
        <value>100</value>
      </setting>
      <setting name="Language" serializeAs="String">
        <value>English</value>
      </setting>
      <setting name="Game" serializeAs="String">
        <value>EDOPro</value>
      </setting>
      <setting name="FlowDirectionC" serializeAs="String">
        <value>0</value>
      </setting>
      <setting name="TextAlignmentC" serializeAs="String">
        <value>0</value>
      </setting>
    </ScriptSupport.Legacy.Properties.Settings>
  </userSettings>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>