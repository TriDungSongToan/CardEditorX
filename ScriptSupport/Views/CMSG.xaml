<Window x:Class="ScriptSupport.Views.CMSG"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ScriptSupport.Views"
        xmlns:ViewModels="clr-namespace:ScriptSupport.ViewModels"
        Background="Transparent"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:CMSG, IsDesignTimeCreatable=False}"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        MinHeight="150" MaxHeight="250"
        MinWidth="300" MaxWidth="500"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Height="auto" Width="auto" >
    <materialDesign:Card UniformCornerRadius="5"
                         BorderBrush="{Binding UIConfig.ThemeColor}"
                         Background="{Binding UIConfig.Background}"
                         FlowDirection="{Binding UIConfig.FlowDirection}"
                         d:FlowDirection="LeftToRight" BorderThickness="1,0,1,1" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="50" />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="28"
                    Background="{Binding UIConfig.ThemeColor}"
                    BorderBrush="{Binding UIConfig.Foreground}"
                    BorderThickness="0" Padding="0"
                    MouseLeftButtonDown="Border_MouseLeftButtonDown" >
                <StackPanel Orientation="Horizontal" >

                    <Image x:Name="MessageIconHeader" Width="20" Height="20" Margin="5,0,5,0"
                           Visibility="{Binding IconVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding UIConfig.Foreground}"
                               FontFamily="{Binding UIConfig.FontFamily}"
                               FontSize="{Binding UIConfig.FontSize}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="15,10,15,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,15,0" >
                    <Image x:Name="MessageIcon" Width="50" Height="50"
                           Visibility="{Binding IconVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>

                <TextBox Grid.Column="1" TextWrapping="Wrap" IsReadOnly="True"
                         VerticalAlignment="Center" TextAlignment="Left" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                         Foreground="{Binding UIConfig.Foreground}"
                         FontFamily="{Binding UIConfig.FontFamily}"
                         FontSize="{Binding UIConfig.FontSize}"
                         Text="{Binding Message, RelativeSource={RelativeSource AncestorType=Window}}"
                         materialDesign:TextFieldAssist.UnderlineBrush="Transparent" />
            </Grid>

            <ItemsControl Grid.Row="2" HorizontalAlignment="Center" Margin="10,0,10,10"
                          ItemsSource="{Binding Buttons, RelativeSource={RelativeSource AncestorType=Window}}" >
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Text}" Height="30" Margin="5" Padding="15,5"
                                IsDefault="{Binding IsDefault}" Click="Button_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignPaperSecondaryDarkButton}" >
                                    <Setter Property="MinWidth" Value="80"/>
                                    <Setter Property="Background" Value="{Binding UIConfig.ThemeColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="Foreground" Value="{Binding UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="BorderBrush" Value="{Binding UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsDefault" Value="True">
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                            <Setter Property="BorderBrush" Value="{Binding UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </materialDesign:Card>
</Window>
