<UserControl x:Class="CardEditor.UserControls.BanListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
             xmlns:viewport="clr-namespace:Han.Wpf.ViewportControl;assembly=Han.Wpf.ViewportControl"
             xmlns:sdl="clr-namespace:Sdl.MultiSelectComboBox.Themes.Generic;assembly=Sdl.MultiSelectComboBox"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
             xmlns:Converter="clr-namespace:CardEditor.Converter"
             xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
             xmlns:Lag="clr-namespace:CardEditor.Localization" 
             xmlns:main="clr-namespace:CardEditor"
             mc:Ignorable="d"
             Margin="3,0,3,0"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Medium"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             FontFamily="{DynamicResource MaterialDesignFont}"
             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
             UseLayoutRounding="False"
             SnapsToDevicePixels="False"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="CustomDataGridHeaderStyle" TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   Height="15" Margin="0" Padding="0" TextAlignment="Left" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="CenterDataGridCellElementStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="3,2,3,2"/>
                <Setter Property="Padding" Value="2"/>
            </Style>

            <Style x:Key="LeftDataGridCellElementStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="3,2,3,2"/>
                <Setter Property="Padding" Value="2"/>
            </Style>

            <Style x:Key="CellWithBorderStyleBanned" TargetType="DataGridCell">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0.5,0.3,0.3,0" />
                <Setter Property="BorderBrush" Value="#ff0000" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CellWithBorderStyleLimited" TargetType="DataGridCell">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0.5,0.3,0.3,0" />
                <Setter Property="BorderBrush" Value="#ff8a00" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CellWithBorderStyleSemiLimited" TargetType="DataGridCell">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0.5,0.3,0.3,0" />
                <Setter Property="BorderBrush" Value="Yellow" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CellWithBorderStyleUnLimited" TargetType="DataGridCell">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0.5,0.3,0.3,0" />
                <Setter Property="BorderBrush" Value="#00ff0b" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BaseDataGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="MinHeight" Value="25" />
                <Setter Property="MaxHeight" Value="31" />
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridRow">
                            <Border x:Name="DGR_Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <SelectiveScrollingGrid>
                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </SelectiveScrollingGrid.ColumnDefinitions>
                                    <SelectiveScrollingGrid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </SelectiveScrollingGrid.RowDefinitions>
                                    <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    <DataGridDetailsPresenter Grid.Row="1" Grid.Column="1" Visibility="{TemplateBinding DetailsVisibility}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </SelectiveScrollingGrid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource DataGridRowMouseBackground}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DataGridRowMouseOverForeground}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource DataGridRowMouseBackground}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DataGridRowSelectedForeground}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource DataGridRowMouseBackground}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DataGridRowSelectedForeground}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.ControlTemplate.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.DropdownItemTemplate.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.SelectedItemTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <materialDesign:Card Margin="0" Background="Transparent"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                             FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             d:FlowDirection="LeftToRight" >
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="295" />
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            BorderThickness="1" Padding="1" BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" >
                                <ComboBox x:Name="cmbBanList" Height="39" BorderThickness="0.8" Padding="8,15,8,2" IsEditable="False"
                                          BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                          Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                          Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                          FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                          FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                          ItemsSource="{Binding BanLists, Source={x:Static ViewModels:BanListRawDataViewModel.Instance}}"
                                          SelectedItem="{Binding SelectedBanList, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                          SelectionChanged="cmbBanList_SelectionChanged"
                                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                          materialDesign:ColorZoneAssist.Mode="Custom"
                                          materialDesign:HintAssist.Hint="{Lag:Localize BanList}"
                                          Style="{StaticResource MaterialDesignFilledComboBox}"
                                          TextOptions.TextFormattingMode="Display"
                                          TextOptions.TextRenderingMode="ClearType"
                                          materialDesign:TextFieldAssist.HasClearButton="True"
                                          materialDesign:TextFieldAssist.TextFieldCornerRadius="3" 
                                          materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,1,0,0" >
                                <TextBox x:Name="txtBanListName" Height="39" Padding="5,15,8,2" Margin="0"
                                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"
                                         VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0.7"
                                         TextAlignment="{Binding TextAlignmentC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                         BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                         Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                         FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                         FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                         materialDesign:HintAssist.Hint="{Lag:Localize BanListName}"
                                         Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                         Text="{Binding BanListName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         TextOptions.TextFormattingMode="Display"
                                         TextOptions.TextRenderingMode="ClearType"
                                         materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                                         materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                         materialDesign:ThemeAssist.Theme="Dark" />
                            </Grid>

                            <Grid Grid.Row="2" Margin="10,3,10,3" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>

                                <Viewbox Grid.Column="0" HorizontalAlignment="Left"
                                         Margin="0" Stretch="None" StretchDirection="Both" >
                                    <TextBlock Text="{Lag:Localize WhiteList}"
                                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Style="{StaticResource MaterialDesignTextBlock}" />
                                </Viewbox>
                                <ToggleButton x:Name="tbtnConfirmClear" Grid.Column="1" Panel.ZIndex="2"
                                              IsChecked="{Binding WhiteList}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center" 
                                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                              Width="auto" Height="26" Margin="0" >
                                    <ToggleButton.Content>
                                        <materialDesign:PackIcon Kind="CloseThick" Foreground="Red" Width="auto" Height="24" Padding="0" Margin="0" />
                                    </ToggleButton.Content>
                                    <materialDesign:ToggleButtonAssist.OnContent>
                                        <materialDesign:PackIcon Kind="CheckOutline" Width="20" Height="20" />
                                    </materialDesign:ToggleButtonAssist.OnContent>
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchSecondaryToggleButton}" >
                                            <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOffBackground" Value="Red" />
                                            <Setter Property="Background" Value="Red" />
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOnBackground" Value="Blue" />
                                                    <Setter Property="Background" Value="Green" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </Grid>

                            <Grid Grid.Row="3" Margin="2,0,2,0" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Button x:Name="btnNew" Grid.Row="0" Grid.Column="0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0" Padding="3" Height="28" BorderThickness="0"
                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                        Command="{Binding NewBanListCommand}" Style="{StaticResource ButtonSuccess}" >
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFA5FFDC" Offset="0.0"/>
                                            <GradientStop Color="#FF19CB00" Offset="0.3"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Content>
                                        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                            <TextBlock Text="{Lag:Localize tNew}"
                                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Viewbox>
                                    </Button.Content>
                                </Button>

                                <Button x:Name="btnOpen" Grid.Row="0" Grid.Column="2"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0" Padding="3" Height="28" BorderThickness="0"
                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                        Command="{Binding OpenBanListCommand}" Style="{StaticResource ButtonSuccess}" >

                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFA5FFDC" Offset="0.0"/>
                                            <GradientStop Color="#FF19CB00" Offset="0.3"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Content>
                                        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                            <TextBlock Text="{Lag:Localize Open}"
                                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Viewbox>
                                    </Button.Content>
                                </Button>

                                <Button x:Name="btnSave" Grid.Row="0" Grid.Column="4"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0" Padding="3" Height="28" BorderThickness="0"
                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                        Command="{Binding SaveBanListCommand}" Style="{StaticResource ButtonSuccess}" >
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFA5FFDC" Offset="0.0"/>
                                            <GradientStop Color="#FF19CB00" Offset="0.3"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Content>
                                        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                            <TextBlock Text="{Lag:Localize Save}"
                                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Viewbox>
                                    </Button.Content>
                                </Button>

                                <Button x:Name="btnDelete" Grid.Row="2" Grid.Column="0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0" Padding="3" Height="28" BorderThickness="0"
                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                        Command="{Binding DeleteBanListCommand}" Style="{StaticResource ButtonSuccess}" >
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFA5AA" Offset="0.0" />
                                            <GradientStop Color="#FFF01717" Offset="0.4" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Content>
                                        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                            <TextBlock Text="{Lag:Localize tlDelete}"
                                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Viewbox>
                                    </Button.Content>
                                </Button>
                                
                                <Button x:Name="btnClear" Grid.Row="2" Grid.Column="2"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0" Padding="3" Height="28" BorderThickness="0"
                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                        Command="{Binding ClearBanListCommand}" Style="{StaticResource ButtonSuccess}" >
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" >
                                            <GradientStop Color="#FFFFCCA0" Offset="0.0" />
                                            <GradientStop Color="#FFFF8921" Offset="0.3"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Content>
                                        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                            <TextBlock Text="{Lag:Localize tlClear}"
                                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Viewbox>
                                    </Button.Content>
                                </Button>

                                <Button x:Name="btnBrowse" Grid.Row="2" Grid.Column="4"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0" Padding="3" Height="28" BorderThickness="0"
                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                        Command="{Binding BrowseCommand}" Style="{StaticResource ButtonSuccess}" >

                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFC830FF" Offset="0.0"/>
                                            <GradientStop Color="#FF7B00FF" Offset="0.35"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Content>
                                        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                            <TextBlock Text="{Lag:Localize Browse}"
                                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Viewbox>
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Popup x:Name="popNewBanList" PlacementTarget="{Binding ElementName=btnSave}" Placement="Right"
                           VerticalOffset="0" HorizontalOffset="0" StaysOpen="False"
                           AllowsTransparency="True" IsOpen="False" d:IsOpen="True" >
                        <Border BorderThickness="2,1,2,1" CornerRadius="5" Padding="0"
                                Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                            <Grid Width="450" Margin="3" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" VerticalAlignment="Center" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="2" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="2" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="2" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Button x:Name="btnCreateNewBanList" Content="{Lag:Localize tNew}"
                                            Grid.Row="0" Height="auto" Width="auto" Margin="0" Padding="8,2,8,2"
                                            BorderThickness="0" BorderBrush="Transparent"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            Background="#4CAF50"
                                            Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            Command="{Binding CreateNewBanListCommand}" />
                                    <Button x:Name="btnReNameBanList" Content="{Lag:Localize Rename}"
                                            Grid.Row="2" Height="auto" Width="auto" Margin="0" Padding="8,2,8,2"
                                            BorderThickness="0" BorderBrush="Transparent"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            Background="#FF9800"
                                            Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            Command="{Binding ReNameBanListCommand}" />
                                    <Button x:Name="btnSaveAsBanList" Content="{Lag:Localize SaveAs}"
                                            Grid.Row="4" Height="auto" Width="auto" Margin="0" Padding="8,2,8,2"
                                            BorderThickness="0" BorderBrush="Transparent"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            Background="#1976D2"
                                            Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            Command="{Binding SaveAsBanListCommand}" />
                                    <Button x:Name="btnBrowseNewPath" Content="{Lag:Localize Browse}"
                                            Grid.Row="6" Height="auto" Width="auto" Margin="0" Padding="8,2,8,2"
                                            BorderThickness="0" BorderBrush="Transparent"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            Background="#7E57C2"
                                            Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            Command="{Binding BrowseNewPathCommand}" />
                                </Grid>

                                <Grid Grid.Column="2" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="2" />
                                        <RowDefinition Height="*" />
