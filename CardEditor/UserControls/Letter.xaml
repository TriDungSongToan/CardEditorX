<UserControl x:Class="CardEditor.UserControls.Letter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CardEditor.UserControls"
             xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             d:DesignHeight="100" d:DesignWidth="100">
    
    <Grid>
        <Viewbox Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <Grid Width="100" Height="100"
                  HorizontalAlignment="Center" VerticalAlignment="Center" >

                <Grid x:Name="RotatingGrid"
                      Width="100" Height="100" ClipToBounds="False"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      RenderTransformOrigin="0.5,0.5" >
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="RotationTransform" Angle="0"/>
                    </Grid.RenderTransform>

                    <Grid.Resources>
                        <Storyboard x:Key="RotateStoryboard" RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="RotationTransform"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:8"/>
                        </Storyboard>
                    </Grid.Resources>

                    <Image x:Name="ImgLogoCircle" Stretch="Uniform"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>

                <Image x:Name="ImgLogoX" Margin="3" IsHitTestVisible="False"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                       Stretch="Uniform" />
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
