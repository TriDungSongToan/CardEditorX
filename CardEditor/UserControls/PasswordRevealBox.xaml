<UserControl x:Class="CardEditor.UserControls.PasswordRevealBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
             xmlns:viewport="clr-namespace:Han.Wpf.ViewportControl;assembly=Han.Wpf.ViewportControl"
             xmlns:sdl="clr-namespace:Sdl.MultiSelectComboBox.Themes.Generic;assembly=Sdl.MultiSelectComboBox"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
             xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
             xmlns:Converter="clr-namespace:CardEditor.Converter"
             xmlns:Lag="clr-namespace:CardEditor.Localization"
             xmlns:main="clr-namespace:CardEditor"
             xmlns:Commands="clr-namespace:CardEditor.Commands"
             mc:Ignorable="d"
             Margin="3,0,3,0"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Medium"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             x:Name="root"
             FontFamily="{DynamicResource MaterialDesignFont}"
             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
             UseLayoutRounding="False"
             SnapsToDevicePixels="False"
             KeyDown="UserControl_KeyDown"
             d:DesignHeight="40" d:DesignWidth="200">

    <UserControl.Resources>
        <Converter:PositiveBoolToVisibilityConverter x:Key="PositiveBoolToVis"/>
        <Converter:NegativeBoolToVisibilityConverter x:Key="NegativeBoolToVis"/>
    </UserControl.Resources>

    <Border x:Name="BorderRoot" CornerRadius="3" BorderThickness="1" Padding="0,0,0,0"
            Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
            BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
        <Grid x:Name="GridRoot" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PART_TextBox" Grid.Column="0" Height="43" Padding="10,18,3,5"
                     BorderThickness="0" BorderBrush="Transparent" Background="Transparent"
                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                     materialDesign:HintAssist.Hint="{Binding Hint, ElementName=root}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     TextOptions.TextFormattingMode="Display"
                     TextOptions.TextRenderingMode="ClearType"
                     materialDesign:TextFieldAssist.HasOutlinedTextField="False"
                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" />

            <PasswordBox x:Name="PART_PasswordBox" Grid.Column="0" Height="43" Padding="10,13,3,0"
                         BorderThickness="0" BorderBrush="Transparent" Background="Transparent"
                         Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                         materialDesign:HintAssist.Hint="{Binding Hint, ElementName=root}"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         TextOptions.TextFormattingMode="Display"
                         TextOptions.TextRenderingMode="ClearType"
                         materialDesign:TextFieldAssist.HasOutlinedTextField="False"
                         materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                         materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" />
            
            <ToggleButton x:Name="PART_ToggleButton" Grid.Column="1"
                          Margin="0" Padding="0"
                          Height="{Binding ActualHeight, ElementName=GridRoot}"
                          Width="{Binding ActualHeight, ElementName=GridRoot}"
                          Background="Transparent"
                          Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Click="PART_ToggleButton_Click"
                          Content="{materialDesign:PackIcon Kind=EyeOutline}"
                          materialDesign:ToggleButtonAssist.OnContent="{materialDesign:PackIcon Kind=EyeOffOutline}"
                          Style="{StaticResource MaterialDesignActionLightToggleButton}"/>
            
        </Grid>
    </Border>
</UserControl>
