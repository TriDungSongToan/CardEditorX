<UserControl x:Class="CardEditor.UserControls.ScriptDescription"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:UserControls="clr-namespace:CardEditor.UserControls"
             xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
             mc:Ignorable="d" 
             Background="Transparent"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.DataContext>
        <ViewModels:ScriptDescriptionViewModel />
    </UserControl.DataContext>

    <Border x:Name="BorderRoot" CornerRadius="3" BorderThickness="1" MaxWidth="800" Padding="10,3,0,0"
            Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
            BorderBrush="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
        <Grid>
            <avalonEdit:TextEditor x:Name="ScriptDescriptionPane"
                       xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
                       Document="{Binding Document}" IsReadOnly="True" ShowLineNumbers="False"
                       Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                       FontSize="13"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"
                       HorizontalContentAlignment="Left"
                       VerticalContentAlignment="Top"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       SyntaxHighlighting="{Binding SyntaxHighlighting, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                       WordWrap="True" >
                <avalonEdit:TextEditor.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        <Setter Property="Opacity" Value="0.5" />
                    </Style>
                </avalonEdit:TextEditor.Resources>
            </avalonEdit:TextEditor>
        </Grid>
    </Border>
</UserControl>
