<UserControl x:Class="CardEditor.UserControls.DataEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
             xmlns:viewport="clr-namespace:Han.Wpf.ViewportControl;assembly=Han.Wpf.ViewportControl"
             xmlns:sdl="clr-namespace:Sdl.MultiSelectComboBox.Themes.Generic;assembly=Sdl.MultiSelectComboBox"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
             xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
             xmlns:Converter="clr-namespace:CardEditor.Converter"
             xmlns:Lag="clr-namespace:CardEditor.Localization"
             xmlns:main="clr-namespace:CardEditor"
             xmlns:Commands="clr-namespace:CardEditor.Commands"
             mc:Ignorable="d"
             Margin="3,0,3,0"
             x:Name="dataEditorControl"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Medium"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             FontFamily="{DynamicResource MaterialDesignFont}"
             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             UseLayoutRounding="False"
             SnapsToDevicePixels="False"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="800" d:DesignWidth="1200">
    <!--DataContext="{Binding Source={x:Static ViewModels:UIConfigViewModel.Instance}}"-->
    <UserControl.Resources>
        <ResourceDictionary>
            <Converter:PositiveBoolToVisibilityConverter x:Key="PositiveBoolToVis"/>
            <Converter:NegativeBoolToVisibilityConverter x:Key="NegativeBoolToVis"/>

            <Style x:Key="CustomDataGridHeaderStyle" TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   Height="20" Margin="0" Padding="0" TextAlignment="Left" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="CenterDataGridCellElementStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="3,2,3,2"/>
                <Setter Property="Padding" Value="2"/>
            </Style>

            <Style x:Key="LeftDataGridCellElementStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="3,2,3,2"/>
                <Setter Property="Padding" Value="2"/>
            </Style>

            <Style x:Key="CellWithBorderStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0.3,0.4,0.3,0.4"/>
                <Setter Property="BorderBrush" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="MaxHeight" Value="26" />
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridRow">
                            <Border x:Name="DGR_Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <SelectiveScrollingGrid>
                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </SelectiveScrollingGrid.ColumnDefinitions>
                                    <SelectiveScrollingGrid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </SelectiveScrollingGrid.RowDefinitions>
                                    <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    <DataGridDetailsPresenter Grid.Row="1" Grid.Column="1" Visibility="{TemplateBinding DetailsVisibility}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </SelectiveScrollingGrid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DGR_Border" Property="Background" Value="#FFE0F7FF"/>
                                    <Setter Property="Foreground" Value="Blue" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="DGR_Border" Property="Background" Value="#FF1976D2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="DGR_Border" Property="Background" Value="#FF1976D2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.ControlTemplate.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.DropdownItemTemplate.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.SelectedItemTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <materialDesign:Card Margin="0,1,0,0" Background="Transparent"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                             FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             d:FlowDirection="LeftToRight" >
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,1,0,2" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Border Margin="0" Grid.Column="0" Padding="0" BorderThickness="1"
                        Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                        BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                        Panel.ZIndex="0" >
                    <DataGrid x:Name="datagrMain" BorderThickness="1" Margin="0" Padding="0"
                              Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                              CanUserDeleteRows="False" CanUserResizeColumns="True" CanUserSortColumns="False"
                              CanUserAddRows="False" SelectionChanged="datagrMain_SelectionChanged"
                              CanUserReorderColumns="True" CanUserResizeRows="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ItemsSource="{Binding CollectionViewCollection, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              AutoGenerateColumns="False" HeadersVisibility="Column" 
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.IsContainerVirtualizable="True"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              DragEnter="datagrMain_DragEnter"
                              Drop="datagrMain_Drop"
                              AllowDrop="True" >

                        <DataGrid.Columns>
                            <materialDesign:DataGridTextColumn Header="{Lag:Localize dataGridID}" Binding="{Binding id}"
                                                               Width="100" MinWidth="80" MaxWidth="120"
                                                               EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"
                                                               HeaderStyle="{StaticResource CustomDataGridHeaderStyle}"
                                                               ElementStyle="{StaticResource CenterDataGridCellElementStyle}"
                                                               CellStyle="{StaticResource CellWithBorderStyle}" />

                            <materialDesign:DataGridTextColumn Header="{Lag:Localize cardName}" Binding="{Binding name}"
                                                               Width="*" MinWidth="200"
                                                               EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"
                                                               HeaderStyle="{StaticResource CustomDataGridHeaderStyle}"
                                                               ElementStyle="{StaticResource CenterDataGridCellElementStyle}"
                                                               CellStyle="{StaticResource CellWithBorderStyle}" />
                        </DataGrid.Columns>
                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Background" Value="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                <Setter Property="Opacity" Value="0.5" />
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Border>

                <Grid Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1" >
                    <Button x:Name="btnsearch" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Margin="0,7,3,0" Padding="0" Height="28"
                            FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                            ToolTip="{Lag:Localize toolSearch}" Command="{Binding FilterCardCommand}"
                            Style="{StaticResource ButtonPrimary}" BorderThickness="0" >
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" >
                                <GradientStop Color="#FF00EDFF" Offset="0.0" />
                                <GradientStop Color="#FF1B8CFF" Offset="0.3" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Content>
                            <Grid Width="100">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="25" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="1" x:Name="iconsearch" Margin="0" Padding="0"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         Kind="FilterMultipleOutline" Width="25" Height="25" />
                                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="Both">
                                    <TextBlock Text="{Lag:Localize tlFilter}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Viewbox>
                            </Grid>
                        </Button.Content>
                        <Button.ContextMenu>
                            <ContextMenu Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                         Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                         FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                         FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"  >
                                <MenuItem x:Name="menuadvanFil" Header="{Lag:Localize advanFil}" Command="{Binding AdvancedFilterCommand}" />
                                <MenuItem x:Name="ClearFil" Header="{Lag:Localize clearFilter}" Command="{Binding ClearFilterCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <Grid Grid.Column="2" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <TextBox x:Name="txtcardname" Height="48" Padding="10,10,3,0" Margin="0"
                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                 VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0.8" 
                                 TextAlignment="{Binding TextAlignmentC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"  
                                 BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                 Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                 FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                 FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                 materialDesign:HintAssist.Hint="{Lag:Localize cardName}"
                                 Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                 TextOptions.TextFormattingMode="Display"
                                 TextOptions.TextRenderingMode="ClearType"
                                 materialDesign:TextFieldAssist.HasFilledTextField="False"
                                 materialDesign:TextFieldAssist.HasOutlinedTextField="False"
                                 materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                 materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                 materialDesign:ThemeAssist.Theme="Dark" />
                    </Grid>

                    <Grid Grid.Row="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="255.2" Height="372.5" Panel.ZIndex="0" Cursor="Hand" BorderThickness="0"
                                Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                DragEnter="imagecard_DragEnter" Drop="imagecard_Drop" AllowDrop="True"
                                MouseLeftButtonDown="imagecard_MouseLeftButtonDown" >
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                <viewport:Viewport x:Name="ViewportImage" Grid.Row="0" Width="255.2" Height="372.5" Panel.ZIndex="0"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip="{Lag:Localize toolCardImg}"
                                                   MinZoom="1" MaxZoom="10" ZoomSpeed="1.1" SnapsToDevicePixels="True" UseLayoutRounding="True" >
                                    <Image x:Name="imagecard"
                                           Source="pack://application:,,,/Images/Blank.png"
                                           Stretch="Uniform" Cursor="Hand" />
                                </viewport:Viewport>

                                <Grid x:Name="grArtWork" Grid.Row="0" >
                                    <Border x:Name="blArtworkFull" BorderThickness="0" Padding="0"
                                            Visibility="{Binding imageSetting.FullArt, Source={x:Static ViewModels:ConfigViewModel.Instance}, Converter={StaticResource NegativeBoolToVis}}"
                                            Width="255.2" Height="372.5" Panel.ZIndex="1" Cursor="Hand"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                        <Image x:Name="ImgArtWorkFull" IsHitTestVisible="False"
                                               Width="255.2" Height="372.5" Panel.ZIndex="1"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                               Stretch="Uniform" Cursor="Hand" />
                                    </Border>
                                    <Canvas x:Name="cvArtWorkNor" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            Visibility="{Binding imageSetting.FullArt, Source={x:Static ViewModels:ConfigViewModel.Instance}, Converter={StaticResource PositiveBoolToVis}}"
                                            Background="{x:Null}" Panel.ZIndex="3" >
                                        <Border x:Name="blArtworkNor" BorderThickness="0" Padding="4"
                                                Visibility="{Binding IsPendulumIntf, Converter={StaticResource PositiveBoolToVis}}"
                                                Width="199" Height="199" Canvas.Left="26" Canvas.Top="63" Cursor="Hand"
                                                MouseLeftButtonDown="blArtwork_MouseLeftButtonDown"
                                                DragEnter="blArtwork_DragEnter" Drop="blArtwork_Drop" AllowDrop="True">
                                            <Border.Background>
                                                <ImageBrush ImageSource="/Images/DataEditor/ArtBorderNormal.png" />
                                            </Border.Background>
                                            <Image x:Name="ImgArtWorkNor" Panel.ZIndex="1"
                                                   Source="pack://application:,,,/Images/Logo.ico" ToolTip="{Lag:Localize toolCardImg}"
                                                   Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Border>
                                        <Border x:Name="blArtworkPen" BorderThickness="0" Padding="4"
                                                Visibility="{Binding IsPendulumIntf, Converter={StaticResource NegativeBoolToVis}}"
                                                Width="223" Height="211" Canvas.Left="14" Canvas.Top="63" Cursor="Hand"
                                                MouseLeftButtonDown="blArtwork_MouseLeftButtonDown"
                                                DragEnter="blArtwork_DragEnter" Drop="blArtwork_Drop" AllowDrop="True">
                                            <Border.Background>
                                                <ImageBrush ImageSource="/Images/DataEditor/ArtBorderNormal.png" />
                                            </Border.Background>
                                            <Image x:Name="ImgArtWorkPen" Panel.ZIndex="1"
                                                   Source="pack://application:,,,/Images/Logo.ico" ToolTip="{Lag:Localize toolCardImg}"
                                                   Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </Border>
                                    </Canvas>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2" Width="560" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderThickness="0.7" CornerRadius="5"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}">
                                    <Grid Grid.Column="0" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>

                                        <sdl:MultiSelectComboBox x:Name="cmbrule" Grid.Column="0" Height="55" Margin="0" Padding="0"
                                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                             HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                             IsEnabled="True" MaxDropDownHeight="300" IsEditable="True"
                                                             ClearFilterOnDropdownClosing="True" SelectionMode="Multiple"
                                                             EnableAutoComplete="True" EnableBatchSelection="True"
                                                             EnableFiltering="True" EnableGrouping="True"
                                                             ClearSelectionOnFilterChanged="True"
                                                             Style="{StaticResource MultiSelectComboBox.Custom.Style}"
                                                             ItemsSource="{Binding RuleItems, Source={x:Static ViewModels:CardDataViewModel.Instance}}"
                                                             SelectedItemsChanged="cmbrule_SelectedItemsChanged" >
                                            <sdl:MultiSelectComboBox.DropdownItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding RuleName}" Margin="5"
                                                               Background="{Binding Background, ElementName=cmbrule}"
                                                               Foreground="{Binding Foreground, ElementName=cmbrule}"
                                                               FontFamily="{Binding FontFamily, ElementName=cmbrule}"
                                                               FontSize="{Binding FontSize, ElementName=cmbrule}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </sdl:MultiSelectComboBox.DropdownItemTemplate>
                                            <sdl:MultiSelectComboBox.SelectedItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding RuleName}" Margin="5,0,5,0"
                                                           Foreground="{Binding Foreground, ElementName=cmbrule}" />
                                                </DataTemplate>
                                            </sdl:MultiSelectComboBox.SelectedItemTemplate>
                                        </sdl:MultiSelectComboBox>
                                        <TextBlock x:Name="tbrule" Grid.Column="0" Opacity="0.5" Margin="0,3,25,0"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Text="{Lag:Localize cardLabelScope}" IsHitTestVisible="False"
                                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"  />
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" BorderThickness="0.7" CornerRadius="5"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}">
                                    <Grid Grid.Column="2" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <sdl:MultiSelectComboBox x:Name="cmbcardtype" Grid.Column="0" Height="55" Margin="0" Padding="0"
                                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                             HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                             IsEnabled="True" MaxDropDownHeight="300" IsEditable="True"
                                                             ClearFilterOnDropdownClosing="True" SelectionMode="Multiple"
                                                             EnableAutoComplete="True" EnableBatchSelection="True"
                                                             EnableFiltering="True" EnableGrouping="True"
                                                             ClearSelectionOnFilterChanged="True"
                                                             Style="{StaticResource MultiSelectComboBox.Custom.Style}"
                                                             ItemsSource="{Binding TypeItems, Source={x:Static ViewModels:CardDataViewModel.Instance}}"
                                                             SelectedItemsChanged="cmbcardtype_SelectedItemsChanged" >
                                            <sdl:MultiSelectComboBox.DropdownItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TypeName}" Margin="5"
                                                               Background="{Binding Background, ElementName=cmbcardtype}"
                                                               Foreground="{Binding Foreground, ElementName=cmbcardtype}"
                                                               FontFamily="{Binding FontFamily, ElementName=cmbcardtype}"
                                                               FontSize="{Binding FontSize, ElementName=cmbcardtype}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </sdl:MultiSelectComboBox.DropdownItemTemplate>
                                            <sdl:MultiSelectComboBox.SelectedItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TypeName}" Margin="5,0,5,0"
                                                           Foreground="{Binding Foreground, ElementName=cmbcardtype}" />
                                                </DataTemplate>
                                            </sdl:MultiSelectComboBox.SelectedItemTemplate>
                                        </sdl:MultiSelectComboBox>
                                        <TextBlock x:Name="tbtype" Grid.Column="0" Opacity="0.5" Margin="0,3,25,0"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Text="{Lag:Localize cardLabelType}" IsHitTestVisible="False"
                                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,2,0,0" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="grRace" Grid.Column="0" BorderThickness="0.7" CornerRadius="5"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Visibility="{Binding IsSkillIntf, Converter={StaticResource PositiveBoolToVis}}"
                                        BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <sdl:MultiSelectComboBox x:Name="cmbcardrace" Grid.Column="0" Height="35" Margin="0" Padding="0"
                                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                             HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                             IsEnabled="True" MaxDropDownHeight="300" IsEditable="True"
                                                             ClearFilterOnDropdownClosing="True" SelectionMode="Multiple"
                                                             EnableAutoComplete="True" EnableBatchSelection="True"
                                                             EnableFiltering="True" EnableGrouping="True"
                                                             ClearSelectionOnFilterChanged="True"
                                                             Style="{StaticResource MultiSelectComboBox.Custom.Style}"
                                                             ItemsSource="{Binding RaceItems, Source={x:Static ViewModels:CardDataViewModel.Instance}}"
                                                             SelectedItemsChanged="cmbcardrace_SelectedItemsChanged" >
                                            <sdl:MultiSelectComboBox.DropdownItemTemplate>
                                                <DataTemplate>
