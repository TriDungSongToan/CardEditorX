<UserControl x:Class="CardEditor.UserControls.ImageEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
             xmlns:webView="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:Lag="clr-namespace:CardEditor.Localization"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded"
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid x:Name="RootGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          DragOver="RootGrid_DragOver" AllowDrop="True" >

        <webView:WebView2 x:Name="WebViewControl"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />


        <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" >
            <RichTextBox HorizontalAlignment="Center" VerticalAlignment="Center"
                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         Background="Transparent" FontSize="23" BorderThickness="0" IsReadOnly="True"
                         FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         materialDesign:TextFieldAssist.UnderlineBrush="Transparent" >
                <FlowDocument>
                    <Paragraph TextAlignment="Center" >
                        🚧
                        <Run Text=" We are " TextDecorations="Strikethrough" />
                        I'm working on this feature.
                    </Paragraph>
                    <Paragraph TextAlignment="Center" >
                        (Yes, it's just me, caffeine-free vibes and a lot of stress)
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>
        </Border>
    </Grid>
</UserControl>
