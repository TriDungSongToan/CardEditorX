<UserControl x:Class="CardEditor.UserControls.CodeEditorPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             xmlns:Controls="clr-namespace:CardEditor.Controls"
             xmlns:UserControls="clr-namespace:CardEditor.UserControls"
             xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
             xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="800" d:DesignWidth="1200" >

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{Binding displaySetting.WidthMiniMap, Source={x:Static ViewModels:ConfigViewModel.Instance}, Mode=OneWay}" />
            </Grid.ColumnDefinitions>

            <avalonEdit:TextEditor x:Name="textEditorPane"
                                   xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
                                   Document="{Binding SharedDocument, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   VerticalScrollBarVisibility="Hidden"
                                   HorizontalScrollBarVisibility="Hidden"
                                   HorizontalContentAlignment="Left"
                                   VerticalContentAlignment="Top"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Margin="5,0,0,0"
                                   WordWrap="{Binding codeEditSetting.WordWrap, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   SyntaxHighlighting="{Binding SyntaxHighlighting, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   ShowLineNumbers="True" >
                <avalonEdit:TextEditor.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        <Setter Property="Opacity" Value="0.5" />
                    </Style>
                </avalonEdit:TextEditor.Resources>
            </avalonEdit:TextEditor>

            <Grid Grid.Column="1" Margin="0" >
                <Canvas ClipToBounds="False">
                    <Border x:Name="previewTooltip" Visibility="Collapsed" Panel.ZIndex="100"/>
                    <Controls:MiniMapControl x:Name="miniMap"
                                             Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                             Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                                             BackgroundColor="{Binding MiniMapBackgroundColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             ForegroundColor="{Binding MiniMapForegroundColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             SliderColor="{Binding MiniMapSliderColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Canvas.Left="0" Canvas.Top="0"/>
                </Canvas>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" >
            <UserControls:FooterEditor x:Name="footerEditor" />
        </Grid>
    </Grid>
</UserControl>
