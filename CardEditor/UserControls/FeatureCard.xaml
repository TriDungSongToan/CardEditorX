<UserControl x:Class="CardEditor.UserControls.FeatureCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Controls="clr-namespace:CardEditor.Controls"
             xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
             xmlns:UserControls="clr-namespace:CardEditor.UserControls"
             xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
             xmlns:Lag="clr-namespace:CardEditor.Localization"
             mc:Ignorable="d"
             x:Name="root"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Unloaded="root_Unloaded"
             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
             d:DesignHeight="150" d:DesignWidth="400">
    <materialDesign:Card Background="Transparent" Margin="5"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
        <Grid x:Name="GrRoot" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="GrLogo" Grid.Column="0" Cursor="Hand"
                  Height="{Binding ActualHeight, ElementName=GrRoot}"
                  Width="{Binding ActualHeight, ElementName=GrRoot}"
                  MouseLeftButtonUp="GrLogo_MouseLeftButtonUp" >
                <Image Grid.Row="0" Margin="25" Stretch="Uniform"
                       Width="auto" Height="auto"
                       Source="{Binding Icon, ElementName=root}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5" >
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Image.RenderTransform>
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.6"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=GrLogo}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.08" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1.08" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Controls:ArcText Grid.Row="0" FontSize="20" Margin="0"
                                  Angle="180" IsOverlay="False" MaxSweepAngle="340"
                                  Anchor="Center" Spacing="1" Side="Inside"
                                  FitMode="SpacingThenFontSize"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                  RenderTransformOrigin="0.5,0.5"
                                  Text="{Binding FeatureName, ElementName=root}"
                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}">
                    <Controls:ArcText.Style>
                        <Style TargetType="Controls:ArcText">
                            <Setter Property="Foreground"
                                    Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=GrLogo}" Value="True">
                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Controls:ArcText.Style>
                    <Controls:ArcText.RenderTransform>
                        <RotateTransform />
                    </Controls:ArcText.RenderTransform>
                    <Controls:ArcText.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:12" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Controls:ArcText.Triggers>
                </Controls:ArcText>
            </Grid>

            <Border Grid.Column="2" BorderThickness="0.5"
                    BorderBrush="#0535e2" CornerRadius="10,15,15,10" >
                <Grid>
                    <ListBox x:Name="list"
                             ItemsSource="{Binding ItemsSource, ElementName=root}"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" >
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}"
                                           ToolTip="{Binding ToolTipText}"
                                           Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <EventSetter Event="MouseDoubleClick" Handler="Item_MouseDoubleClick"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <TextBlock Grid.Column="2" Text="{Binding EmptyText, ElementName=root}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=list}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </Grid>
    </materialDesign:Card>
</UserControl>
