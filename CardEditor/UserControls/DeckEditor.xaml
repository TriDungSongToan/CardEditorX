                                    </Style>
                                </ListView.Style>

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

                                        <EventSetter Event="MouseEnter" Handler="CardListViewItem_MouseEnter" />
                                        <EventSetter Event="MouseLeave" Handler="CardListViewItem_MouseLeave" />
                                        <EventSetter Event="MouseLeftButtonUp" Handler="CardListViewItem_MouseLeftButtonUp" />
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="CardListViewItem_PreviewMouseLeftButtonDown" />
                                        <EventSetter Event="MouseMove" Handler="CardListViewItem_MouseMove" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CardListViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Value="False">
                                                <Setter Property="Height" Value="{Binding ListViewItemHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Background" Value="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Style>
                                </ListView.Resources>
                            </ListView>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </materialDesign:Card>

        <Popup x:Name="popYDKE" StaysOpen="True" Placement="Center"
                       VerticalOffset="{Binding VOffset, Mode=TwoWay}"
                       HorizontalOffset="{Binding HOffset, Mode=TwoWay}"
                       AllowsTransparency="True" IsOpen="False" d:IsOpen="True" >
            <Border BorderThickness="1.5" CornerRadius="5" Padding="0"
                    Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    MouseLeftButtonDown="PopupBorder_MouseLeftButtonDown"
                    MouseMove="PopupBorder_MouseMove"
                    MouseLeftButtonUp="PopupBorder_MouseLeftButtonUp" >
                <Grid Width="450" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="auto" Margin="10,5,10,0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" >
                            <Controls:CircularTriStateToggle x:Name="tbtnOverwrite"
                                        Width="30" Height="30" IsChecked="{Binding OverwriteYDKE}"
                                        CircleBorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                        CircleBorderThickness="0"
                                        FalseBackgroundBrush="#DD408fff"
                                        TrueBackgroundBrush="#CCFF4056"
                                        NullBackgroundBrush="#DDFF9436"
                                        CircleBorderHoverBrush="#DD00ff95" >
                                <Controls:CircularTriStateToggle.FalseContent>
                                    <Viewbox>
                                        <materialDesign:PackIcon Kind="Plus" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"
                                                                         Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                    </Viewbox>
                                </Controls:CircularTriStateToggle.FalseContent>
                                <Controls:CircularTriStateToggle.TrueContent>
                                    <Viewbox>
                                        <materialDesign:PackIcon Kind="FileReplaceOutline" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"
                                                                         Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                    </Viewbox>
                                </Controls:CircularTriStateToggle.TrueContent>
                                <Controls:CircularTriStateToggle.NullContent>
                                    <Viewbox>
                                        <materialDesign:PackIcon Kind="NewBox" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2"
                                                                         Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                    </Viewbox>
                                </Controls:CircularTriStateToggle.NullContent>
                            </Controls:CircularTriStateToggle>
                        </Grid>

                        <Grid Grid.Column="1" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" >
                                        <Setter Property="Text" Value="{Lag:Localize Appendwrite}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=tbtnOverwrite}" Value="True">
                                                <Setter Property="Text" Value="{Lag:Localize Overwrite}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=tbtnOverwrite}" Value="{x:Null}">
                                                <Setter Property="Text" Value="{Lag:Localize CreateNew}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Margin="0,0,10,0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" >
                                        <Setter Property="Text" Value="32 bit"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=tbtnSystemType}" Value="True">
                                                <Setter Property="Text" Value="64 bit"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Column="2" >
                            <ToggleButton x:Name="tbtnSystemType" Grid.Column="1" Panel.ZIndex="2"
                                          IsChecked="{Binding SystemType}" BorderThickness="1"
                                          Width="30" Height="30" Margin="0,0,20,0" Padding="0"
                                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch" 
                                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                          Style="{StaticResource MaterialDesignActionToggleButton}" >
                                <ToggleButton.Content>
                                    <Viewbox Width="30" Height="30" >
                                        <materialDesign:PackIcon Kind="Cpu32Bit" Padding="0" Margin="0"  />
                                    </Viewbox>
                                </ToggleButton.Content>
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <Viewbox Width="30" Height="30" >
                                        <materialDesign:PackIcon Kind="Cpu64Bit" Padding="0" Margin="0" />
                                    </Viewbox>
                                </materialDesign:ToggleButtonAssist.OnContent>
                            </ToggleButton>
                        </Grid>
                    </Grid>

                    <Button x:Name="btnCloseYDKEURL" Grid.Column="1" Margin="0,2,5,0" Padding="0"
                            BorderThickness="0" Background="Transparent" Width="20" Height="20"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="btnCloseYDKEURL_Click" >
                        <Viewbox>
                            <materialDesign:PackIcon Kind="CloseThick"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnCloseYDKEURL}" Value="True">
                                                <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPressed, ElementName=btnCloseYDKEURL}" Value="True">
                                                <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Viewbox>
                    </Button>

                    <Grid Grid.Row="1" Margin="5,5,5,3" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnYDKEImport" Grid.Column="0" MinHeight="28"
                                Content="Import YDKE" Margin="0" Padding="5" Height="auto"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                BorderThickness="0" BorderBrush="Transparent" Style="{StaticResource ButtonSuccess}"
                                Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                Command="{Binding YDKEImportCommand}" >
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#08FFD2" Offset="0.0" />
                                    <GradientStop Color="#10DF00" Offset="0.4"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                        <Button x:Name="btnYDKEExportLink" Grid.Column="2" MinHeight="28"
                                Content="Export Link" Margin="0" Padding="5" Height="auto"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                BorderThickness="0" BorderBrush="Transparent" Style="{StaticResource ButtonSuccess}"
                                Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                Command="{Binding ExportLinkYDKECommand}" >
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF22CF9D" Offset="0.0" />
                                    <GradientStop Color="#FF1376DC" Offset="0.4"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2" Margin="5,0,5,3" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnYDKEExportText" Grid.Column="0" MinHeight="28"
                                Content="Export Text" Margin="0" Padding="5" Height="auto"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                BorderThickness="0" BorderBrush="Transparent" Style="{StaticResource ButtonSuccess}"
                                Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                Command="{Binding ExportTextYDKECommand}" >
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF22CF9D" Offset="0.0" />
                                    <GradientStop Color="#FF1376DC" Offset="0.4"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                        <Button x:Name="btnYDKEExportDeck" Grid.Column="2" MinHeight="28"
                                Content="Export File" Margin="0" Padding="5" Height="auto"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                BorderThickness="0" BorderBrush="Transparent" Style="{StaticResource ButtonSuccess}"
                                Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                Command="{Binding ExportDeckYDKECommand}" >
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF22CF9D" Offset="0.0" />
                                    <GradientStop Color="#FF1376DC" Offset="0.4"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="3" Margin="5,0,5,3" Panel.ZIndex="0" >
                        <TextBox x:Name="txtYDKEString" Grid.Row="0" Padding="4,14,3,3" Margin="0"
                                 Height="200" MaxHeight="300"
                                 Text="{Binding YDKEString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" HorizontalContentAlignment="Left" BorderThickness="1"
                                 TextAlignment="{Binding TextAlignmentC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                 TextOptions.TextFormattingMode="Display"
                                 TextOptions.TextRenderingMode="ClearType"
                                 materialDesign:TextFieldAssist.TextFieldCornerRadius="2"
                                 materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                 materialDesign:ThemeAssist.Theme="Dark" />
                    </Grid>
                    
                    <Grid Grid.Row="3" Panel.ZIndex="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="YDKE Text" Grid.Column="0" Width="auto" Height="auto"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0"
                                   Foreground="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontSize="13" />
                        
                        <Button x:Name="btnCopyYDKEURL" Grid.Column="1" Margin="0,2,6,0" Padding="0"
                                BorderThickness="0" Background="Transparent" Width="19" Height="17"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding CopyYDKEURLCommand}" >
                            <Viewbox>
                                <materialDesign:PackIcon x:Name="IconCopy" Kind="ContentCopy"
                                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnCopyYDKEURL}" Value="True">
                                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPressed, ElementName=btnCopyYDKEURL}" Value="True">
                                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <Image x:Name="GhostCardImage"
               Source="pack://application:,,,/Images/Blank.png" Opacity="1"
               Width="{Binding ListViewItemWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Height="{Binding ListViewItemHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               IsHitTestVisible="False"
               Visibility="Collapsed"
               RenderTransformOrigin="0,0"
               Panel.ZIndex="999">
            <Image.RenderTransform>
                <TranslateTransform x:Name="GhostCardTransform"/>
            </Image.RenderTransform>
        </Image>
    </Grid>
    <!---->
</UserControl>
