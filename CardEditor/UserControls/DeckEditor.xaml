<UserControl x:Class="CardEditor.UserControls.DeckEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
             xmlns:sdl="clr-namespace:Sdl.MultiSelectComboBox.Themes.Generic;assembly=Sdl.MultiSelectComboBox"
             xmlns:viewport="clr-namespace:Han.Wpf.ViewportControl;assembly=Han.Wpf.ViewportControl"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:Controls="clr-namespace:CardEditor.Controls"
             xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
             xmlns:Converter="clr-namespace:CardEditor.Converter"
             xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
             xmlns:Lag="clr-namespace:CardEditor.Localization" 
             xmlns:main="clr-namespace:CardEditor"
             xmlns:Commands="clr-namespace:CardEditor.Commands"
             mc:Ignorable="d"
             Margin="3,0,3,0"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Medium"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             FontFamily="{DynamicResource MaterialDesignFont}"
             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <ResourceDictionary>
            <Converter:CardBanLimitImageConverter x:Key="CardBanLimitImageConverter"/>
            <Converter:CardInstanceBanLimitImageConverter x:Key="CardInstanceBanLimitImageConverter"/>

            <Style x:Key="CustomDataGridHeaderStyle" TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   Height="20" Margin="0" Padding="0" TextAlignment="Left" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="CenterDataGridCellElementStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="3,2,3,2"/>
                <Setter Property="Padding" Value="2"/>
            </Style>

            <Style x:Key="LeftDataGridCellElementStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="3,2,3,2"/>
                <Setter Property="Padding" Value="2"/>
            </Style>

            <Style x:Key="CellWithBorderStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0.3,0.4,0.3,0.4"/>
                <Setter Property="BorderBrush" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="MaxHeight" Value="26" />
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridRow">
                            <Border x:Name="DGR_Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <SelectiveScrollingGrid>
                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </SelectiveScrollingGrid.ColumnDefinitions>
                                    <SelectiveScrollingGrid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </SelectiveScrollingGrid.RowDefinitions>
                                    <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    <DataGridDetailsPresenter Grid.Row="1" Grid.Column="1" Visibility="{TemplateBinding DetailsVisibility}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </SelectiveScrollingGrid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DGR_Border" Property="Background" Value="#FFE0F7FF"/>
                                    <Setter Property="Foreground" Value="Blue" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="DGR_Border" Property="Background" Value="#FF1976D2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="DGR_Border" Property="Background" Value="#FF1976D2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/CircularTriStateToggleStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.ControlTemplate.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.DropdownItemTemplate.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.SelectedItemTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          DragOver="RootGrid_DragOver" AllowDrop="True" >
        <materialDesign:Card Margin="0,2,0,0" Background="Transparent"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                             FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             DragOver="Card_DragOver" AllowDrop="True" d:FlowDirection="LeftToRight" >
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,2,0,3" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MaxWidth="400" />
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="7.5*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" x:Name="grCardInfo" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="1.1*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="blimage" Grid.Column="0" BorderThickness="0.6"
                                Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                            <viewport:Viewport x:Name="ViewportImage" Grid.Row="0"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                               MinZoom="1" MaxZoom="10" ZoomSpeed="1.1" SnapsToDevicePixels="True" UseLayoutRounding="True" >
                                <Image x:Name="imageCard"
                                       SnapsToDevicePixels="True"
                                       UseLayoutRounding="True"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       d:Source="pack://application:,,,/Images/Blank.png"
                                       Source="{Binding CurrentCard.CardImage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Stretch="Fill" Cursor="Hand" />
                            </viewport:Viewport>
                        </Border>

                        <Grid Grid.Column="2" Margin="5,0,5,0" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" >
                                <Button x:Name="btnSaveDeck" Height="auto" Width="auto" Cursor="Hand"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0" Padding="21" BorderThickness="0" BorderBrush="Transparent"
                                        Style="{StaticResource ButtonSuccess}" 
                                        Command="{Binding SaveDeckCommand}" >
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF7CCF22" Offset="0.0" />
                                            <GradientStop Color="#FF11DA74" Offset="0.4"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Viewbox Stretch="Uniform" Margin="0"
                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                        <TextBlock Text="{Lag:Localize Save}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                    </Viewbox>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="2" >
                                <Button x:Name="btnSortDeck" Width="auto" Height="auto" Cursor="Hand"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0" Padding="5" BorderThickness="0" BorderBrush="Transparent"
                                        Style="{StaticResource ButtonSuccess}" 
                                        Command="{Binding SortDeckCommand}" >
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF32BBF3" Offset="0.0" />
                                            <GradientStop Color="#FF0090FF" Offset="0.4"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Viewbox Stretch="Uniform" Margin="0"
                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                        <TextBlock Text="{Lag:Localize Sort}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                    </Viewbox>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="4" >
                                <Button x:Name="btnShuffleDeck" Width="auto" Height="auto" Cursor="Hand"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0" Padding="5" BorderThickness="0" BorderBrush="Transparent"
                                        Style="{StaticResource ButtonSuccess}"
                                        Command="{Binding ShuffleDeckCommand}" >
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#E633BDFF" Offset="0.0" />
                                            <GradientStop Color="#FF6200DC" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Viewbox Stretch="Uniform" Margin="0"
                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                        <TextBlock Text="{Lag:Localize Shuffle}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                    </Viewbox>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="6" >
                                <Button x:Name="btnYDKEDeck" Width="auto" Height="auto" Cursor="Hand"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0" Padding="5" BorderThickness="0" BorderBrush="Transparent"
                                        Style="{StaticResource ButtonWarning}"
                                        Click="btnYDKEDeck_Click" >
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" >
                                            <GradientStop Color="#FFD700FF" Offset="0.0" />
                                            <GradientStop Color="#FFA421FF" Offset="0.3"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Viewbox Stretch="Uniform" Margin="0"
                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                        <TextBlock Text="{Lag:Localize YDKE}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                    </Viewbox>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="8" >
                                <Button x:Name="btnClearDeck" Width="auto" Height="auto" Cursor="Hand"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0" Padding="5" BorderThickness="0" BorderBrush="Transparent"
                                        Style="{StaticResource ButtonWarning}"
                                        Command="{Binding ClearDeckCommand}" >
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" >
                                            <GradientStop Color="#FFFFCCA0" Offset="0.0" />
                                            <GradientStop Color="#FFFF8921" Offset="0.3"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Viewbox Stretch="Uniform" Margin="0"
                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                        <TextBlock Text="{Lag:Localize tlClear}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                    </Viewbox>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="10" >
                                <Button x:Name="btnDeleteDeck" Width="auto" Height="auto" Cursor="Hand"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Margin="0" Padding="5" BorderThickness="0" BorderBrush="Transparent"
                                        Style="{StaticResource ButtonDanger}"
                                        Command="{Binding DeleteDeckCommand}" >
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFA5AA" Offset="0.0" />
                                            <GradientStop Color="#FFF01717" Offset="0.4" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Viewbox Stretch="Uniform" Margin="0"
                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                        <TextBlock Text="{Lag:Localize tlDelete}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <Border Grid.Row="12" CornerRadius="4" BorderThickness="0.5" Padding="5,1,5,1" Margin="0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Viewbox>
                                        <TextBlock Grid.Row="0" Text="Genesys Pts" TextWrapping="Wrap"
                                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                                   TextAlignment="Center" />
                                    </Viewbox>
                                    
                                    <TextBlock Grid.Row="1" Text="{Binding TotalGPoint}" TextWrapping="Wrap"
                                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="14" HorizontalAlignment="Stretch" Height="auto"
                                    Margin="2,0,2,0" Padding="0" CornerRadius="0" BorderThickness="0" Background="Transparent"
                                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}">
                                <Grid Margin="0" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="btnOpenKonamDB" Grid.Row="0" Grid.Column="0" Margin="0" Padding="0"
                                            BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            HorizontalAlignment="Stretch" Width="auto"
                                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                                            ToolTip="{Lag:Localize toolOpenKonamiDB}"
                                            Command="{Binding OpenKonamiDBCommand}" >
                                        <Viewbox>
                                            <materialDesign:PackIcon Kind="DotsHexagon" Margin="0"
                                                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnOpenKonamDB}" Value="True">
                                                                <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPressed, ElementName=btnOpenKonamDB}" Value="True">
                                                                <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Viewbox>
                                    </Button>
                                    <Button x:Name="btnOpenYugipedia" Grid.Row="0" Grid.Column="1" Margin="0" Padding="0"
                                            BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            HorizontalAlignment="Stretch" Width="auto"
                                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                                            ToolTip="{Lag:Localize toolOpenYugipedia}"
                                            Command="{Binding OpenYugipediaCommand}" >
                                        <Viewbox>
                                            <materialDesign:PackIcon Kind="Wikipedia" Margin="0"
                                                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnOpenYugipedia}" Value="True">
                                                                <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPressed, ElementName=btnOpenYugipedia}" Value="True">
                                                                <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Viewbox>
                                    </Button>
                                    <Button x:Name="btnOpenYGOResources" Grid.Row="0" Grid.Column="2" Margin="0" Padding="0"
                                            BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="auto"
                                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                                            ToolTip="{Lag:Localize toolOpenYGOResources}"
                                            Command="{Binding OpenYGOResourcesCommand}" >
                                        <Viewbox>
                                            <materialDesign:PackIcon Kind="ViewColumnOutline" Margin="0"
                                                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnOpenYGOResources}" Value="True">
                                                                <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPressed, ElementName=btnOpenYGOResources}" Value="True">
                                                                <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Viewbox>
                                    </Button>
                                    <Button x:Name="btnViewImage" Grid.Row="1" Grid.Column="0" Margin="0" Padding="0"
                                            BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            HorizontalAlignment="Stretch" Width="auto"
                                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                                            ToolTip="{Lag:Localize toolViewImg}"
                                            Command="{Binding ViewImageCommand}" >
                                        <Viewbox>
                                            <materialDesign:PackIcon Kind="MagnifyExpand"
                                                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnViewImage}" Value="True">
                                                                <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPressed, ElementName=btnViewImage}" Value="True">
                                                                <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Viewbox>
                                    </Button>
                                    <Button x:Name="btnOpenFileLocation" Grid.Row="1" Grid.Column="1" Margin="0" Padding="0"
                                            BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            HorizontalAlignment="Stretch" Width="auto"
                                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                                            ToolTip="{Lag:Localize toolOpenLocalImg}"
                                            Command="{Binding OpenFileLocalCommand}" >
                                        <Viewbox>
                                            <materialDesign:PackIcon Kind="FileMarker" Grid.Column="0" Margin="0"
                                                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnOpenFileLocation}" Value="True">
                                                                <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPressed, ElementName=btnOpenFileLocation}" Value="True">
                                                                <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Viewbox>
                                    </Button>
                                    <Button x:Name="btnOpenDatabase" Grid.Row="1" Grid.Column="2" Margin="0" Padding="0"
                                            BorderThickness="0" Background="Transparent" Cursor="Hand"
                                            HorizontalAlignment="Stretch" Width="auto"
                                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                                            ToolTip="{Lag:Localize toolOpenDB}"
                                            Command="{Binding OpenDatabaseCommand}" >
                                        <Viewbox>
                                            <materialDesign:PackIcon Kind="DatabaseEyeOutline" Grid.Column="0" Margin="0"
