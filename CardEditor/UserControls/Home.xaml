<UserControl x:Class="CardEditor.UserControls.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Controls="clr-namespace:CardEditor.Controls"
             xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
             xmlns:UserControls="clr-namespace:CardEditor.UserControls"
             xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
             xmlns:Lag="clr-namespace:CardEditor.Localization"
             mc:Ignorable="d"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="800" d:DesignWidth="1220">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <materialDesign:Card Margin="0,1,0,0" Background="Transparent"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                             FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             d:FlowDirection="LeftToRight" >
            
            <Grid x:Name="GridRoot" Margin="20,0,20,10"
                  Background="Transparent" IsHitTestVisible="True" >
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="GridTopRow" />
                    <RowDefinition Height="5" />
                    <RowDefinition x:Name="GridBottomRow" />
                </Grid.RowDefinitions>

                <Grid x:Name="GridTop" Grid.Row="0" Background="Transparent"
                      SizeChanged="GridTop_SizeChanged" >
                    <Border x:Name="BrIdentity" Margin="0,10,0,0" CornerRadius="50"
                            BorderBrush="#0535e2" BorderThickness="2"
                            Background="{Binding BackgroundControl, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" >

                            <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  ClipToBounds="False" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <Grid x:Name="GrWelcome" Grid.Row="0" Margin="0" HorizontalAlignment="Center" >
                                    <TextBlock Text="{Binding Welcome}" Margin="0,0,0,-15" FontWeight="Light" TextAlignment="Center"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"
                                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                </Grid>

                                <Grid x:Name="GrLogo" Grid.Row="1" Height="110" Width="auto" HorizontalAlignment="Center" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Height="100" VerticalAlignment="Top" >
                                        <UserControls:CardEditorTitle Margin="0" />
                                    </Grid>

                                    <Grid Grid.Column="2" Width="100" Height="100" VerticalAlignment="Bottom" >
                                        <UserControls:Letter Width="100" Height="100" />
                                    </Grid>
                                    
                                </Grid>

                                <Grid x:Name="GrTitle" Grid.Row="2" HorizontalAlignment="Stretch" >
                                    <UserControls:RotatingTitle HorizontalAlignment="Center" />
                                </Grid>
                                
                            </Grid>

                            <Grid x:Name="GrGetStarted" Grid.Row="0" Margin="0,0,0,40"
                                  HorizontalAlignment="Center" VerticalAlignment="Bottom" >

                                <Border x:Name="PulseRing1" Height="45" Width="220" CornerRadius="20"
                                        BorderThickness="2" BorderBrush="#2563EB" Background="Transparent"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5" Opacity="0">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="PulseScale1" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.6" To="0" Duration="0:0:2"/>
                                                    <DoubleAnimation Storyboard.TargetName="PulseScale1"
                                                                     Storyboard.TargetProperty="ScaleX"
                                                                     From="1" To="1.35" Duration="0:0:2"/>
                                                    <DoubleAnimation Storyboard.TargetName="PulseScale1"
                                                                     Storyboard.TargetProperty="ScaleY"
                                                                     From="1" To="1.6" Duration="0:0:2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>

                                <Border x:Name="PulseRing2" Height="45" Width="220" CornerRadius="20"
                                        BorderThickness="2" BorderBrush="#2563EB" Background="Transparent"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5" Opacity="0">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="PulseScale2" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" BeginTime="0:0:1">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.6" To="0" Duration="0:0:2"/>
                                                    <DoubleAnimation Storyboard.TargetName="PulseScale2"
                                                                     Storyboard.TargetProperty="ScaleX"
                                                                     From="1" To="1.35" Duration="0:0:2"/>
                                                    <DoubleAnimation Storyboard.TargetName="PulseScale2"
                                                                     Storyboard.TargetProperty="ScaleY"
                                                                     From="1" To="1.6" Duration="0:0:2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>

                                <Button Height="45" Width="220" Margin="0" Padding="0,0,0,0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        BorderBrush="Transparent" BorderThickness="0"
                                        Style="{StaticResource ButtonPrimary}"
                                        Command="{Binding GetStartedCommand}" >
                                    <Button.Content>
                                        <TextBlock FontSize="22" FontWeight="Medium"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,0,0,0" Padding="0" TextAlignment="Center"
                                                   TextWrapping="Wrap" Text="Getting Started  ➤">
                                            <TextBlock.Foreground>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <!-- Nền vàng đậm -->
                                                    <GradientStop Color="#FFD700" Offset="0.00"/>
                                                    <!-- Mép trái của vệt sáng -->
                                                    <GradientStop x:Name="ShimmerGetStart"
                                                                  Color="#FFD700" Offset="-0.25"/>
                                                    <!-- Tâm vệt sáng -->
                                                    <GradientStop x:Name="ShimmerGetLight"
                                                                  Color="#FFF8C4"
                                                                  Offset="-0.05"/>
                                                    <!-- Mép phải của vệt sáng -->
                                                    <GradientStop x:Name="ShimmerGetEnd"
                                                                  Color="#FFD700"
                                                                  Offset="0.15"/>
                                                    <!-- Nền vàng đậm -->
                                                    <GradientStop Color="#FFD700" Offset="1.00"/>
                                                </LinearGradientBrush>
                                            </TextBlock.Foreground>
                                            <TextBlock.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <!-- Fade in -->
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="0" To="1" Duration="0:0:0.4"/>
                                                            <!-- Vệt sáng chạy từ trái sang phải -->
                                                            <DoubleAnimation Storyboard.TargetName="ShimmerGetStart"
                                                                             Storyboard.TargetProperty="Offset"
                                                                             From="-0.25" To="1.00" Duration="0:0:2.5"
                                                                             RepeatBehavior="Forever"/>
                                                            <DoubleAnimation Storyboard.TargetName="ShimmerGetLight"
                                                                             Storyboard.TargetProperty="Offset"
                                                                             From="-0.05" To="1.20" Duration="0:0:2.5"
                                                                             RepeatBehavior="Forever"/>
                                                            <DoubleAnimation Storyboard.TargetName="ShimmerGetEnd"
                                                                             Storyboard.TargetProperty="Offset"
                                                                             From="0.15" To="1.40" Duration="0:0:2.5"
                                                                             RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </TextBlock.Triggers>
                                        </TextBlock>
                                    </Button.Content>
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF7DA6FF" Offset="0.0"/>
                                            <GradientStop Color="#2563EB" Offset="0.35"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="20" SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                    <Grid Background="Transparent" IsHitTestVisible="True" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="150" />
                        </Grid.RowDefinitions>

                        <Border Grid.Column="0" Grid.Row="0" CornerRadius="20"
                                BorderBrush="#0535e2" BorderThickness="1"
                                Background="{Binding BackgroundControl, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <UserControls:FeatureCard HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      Icon="/Images/Menu/File/Open/Archive.png"
                                                      ItemsSource="{Binding Archives , Source={x:Static ViewModels:OpenHistoryViewModel.Instance}}"
                                                      FeatureType="Archive" FeatureName="{Lag:Localize CardArchive}" EmptyText="Empty"
                                                      ItemOpened="FeatureCard_ItemOpened"
                                                      CardTypeSelected="FeatureCard_CardTypeSelected" />
                        </Border>

                        <Border Grid.Column="2" Grid.Row="0" CornerRadius="20"
                                BorderBrush="#0535e2" BorderThickness="1"
                                Background="{Binding BackgroundControl, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <UserControls:FeatureCard HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      Icon="/Images/Menu/Win/DataEditor.png"
                                                      ItemsSource="{Binding Databases , Source={x:Static ViewModels:OpenHistoryViewModel.Instance}}"
                                                      FeatureType="Database" FeatureName="{Lag:Localize CardDB}" EmptyText="Empty"
                                                      ItemOpened="FeatureCard_ItemOpened"
                                                      CardTypeSelected="FeatureCard_CardTypeSelected" />
                        </Border>

                        <Border Grid.Column="4" Grid.Row="0" CornerRadius="20"
                                BorderBrush="#0535e2" BorderThickness="1"
                                Background="{Binding BackgroundControl, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <UserControls:FeatureCard HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      Icon="/Images/Menu/Win/CodeEditor.png"
                                                      ItemsSource="{Binding Scripts , Source={x:Static ViewModels:OpenHistoryViewModel.Instance}}"
                                                      FeatureType="Script" FeatureName="{Lag:Localize CardScript}" EmptyText="Empty"
                                                      ItemOpened="FeatureCard_ItemOpened"
                                                      CardTypeSelected="FeatureCard_CardTypeSelected" />
                        </Border>

                        <Border Grid.Column="0" Grid.Row="2" CornerRadius="20"
                                BorderBrush="#0535e2" BorderThickness="1"
                                Background="{Binding BackgroundControl, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <UserControls:FeatureCard HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      Icon="/Images/Menu/Win/DeckEditor.png"
                                                      ItemsSource="{Binding Decks , Source={x:Static ViewModels:OpenHistoryViewModel.Instance}}"
                                                      FeatureType="Deck" FeatureName="{Lag:Localize Deck}" EmptyText="Empty"
                                                      ItemOpened="FeatureCard_ItemOpened"
                                                      CardTypeSelected="FeatureCard_CardTypeSelected" />
                        </Border>

                        <Border Grid.Column="2" Grid.Row="2" CornerRadius="20"
                                BorderBrush="#0535e2" BorderThickness="1"
                                Background="{Binding BackgroundControl, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <UserControls:FeatureCard HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      Icon="/Images/Menu/Win/BanListEditor.png"
                                                      ItemsSource="{Binding BanLists , Source={x:Static ViewModels:OpenHistoryViewModel.Instance}}"
                                                      FeatureType="BanList" FeatureName="{Lag:Localize BanList}" EmptyText="Empty"
                                                      ItemOpened="FeatureCard_ItemOpened"
                                                      CardTypeSelected="FeatureCard_CardTypeSelected" />
                        </Border>

                        <Border Grid.Column="4" Grid.Row="2" CornerRadius="20"
                                BorderBrush="#0535e2" BorderThickness="1"
                                Background="{Binding BackgroundControl, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <UserControls:FeatureCard HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      Icon="/Images/Menu/Win/DataEditor.png"
                                                      ItemsSource="{Binding Archives , Source={x:Static ViewModels:OpenHistoryViewModel.Instance}}"
                                                      FeatureName="Docs" EmptyText="Empty"
                                                      ItemOpened="FeatureCard_ItemOpened"
                                                      CardTypeSelected="FeatureCard_CardTypeSelected" />
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
