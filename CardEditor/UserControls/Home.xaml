<UserControl x:Class="CardEditor.UserControls.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Controls="clr-namespace:CardEditor.Controls"
             xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
             xmlns:Lag="clr-namespace:CardEditor.Localization"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="800" d:DesignWidth="1220">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/TwoStateToggleStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/TriStateToggleStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/CircularTriStateToggleStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        
        <Image x:Name="imgmainbg" Stretch="Uniform" Panel.ZIndex="0" 
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <StackPanel Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center"  >
            <Controls:TriStateToggle x:Name="tbtnTest" Width="180" Height="40" Visibility="Collapsed"
                                     LeftBackgroundBrush="Cyan"
                                     MiddleBackgroundBrush="DimGray"
                                     RightBackgroundBrush="Red"
                                     ThumbBackgroundBrush="Red"
                                     
                                     TrackCornerRadius="8"
                                     TrackLeftCornerRadius="8,0,0,8"
                                     TrackMiddleCornerRadius="0"
                                     TrackRightCornerRadius="0,8,8,0"
                                     
                                     TrackPadding="0"
                                     TrackBorderThickness="0"
                                     TrackBorderBrush="Red"
                                     
                                     ThumbZIndex="5"
                                     LeftCellContentZIndex="10"
                                     RightCellContentZIndex="6"
                                     MiddleCellContentZIndex="7"
                                     
                                     ThumbBorderBrush="Black"
                                     ThumbBorderThickness="2"
                                     
                                     
                                     ThumbBackgroundHoverBrush="Yellow"
                                     
                                     >

                <Controls:TriStateToggle.LeftCellContent>
                    <materialDesign:PackIcon Kind="ArrowLeftThick" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Controls:TriStateToggle.LeftCellContent>
                <Controls:TriStateToggle.MiddleCellContent>
                    <materialDesign:PackIcon Kind="CogOutline" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Controls:TriStateToggle.MiddleCellContent>
                <Controls:TriStateToggle.RightCellContent>
                    <materialDesign:PackIcon Kind="ArrowRightThick" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Controls:TriStateToggle.RightCellContent>

            </Controls:TriStateToggle>
            <Controls:CircularTriStateToggle Width="100" Height="100" Visibility="Collapsed"
                                             CircleBackgroundBrush="Yellow"
                                             CircleBorderBrush="Black"
                                             CircleBorderThickness="3"
                                             
                                             FalseBackgroundBrush="Red"
                                             TrueBackgroundBrush="Green"
                                             NullBackgroundBrush="Gray"
                                             
                                             CircleBorderHoverBrush="Blue" >
                <Controls:CircularTriStateToggle.FalseContent>
                    <Viewbox Margin="10" >
                        <materialDesign:PackIcon Kind="AlarmSnooze" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Viewbox>
                </Controls:CircularTriStateToggle.FalseContent>
                <Controls:CircularTriStateToggle.TrueContent>
                    <Viewbox Margin="10" >
                        <materialDesign:PackIcon Kind="AlertOctagonOutline" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Viewbox>
                </Controls:CircularTriStateToggle.TrueContent>
                <Controls:CircularTriStateToggle.NullContent>
                    <Viewbox Margin="10" >
                        <materialDesign:PackIcon Kind="AlphaECircle" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Viewbox>
                </Controls:CircularTriStateToggle.NullContent>
            </Controls:CircularTriStateToggle>

            <Controls:TwoStateToggle x:Name="tbtnTestTwo" Width="80" Height="40" IsThreeState="False" IsChecked="True"
                                     FalseBackgroundBrush="#404842" TrueBackgroundBrush="#20C853" Visibility="Collapsed"
                                     ThumbBackgroundBrush="#90EFEFEF" ThumbBackgroundHoverBrush="#AAEFEFEF"
                                     TrackCornerRadius="8" TrackFalseCornerRadius="8,5,5,8" TrackTrueCornerRadius="5,8,8,5"
                                     FalseCellContentZIndex="3" TrueCellContentZIndex="3" ThumbZIndex="3"
                                     ThumbBorderBrush="#8A000000" ThumbBorderThickness="0.5" >
                <Controls:TwoStateToggle.FalseContent>
                    <Viewbox>
                        <materialDesign:PackIcon Kind="CloseOutline" Margin="1" Foreground="#66000000"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Viewbox>
                </Controls:TwoStateToggle.FalseContent>
                <Controls:TwoStateToggle.TrueContent>
                    <Viewbox>
                        <materialDesign:PackIcon Kind="CheckOutline" Margin="1" Foreground="#FF2E7D32"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Viewbox>
                </Controls:TwoStateToggle.TrueContent>>
            </Controls:TwoStateToggle>

        </StackPanel>
    </Grid>
</UserControl>
