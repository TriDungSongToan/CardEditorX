<UserControl x:Class="CardEditor.UserControls.FooterEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Converter="clr-namespace:CardEditor.Converter"
             xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
             xmlns:local="clr-namespace:CardEditor.UserControls"
             mc:Ignorable="d" 
             Height="18" d:DesignWidth="600" >

    <Border Background="Transparent" BorderThickness="0,0.5,0,0"
            BorderBrush="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
        <Grid Background="Transparent" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="cmbFontSize" Grid.Column="0" IsEditable="True" Width="50" Margin="0,1,0,0" Padding="0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0,0,1,0"
                      Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                      Style="{StaticResource EditableComboBoxStyle}"
                      ItemsSource="{Binding fontSizeList}"
                      Text="{Binding FontSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ScrollBar x:Name="HorizontalScrollBar" Grid.Column="1" Orientation="Horizontal"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3,0,3,0"
                       Minimum="0" Maximum="{Binding MaxScroll}" Value="{Binding ScrollOffset, Mode=TwoWay}"
                       ViewportSize="{Binding ViewportSize}"
                       Style="{StaticResource MaterialDesignScrollBarMinimal}"
                       Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                       materialDesign:ThemeAssist.Theme="Dark"
                       
                       materialDesign:ScrollViewerAssist.IgnorePadding="True"
                       materialDesign:ScrollBarAssist.ButtonsVisibility="Visible"
                       materialDesign:ScrollBarAssist.ThumbCornerRadius="5"
                       materialDesign:ScrollBarAssist.ThumbHeight="12"
                       materialDesign:ScrollViewerAssist.ShowSeparators="True"
                       materialDesign:ScrollViewerAssist.SupportHorizontalScroll="True" >
            </ScrollBar>

            <Border Grid.Column="2" Background="Transparent" BorderThickness="0.2,0,0.2,0"
                    BorderBrush="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                <StackPanel Orientation="Horizontal" Width="auto" MinWidth="30" Margin="5,0,5,0" >
                    <TextBlock Text="Ln: " HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                    <TextBlock Text="{Binding LineNumber, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="Transparent" BorderThickness="0.3,0,0.3,0"
                    BorderBrush="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                <StackPanel Orientation="Horizontal" Width="auto" MinWidth="30" Margin="5,0,5,0" >
                    <TextBlock Text="Ch: " HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                    <TextBlock Text="{Binding CharNumber, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                </StackPanel>
            </Border>

            <ComboBox x:Name="cmbTabSpc" Grid.Column="4" IsEditable="False" Width="auto" Margin="0,1,0,0" Padding="0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                      Style="{StaticResource OptionComboBoxStyle}"
                      ItemsSource="{Binding indentOptions}"
                      SelectedIndex="{Binding SelectedIndentOption}" />

            <Border Grid.Column="5" Background="Transparent" Width="auto" Padding="5,0,5,0" BorderThickness="0.3,0,0.3,0"
                    BorderBrush="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}">
                <TextBlock Text="OVR" Margin="0" Padding="0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverWrite}" Value="True" >
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <ComboBox x:Name="cmbEncodeNewLine" Grid.Column="6" IsEditable="False" Width="auto" Margin="0,1,0,0" Padding="0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                      Style="{StaticResource OptionComboBoxStyle}"
                      ItemsSource="{Binding newLineOptions}"
                      SelectedIndex="{Binding SelectedNewLineOption}" />
        </Grid>
    </Border>
</UserControl>
