<UserControl x:Class="CardEditor.UserControls.TranslationEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
             xmlns:viewport="clr-namespace:Han.Wpf.ViewportControl;assembly=Han.Wpf.ViewportControl"
             xmlns:sdl="clr-namespace:Sdl.MultiSelectComboBox.Themes.Generic;assembly=Sdl.MultiSelectComboBox"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
             xmlns:enums="clr-namespace:CardEditor.Enums"
             xmlns:models="clr-namespace:CardEditor.Models"
             xmlns:Controls="clr-namespace:CardEditor.Controls"
             xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:Converter="clr-namespace:CardEditor.Converter"
             xmlns:Lag="clr-namespace:CardEditor.Localization"
             xmlns:main="clr-namespace:CardEditor"
             xmlns:Commands="clr-namespace:CardEditor.Commands"
             mc:Ignorable="d"
             Margin="0,0,0,0"
             x:Name="dataEditorControl"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Medium"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             FontFamily="{DynamicResource MaterialDesignFont}"
             Background="{Binding BackgroundUserControl, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
             UseLayoutRounding="False"
             SnapsToDevicePixels="False"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="800" d:DesignWidth="1220">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <Behaviors:BindingProxy x:Key="Proxy" Data="{Binding}"/>
            <ObjectDataProvider x:Key="StatusValues" MethodName="GetValues"
                                ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="enums:StatusConf"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <Style x:Key="ReadOnlyTextStyle" TargetType="TextBlock">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Padding" Value="4,2"/>
            </Style>
            <Style x:Key="SelectableReadOnlyTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Padding" Value="1,1"/>
                <Setter Property="IsTabStop" Value="False"/>
            </Style>
            <Style x:Key="TopAlignedCellStyle" TargetType="DataGridCell"
                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Unknown">
                        <Setter Property="Background" Value="#668B95A1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Translated">
                        <Setter Property="Background" Value="#6622C55E"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Untranslated">
                        <Setter Property="Background" Value="#66F59E0B"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="New">
                        <Setter Property="Background" Value="#663B82F6"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="SourceChanged">
                        <Setter Property="Background" Value="#668B5CF6"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Removed">
                        <Setter Property="Background" Value="#66EF4444"/>
                    </DataTrigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="BorderBrush" Value="#FF3B82F6"/>
                        <Setter Property="BorderThickness" Value="0,1,0,1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="OutlinedProgressBar" TargetType="{x:Type ProgressBar}">
                <Setter Property="Height" Value="12"/>
                <!-- Track background: 30% opacity -->
                <Setter Property="Background" Value="#4DFFFFFF"/>
                <!-- Track border -->
                <Setter Property="BorderBrush" Value="#80FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <!-- Progress color -->
                <Setter Property="Foreground" Value="#FF2196F3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                            <!-- Outer border -->
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    SnapsToDevicePixels="True">
                                <!-- Track -->
                                <Grid x:Name="PART_Track"
                                      Background="Transparent"
                                      ClipToBounds="True">
                                    <!-- Progress indicator -->
                                    <Border x:Name="PART_Indicator"
                                            HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}"
                                            CornerRadius="5"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Converter:PositiveBoolToVisibilityConverter x:Key="PositiveBoolToVis"/>
            <Converter:NegativeBoolToVisibilityConverter x:Key="NegativeBoolToVis"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/FlatTwoStateToggleStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <materialDesign:Card Margin="0,1,0,0" Background="Transparent"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                             FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             d:FlowDirection="LeftToRight" >
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="GrFilePath" Grid.Row="0" Margin="0,1,0,0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Height="40"
                             Padding="5,12,3,0" BorderThickness="0.7" IsReadOnly="True"
                             Text="{Binding SourceFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Behaviors:FileDropBehavior.Enable="True"
                             Behaviors:PasteSanitizerBehavior.Enable="True"
                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                             materialDesign:HintAssist.Hint="{Lag:Localize SourceFile}"
                             Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                             TextOptions.TextFormattingMode="Display"
                             TextOptions.TextRenderingMode="ClearType"
                             materialDesign:TextFieldAssist.HasClearButton="False"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                             materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                             materialDesign:ThemeAssist.Theme="Dark" />

                    <Button Grid.Column="0" Grid.Row="0" Margin="0,0,3,0" Padding="0" Width="22" Height="22"
                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                            ToolTip="{Lag:Localize Browse}"
                            Command="{Binding BrowseSourceFileCommand}" >
                        <Button.Content>
                            <materialDesign:PackIcon Kind="FolderSearchOutline" Width="22" Height="22"
                                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </Button.Content>
                    </Button>

                    <TextBox Grid.Column="2" Grid.Row="0" Height="40"
                             Padding="5,12,3,0" BorderThickness="0.7" IsReadOnly="True"
                             Text="{Binding TranslationFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Behaviors:FileDropBehavior.Enable="True"
                             Behaviors:PasteSanitizerBehavior.Enable="True"
                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                             materialDesign:HintAssist.Hint="{Lag:Localize TranslationFile}"
                             Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                             TextOptions.TextFormattingMode="Display"
                             TextOptions.TextRenderingMode="ClearType"
                             materialDesign:TextFieldAssist.HasClearButton="False"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                             materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                             materialDesign:ThemeAssist.Theme="Dark" />

                    <Button Grid.Column="2" Grid.Row="0" Margin="0,0,3,0" Padding="0" Width="22" Height="22"
                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                            ToolTip="{Lag:Localize Browse}"
                            Command="{Binding BrowseTranslationFileCommand}" >
                        <Button.Content>
                            <materialDesign:PackIcon Kind="FolderSearchOutline" Width="22" Height="22"
                                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </Button.Content>
                    </Button>

                    <Button Grid.Column="4" Grid.Row="0" Cursor="Hand" Height="38"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Margin="0" Padding="6,8,6,8" BorderThickness="0" BorderBrush="Transparent"
                            Style="{StaticResource ButtonSuccess}"
                            Command="{Binding MergeFileCommand}" >
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#E633BDFF" Offset="0.0" />
                                <GradientStop Color="#FF6200DC" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Viewbox Stretch="Uniform" Margin="0"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                            <TextBlock Text="{Lag:Localize Merge}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </Viewbox>
                    </Button>

                </Grid>
                
                <Grid Grid.Row="1" Margin="0,1,0,0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <StatusBar Grid.Column="0" Background="Transparent" Height="28"
                               Foreground="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               BorderThickness="0" BorderBrush="Transparent" >
                        <StatusBarItem>
                            <TextBlock Text="{Lag:Localize Translated}"
                                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </StatusBarItem>
                        <StatusBarItem>
                            <ProgressBar Width="120" Height="10" IsIndeterminate="False"
                                         Minimum="0" Maximum="{Binding TotalCount, Mode=OneWay}"
                                         Value="{Binding TranslatedCount, Mode=OneWay}"
                                         materialDesign:TransitionAssist.DisableTransitions="True"
                                         Style="{StaticResource OutlinedProgressBar}" >
                            </ProgressBar>
                        </StatusBarItem>
                        <StatusBarItem>
                            <TextBlock Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                                <Run Text="{Binding TranslatedCount, Mode=OneWay}"/> / <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                            </TextBlock>
                        </StatusBarItem>
                        <Separator Width="1" Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        <StatusBarItem>
                            <TextBlock Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                                <Run Text="{Lag:Localize UnTranslated}" />
                                <Run Text="{Binding UntranslatedCount, Mode=OneWay}" />
                            </TextBlock>
                        </StatusBarItem>
                        <Separator Width="1" Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        <StatusBarItem>
                            <TextBlock Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                                <Run Text="{Lag:Localize NewTranslation}" />
                                <Run Text="{Binding NewCount, Mode=OneWay}" />
                            </TextBlock>
                        </StatusBarItem>
                        <Separator Width="1" Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        <StatusBarItem>
                            <TextBlock Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                                <Run Text="{Lag:Localize DeletedTranslation}" />
                                <Run Text="{Binding RemovedCount, Mode=OneWay}" />
                            </TextBlock>
                        </StatusBarItem>
                        <Separator Width="1" Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        <StatusBarItem>
                            <TextBlock Text="{Binding Notification}" Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </StatusBarItem>
                    </StatusBar>

                    <Controls:FlatTwoStateToggle x:Name="tbtnFilepath" Grid.Column="2" Panel.ZIndex="3" Width="25" Height="24"
                                                 HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                                 BackgroundBrush="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 HoverBackgroundBrush="{Binding BackgroundControl, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 ForegroundBrush="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 BorderThickness="1" BorderCornerRadius="5"
                                                 Checked="tbtnFilepath_Checked"
                                                 Unchecked="tbtnFilepath_Unchecked">
                        <Controls:FlatTwoStateToggle.FalseContent>
                            <materialDesign:PackIcon Kind="ChevronDoubleUp" Width="25" Height="25"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Controls:FlatTwoStateToggle.FalseContent>
                        <Controls:FlatTwoStateToggle.TrueContent>
                            <materialDesign:PackIcon Kind="ChevronDoubleDown" Width="25" Height="25"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Controls:FlatTwoStateToggle.TrueContent>
                    </Controls:FlatTwoStateToggle>
                </Grid>
                
                <Grid Grid.Row="2" Margin="0,1,0,0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="2" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="SectionListBox" Grid.Column="0" AllowDrop="True"
                                 Background="{Binding BackgroundControl, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 ItemsSource="{Binding CombineData.Sections}"
                                 SelectedItem="{Binding SelectedSection}"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch"
                                 DragOver="SectionListBox_DragOver"
                                 Drop="SectionListBox_Drop">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AllowDrop" Value="True"/>
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SectionItem_PreviewMouseLeftButtonDown"/>
                                    <EventSetter Event="PreviewMouseMove" Handler="SectionItem_PreviewMouseMove"/>
                                    <EventSetter Event="DragEnter" Handler="SectionItem_DragEnter"/>
                                    <EventSetter Event="DragOver" Handler="SectionItem_DragOver"/>
                                    <EventSetter Event="DragLeave" Handler="SectionItem_DragLeave"/>
                                    <EventSetter Event="Drop" Handler="SectionItem_Drop"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SectionName}"
                                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SectionName}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Background" Value="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                    <Setter Property="Opacity" Value="0.5" />
                                </Style>
                            </ListBox.Resources>
                        </ListBox>

                    </Grid>

                    <GridSplitter Grid.Column="1"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="Transparent" ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                                  Cursor="SizeWE"/>

                    <Grid Grid.Column="2" >
                        <DataGrid x:Name="RowsGrid"
                                  Background="{Binding BackgroundControl, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  ItemsSource="{Binding SelectedSection.Content}"
                                  CellStyle="{StaticResource TopAlignedCellStyle}"
                                  VerticalScrollBarVisibility="Visible"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Extended"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  materialDesign:DataGridAssist.CellPadding="4 2 2 2"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="4 2 2 2" >
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="20" IsReadOnly="True"
                                                        CanUserSort="False" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Cursor="SizeAll"
                                                    ToolTip="{Lag:Localize DragDropTool}"
                                                    PreviewMouseLeftButtonDown="RowHandle_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="RowHandle_PreviewMouseMove" >
                                                <TextBlock Text="⋮⋮" FontSize="12" Opacity="0.5" Margin="0,2,0,0"
                                                           HorizontalAlignment="Center" VerticalAlignment="Top" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Lag:Localize SourceFile}" Width="260" IsReadOnly="True"
                                                        SortMemberPath="Source">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Source, Mode=OneWay}" Background="Transparent"
                                                     Style="{StaticResource SelectableReadOnlyTextBox}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{Binding Data.SourceName, Source={StaticResource Proxy}}"
                                                        Width="260" IsReadOnly="True" SortMemberPath="SourceContent">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding SourceContent, Mode=OneWay}" Background="Transparent"
                                                     Style="{StaticResource SelectableReadOnlyTextBox}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{Binding Data.TranslationName, Source={StaticResource Proxy}}"
                                                    Width="*" Binding="{Binding TranslationContent, UpdateSourceTrigger=LostFocus}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ReadOnlyTextStyle}"/>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="AcceptsReturn" Value="False"/>
                                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                                            <Setter Property="Padding" Value="2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridComboBoxColumn Header="{Lag:Localize TranslationStatus}" Width="105"
                                                        ItemsSource="{Binding Source={StaticResource StatusValues}}"
                                                        SelectedItemBinding="{Binding Status, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataGrid.Columns>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="{Binding BackgroundControl, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                    <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5,4,0,4"/>
                                    <Setter Property="BorderBrush" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0.5"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Background" Value="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                    <Setter Property="Opacity" Value="0.5" />
                                </Style>
                            </DataGrid.Resources>
                        </DataGrid>
                    </Grid>
                </Grid>
                
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
