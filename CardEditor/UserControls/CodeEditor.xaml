<UserControl x:Class="CardEditor.UserControls.CodeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
             xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
             xmlns:UserControls="clr-namespace:CardEditor.UserControls"
             mc:Ignorable="d"
             x:Name="rootEditor"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             PreviewKeyDown="rootEditor_PreviewKeyDown"
             d:DesignHeight="800" d:DesignWidth="1200">

    <materialDesign:Card Margin="0,1,0,0" Background="Transparent"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" d:FlowDirection="LeftToRight"
                         FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >

            <Grid x:Name="grRoot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" x:Name="HeaderRow" />
                    <RowDefinition Height="0" MinHeight="0" x:Name="TopPaneRow" />
                    <RowDefinition Height="3" x:Name="SplitterRow" />
                    <RowDefinition Height="*" x:Name="BottomPaneRow" />
                </Grid.RowDefinitions>

                <Border x:Name="HeaderGrid" Grid.Row="0" Height="20" Background="Transparent" BorderThickness="0,0,0,0.5"
                        BorderBrush="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="20" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="{Binding displaySetting.WidthMiniMap, Source={x:Static ViewModels:ConfigViewModel.Instance}, Mode=OneTime}"
                                              MinWidth="30" MaxWidth="200" />
                        </Grid.ColumnDefinitions>

                        <GridSplitter x:Name="MiniMapSplitter" Grid.Column="1" Width="3"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Background="#80D3D3D3" Cursor="SizeWE"
                                      DragCompleted="MiniMapSplitter_DragCompleted"/>

                        <Grid x:Name="GridMiniMap" Grid.Column="2" >
                            <Button x:Name="btnHiddenTopPane" Margin="0" Padding="0" Visibility="Collapsed"
                                    HorizontalAlignment="Right" VerticalAlignment="Stretch" Height="20"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    BorderBrush="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    Width="{Binding displaySetting.WidthMiniMap, Source={x:Static ViewModels:ConfigViewModel.Instance}, Mode=OneWay}"
                                    Click="btnHiddenTopPane_Click" >
                                <Button.Content>
                                    <materialDesign:PackIcon Kind="ArrowCollapseUp" Height="18"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                             Width="{Binding displaySetting.WidthMiniMap, Source={x:Static ViewModels:ConfigViewModel.Instance}, Mode=OneTime}" />
                                </Button.Content>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" x:Name="TopPaneGrid" >
                    <UserControls:CodeEditorPane x:Name="codePaneTop" />
                </Grid>

                <GridSplitter x:Name="MainSplitter" Grid.Row="2" Height="3"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="#80D3D3D3" Cursor="SizeNS"
                              DragStarted="MainSplitter_DragStarted"
                              DragCompleted="MainSplitter_DragCompleted" />

                <Grid Grid.Row="3" >
                    <UserControls:CodeEditorPane x:Name="codePaneBottom" />
                </Grid>
            </Grid>
            
            <Canvas x:Name="ThumbCanvas" Background="{x:Null}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    SizeChanged="ThumbCanvas_SizeChanged" >
                <Thumb x:Name="ThumbSplit" Height="20" Canvas.Top="0" 
                       Width="{Binding displaySetting.WidthMiniMap, Source={x:Static ViewModels:ConfigViewModel.Instance}, Mode=OneWay}"
                       Background="Red" IsHitTestVisible="True"
                       DragStarted="ThumbSplit_DragStarted"
                       DragDelta="ThumbSplit_DragDelta"
                       DragCompleted="ThumbSplit_DragCompleted" >
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="border" Background="Transparent" BorderThickness="0.5"
                                    BorderBrush="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                                <Grid Background="Transparent">
                                    <materialDesign:PackIcon Kind="ArrowSplitHorizontal"
                                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                             HorizontalAlignment="Center" Height="20"
                                                             Width="{Binding displaySetting.WidthMiniMap, Source={x:Static ViewModels:ConfigViewModel.Instance}, Mode=OneWay}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#80D3D3D3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Canvas>

        </Grid>
    </materialDesign:Card>
</UserControl>
