<Window x:Class="CardEditor.Views.PreviewDescWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
        xmlns:Converter="clr-namespace:CardEditor.Converter"
        xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
        xmlns:Lag="clr-namespace:CardEditor.Localization"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        d:DataContext="{Binding RelativeSource={RelativeSource Self}}"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Title="Replace" Height="auto" Width="auto">

    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="Border" x:Key="BorderStyle">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#33FFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:Card UniformCornerRadius="5"
                         BorderThickness="1,0,1,1"
                         BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         d:FlowDirection="LeftToRight" >
        <Grid Width="700" Height="500" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="blHeader" Grid.Row="0" BorderThickness="0,0,0,0"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    Padding="3,3,5,3" CornerRadius="5" Margin="0,0,0,0" Height="30"
                    MouseLeftButtonDown="blHeader_MouseLeftButtonDown" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Lag:Localize PreView}" Margin="5,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />

                    <TextBlock Grid.Column="1" Text="{Lag:Localize PendulumLanguage}" Margin="5,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />

                    <Border x:Name="btnListBorder" Grid.Column="3" Width="40" CornerRadius="4"
                                VerticalAlignment="Stretch"  >
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource BorderStyle}" >
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=btn}" Value="True">
                                        <Setter Property="Background" Value="#72FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        
                        <ToggleButton x:Name="btn" Grid.Column="3"
                                      Width="32" Height="32" Margin="0" Padding="0"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                      Background="Transparent" Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignActionToggleButton}"
                                      BorderThickness="0" BorderBrush="Transparent"
                                      IsChecked="False" Checked="btn_Checked" Unchecked="btn_Unchecked" >
                            <materialDesign:PackIcon Kind="FormatListNumbered" Width="25" Height="25" />
                            <materialDesign:ToggleButtonAssist.OnContent>
                                <materialDesign:PackIcon Kind="Translate" Width="25" Height="25" />
                            </materialDesign:ToggleButtonAssist.OnContent>
                        </ToggleButton>

                    </Border>

                    <Border x:Name="btnLanguageListBorder" Grid.Column="4" Width="40" CornerRadius="4"
                                VerticalAlignment="Stretch"  >
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource BorderStyle}" >
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=btnLanguageList}" Value="True">
                                        <Setter Property="Background" Value="#72FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <ToggleButton x:Name="btnLanguageList"
                                      Width="32" Height="32" Margin="0" Padding="0"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                      Background="Transparent" Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignActionToggleButton}"
                                      BorderThickness="0" BorderBrush="Transparent"
                                      IsChecked="False" Checked="btnLanguageList_Checked" Unchecked="btnLanguageList_Unchecked" >
                            <materialDesign:PackIcon Kind="PlaylistEdit" Width="32" Height="32" />
                            <materialDesign:ToggleButtonAssist.OnContent>
                                <materialDesign:PackIcon Kind="Translate" Width="25" Height="25" />
                            </materialDesign:ToggleButtonAssist.OnContent>
                        </ToggleButton>
                    </Border>

                    <Border Grid.Column="5" Width="1" Margin="5,0,5,0"
                            HorizontalAlignment="Center" VerticalAlignment="Stretch"
                            Background="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />

                    <Button Grid.Column="6" Width="32" Height="32" Margin="0" Padding="0"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="Transparent" BorderThickness="0" BorderBrush="Transparent"
                            Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                            Command="{Binding CloseWindowCommand}" >
                        <Button.Content>
                            <Viewbox>
                                <materialDesign:PackIcon Kind="WindowClose" Padding="0" Margin="0" />
                            </Viewbox>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}" >
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#50FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                </Grid>
            </Border>

            <materialDesign:DrawerHost x:Name="MainHost" Grid.Row="1" >
                
                <materialDesign:DrawerHost.Content>
                    <Grid Margin="5" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="2" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Height="30" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Lag:Localize PendulumLanguage}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />

                            <ComboBox Grid.Column="1" Height="29" Margin="15,0,10,0"
                                      BorderThickness="0.7,0.5,0.7,0.5" Padding="5,0,10,0" IsEditable="False"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      ItemsSource="{Binding OrderedPenMapsUI, Source={x:Static ViewModels:PenLanguageViewModel.Instance}}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      DisplayMemberPath="Locale"
                                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                      VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                      materialDesign:ColorZoneAssist.Mode="Custom"
                                      Style="{StaticResource MaterialDesignFilledComboBox}"
                                      TextOptions.TextFormattingMode="Display"
                                      TextOptions.TextRenderingMode="ClearType"
                                      materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                                      materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                                <ComboBox.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Background" Value="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>

                            <Button Grid.Column="2" Margin="0,0,2,0" Padding="8,4,8,4" BorderThickness="0" Height="30"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    Style="{StaticResource ButtonSuccess}" Command="{Binding ReloadLanguageCommand}" >
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFE690FF" Offset="0.0"/>
                                        <GradientStop Color="#FFC200D4" Offset="0.3"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Content>
                                    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                        <StackPanel Orientation="Horizontal" >
                                            <TextBlock Text="{Lag:Localize tlReload}"
                                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Lag:Localize Language}" Margin="3,0,0,0"
                                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />

                                        </StackPanel>

                                    </Viewbox>
                                </Button.Content>
                            </Button>

                        </Grid>

                        <Grid Grid.Row="2" Height="35" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0" Panel.ZIndex="2"
                                          IsChecked="{Binding IsNormalCard}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" 
                                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                          Width="55" Height="28" Margin="10,0,0,0" >
                                <ToggleButton.Content>
                                    <materialDesign:PackIcon Kind="CloseThick" Foreground="Red" Width="auto" Height="24" Padding="0" Margin="0" />
                                </ToggleButton.Content>
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <materialDesign:PackIcon Kind="CheckOutline" Width="20" Height="20" />
                                </materialDesign:ToggleButtonAssist.OnContent>
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchSecondaryToggleButton}" >
                                        <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOffBackground" Value="Red" />
                                        <Setter Property="Background" Value="Red" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOnBackground" Value="Blue" />
                                                <Setter Property="Background" Value="Green" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <TextBlock Grid.Column="1" Text="{Lag:Localize NormalCard}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />

                            <TextBox x:Name="txtLeftScale" Grid.Column="2" Height="35" Width="100"
                                     Padding="5,10,3,0" BorderThickness="0.7"
                                     Text="{Binding LeftScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Behaviors:FileDropBehavior.Enable="True"
                                     Behaviors:PasteSanitizerBehavior.Enable="True"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                     materialDesign:HintAssist.Hint="{Lag:Localize scaleLeft}"
                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                     TextOptions.TextFormattingMode="Display"
                                     TextOptions.TextRenderingMode="ClearType"
                                     materialDesign:TextFieldAssist.HasClearButton="False"
                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                     materialDesign:ThemeAssist.Theme="Dark"
                                     materialDesign:TextFieldAssist.UnderlineBrush="Blue"
                                     CaretBrush="Blue" />

                            <TextBox x:Name="txtRightScale" Grid.Column="3" Height="35" Width="100"
                                     Padding="5,10,3,0" BorderThickness="0.7"
                                     Text="{Binding RightScaleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Behaviors:FileDropBehavior.Enable="True"
                                     Behaviors:PasteSanitizerBehavior.Enable="True"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                     materialDesign:HintAssist.Hint="{Lag:Localize scaleRight}"
                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                     TextOptions.TextFormattingMode="Display"
                                     TextOptions.TextRenderingMode="ClearType"
                                     materialDesign:TextFieldAssist.HasClearButton="False"
                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                     materialDesign:ThemeAssist.Theme="Dark"
                                     materialDesign:TextFieldAssist.UnderlineBrush="Red"
                                     CaretBrush="Red" />

                            <Button Grid.Column="4" Margin="8,0,0,0" Padding="8,4,8,4" BorderThickness="0" Height="32"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    Style="{StaticResource ButtonSuccess}" Command="{Binding SelectLanguageCommand}" >
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF7DFF55" Offset="0.0"/>
                                        <GradientStop Color="#FF00CF1B" Offset="0.3"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Content>
                                    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                        <TextBlock Text="{Lag:Localize Write}"
                                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Viewbox>
                                </Button.Content>
                            </Button>

                            <Button Grid.Column="5" Margin="2,0,2,0" Padding="8,4,8,4" BorderThickness="0" Height="32"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    Style="{StaticResource ButtonSuccess}" Command="{Binding ApplyLanguageCommand}" >
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF29E7FF" Offset="0.0" />
                                        <GradientStop Color="#FF006EDD" Offset="0.4" />
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Content>
                                    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                        <TextBlock Text="{Lag:Localize Apply}"
                                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Viewbox>
                                </Button.Content>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="4" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtPendulumEffect" Grid.Column="0" Padding="6,15,6,0" BorderThickness="0.7"
                                     TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                                     Text="{Binding PendulumEffect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Behaviors:FileDropBehavior.Enable="True"
                                     Behaviors:PasteSanitizerBehavior.Enable="True"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                                     materialDesign:HintAssist.Hint="{Lag:Localize PendulumEffect}"
                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                     TextOptions.TextFormattingMode="Display"
                                     TextOptions.TextRenderingMode="ClearType"
                                     materialDesign:TextFieldAssist.HasClearButton="False"
                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                     materialDesign:ThemeAssist.Theme="Dark" />

                            <Button x:Name="btnCopyPenEffect" Grid.Column="0" Margin="0,2,0,0" Padding="0"
                                    BorderThickness="0" Background="Transparent" Width="19" Height="17"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding CopyPenEffectCommand}" >
                                <Viewbox>
                                    <materialDesign:PackIcon Kind="{Binding CopyPenEffIcon}"
                                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnCopyPenEffect}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPressed, ElementName=btnCopyPenEffect}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Viewbox>
                            </Button>

                            <GridSplitter Grid.Column="1" Width="2"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

                            <TextBox x:Name="txtMonsterEffect" Grid.Column="2" Padding="6,15,6,0" BorderThickness="0.7"
                                     TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                                     Text="{Binding MonsterEffect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Behaviors:FileDropBehavior.Enable="True"
                                     Behaviors:PasteSanitizerBehavior.Enable="True"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                                     materialDesign:HintAssist.Hint="{Lag:Localize MonsterEffect}"
                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                     TextOptions.TextFormattingMode="Display"
                                     TextOptions.TextRenderingMode="ClearType"
                                     materialDesign:TextFieldAssist.HasClearButton="False"
                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                     materialDesign:ThemeAssist.Theme="Dark" />

                            <Button x:Name="btnCopyMonsEffect" Grid.Column="2" Margin="0,2,0,0" Padding="0"
                                    BorderThickness="0" Background="Transparent" Width="19" Height="17"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding CopyMonsterEffectCommand}" >
                                <Viewbox>
                                    <materialDesign:PackIcon Kind="{Binding CopyMonsEffIcon}"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnCopyMonsEffect}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPressed, ElementName=btnCopyMonsEffect}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Viewbox>
                            </Button>
                        </Grid>

                        <GridSplitter Grid.Row="5" Height="3"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

                        <Grid Grid.Row="6" >
                            <TextBox x:Name="txtCardDescription" Grid.Column="0" Padding="6,15,6,0" BorderThickness="0.7"
                                     TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                                     Text="{Binding CardDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Behaviors:FileDropBehavior.Enable="True"
                                     Behaviors:PasteSanitizerBehavior.Enable="True"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                                     materialDesign:HintAssist.Hint="{Lag:Localize CardDescription}"
                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                     TextOptions.TextFormattingMode="Display"
                                     TextOptions.TextRenderingMode="ClearType"
                                     materialDesign:TextFieldAssist.HasClearButton="False"
                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                     materialDesign:ThemeAssist.Theme="Dark" />

                            <Button x:Name="btnCopyCardDesc" Grid.Column="2" Margin="0,2,0,0" Padding="0"
                                    BorderThickness="0" Background="Transparent" Width="19" Height="17"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding CopyCardDescCommand}" >
                                <Viewbox>
                                    <materialDesign:PackIcon Kind="{Binding CopyCardDescIcon}"
                                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnCopyCardDesc}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPressed, ElementName=btnCopyCardDesc}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Viewbox>
                            </Button>
                        </Grid>

                    </Grid>
                </materialDesign:DrawerHost.Content>

                <materialDesign:DrawerHost.RightDrawerContent>
                    <Grid Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                          HorizontalAlignment="Stretch" Width="{Binding ActualWidth, ElementName=MainHost}" >

                    </Grid>
                </materialDesign:DrawerHost.RightDrawerContent>

                <materialDesign:DrawerHost.LeftDrawerContent>
                    <Grid Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                          HorizontalAlignment="Stretch" Width="{Binding ActualWidth, ElementName=MainHost}" >

                    </Grid>
                </materialDesign:DrawerHost.LeftDrawerContent>

            </materialDesign:DrawerHost>
        </Grid>
    </materialDesign:Card>
</Window>
