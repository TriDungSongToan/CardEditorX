<Window x:Class="CardEditor.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
        xmlns:UserControls="clr-namespace:CardEditor.UserControls"
        xmlns:Lag="clr-namespace:CardEditor.Localization"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        mc:Ignorable="d"
        Background="Transparent"
        Foreground="{Binding Foreground}"
        AllowsTransparency="True"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        DataContext="{Binding Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
        Width="1398" Height="800" >

    <Grid>
        <UserControls:ImageViewer x:Name="imageViewer" />
        <StackPanel Grid.Column="0" Panel.ZIndex="10" Orientation="Vertical"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="45" Margin="0" Background="Transparent" >
            
            <Button x:Name="btnClose" Width="40" Height="40" Margin="0" Padding="0"
                    BorderThickness="0" Background="Transparent" BorderBrush="Transparent"
                    Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="btnClose_Click" >
                <materialDesign:PackIcon Width="40" Height="40" Kind="Close" >
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnClose}" Value="True">
                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPressed, ElementName=btnClose}" Value="True">
                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
            </Button>

            <ToggleButton x:Name="tbtnFullscreen" Width="40" Height="40" Margin="0" Padding="0"
                          BorderThickness="0" Background="Transparent" BorderBrush="Transparent"
                          Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                          HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          Checked="tbtnFullscreen_Checked" Unchecked="tbtnFullscreen_Unchecked">
                <materialDesign:PackIcon Kind="Fullscreen"
                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Background="Transparent" Width="45" Height="45" />
                <materialDesign:ToggleButtonAssist.OnContent>
                    <materialDesign:PackIcon Kind="FullscreenExit" Foreground="{Binding Foreground}"
                                             Background="Transparent" Width="40" Height="40" />
                </materialDesign:ToggleButtonAssist.OnContent>
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignActionDarkToggleButton}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <Button x:Name="btnMore" Width="40" Height="40" Margin="0" Padding="0"
                    BorderThickness="0" Background="Transparent" BorderBrush="Transparent"
                    Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="btnMore_Click" >
                <materialDesign:PackIcon Width="35" Height="35" Kind="CardPlus" >
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnMore}" Value="True">
                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPressed, ElementName=btnMore}" Value="True">
                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
            </Button>
        </StackPanel>
    </Grid>
</Window>