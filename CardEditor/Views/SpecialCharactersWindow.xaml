<Window x:Class="CardEditor.SpecialCharactersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:Lag="clr-namespace:CardEditor.Localization"
        xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="Transparent"
        Foreground="{Binding Foreground}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        mc:Ignorable="d"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Title="SpecialCharacters" Height="300" Width="260">
    <materialDesign:Card UniformCornerRadius="5" BorderThickness="1" Padding="5" d:FlowDirection="LeftToRight"
                         FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ComboBox x:Name="cmbCategory" Grid.Row="0" Width="auto" Height="45"
                      BorderThickness="0.7" IsEditable="False" Padding="10,18,12,5"
                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                      Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                      VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                      materialDesign:ColorZoneAssist.Mode="Custom"
                      materialDesign:HintAssist.Hint="{Lag:Localize cardLabelCategory}"
                      Style="{StaticResource MaterialDesignFilledComboBox}"
                      TextOptions.TextFormattingMode="Display"
                      TextOptions.TextRenderingMode="ClearType"
                      materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                      materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" />

            <TextBox x:Name="txtSearch" Grid.Row="2" Width="auto" Height="45"
                     Padding="10,13,3,0" BorderThickness="0.7"
                     Text="{Binding userSetting.DataSource, UpdateSourceTrigger=PropertyChanged}"
                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                     materialDesign:HintAssist.Hint="{Lag:Localize tlFilter}"
                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                     TextOptions.TextFormattingMode="Display"
                     TextOptions.TextRenderingMode="ClearType"
                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                     materialDesign:ThemeAssist.Theme="Dark" />

            <ListBox x:Name="lstCharacters" Grid.Row="4" BorderThickness="0.7"
                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                     SelectionChanged="lstCharacters_SelectionChanged" >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Character}" Margin="0,0,10,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                            <TextBlock Text="{Binding Description}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       FontStyle="Italic"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        <Setter Property="Opacity" Value="0.5" />
                    </Style>
                </ListBox.Resources>
            </ListBox>

            <Grid Grid.Row="6" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtresult" Grid.Column="0" Width="auto" Height="35"
                         Padding="10,13,3,0" BorderThickness="0.7"
                         BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                         Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                         TextOptions.TextFormattingMode="Display"
                         TextOptions.TextRenderingMode="ClearType"
                         materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                         materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                         materialDesign:ThemeAssist.Theme="Dark" />

                <Button x:Name="btnInsert" Grid.Column="2"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Margin="0" Padding="15,3,15,3" FontSize="17" Width="auto" Height="35"
                        materialDesign:ButtonAssist.CornerRadius="5" BorderThickness="0"
                        Click="BtnInsert_Click">
                    <Button.Content>
                        <TextBlock Text="{Lag:Localize Insert}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontSize="17" />
                    </Button.Content>
                </Button>
            </Grid>
        </Grid>
    </materialDesign:Card>
</Window>
