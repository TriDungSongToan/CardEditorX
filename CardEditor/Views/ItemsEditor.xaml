<Window x:Class="CardEditor.Views.ItemsEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
        xmlns:Converter="clr-namespace:CardEditor.Converter"
        xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
        xmlns:Lag="clr-namespace:CardEditor.Localization"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        d:DataContext="{Binding RelativeSource={RelativeSource Self}}"
        mc:Ignorable="d"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        Title="Replace" Height="auto" Width="auto">

    <Window.Resources>
        <Converter:BitToBoolConverter x:Key="BitToBoolConverter"/>
        
        <DataTemplate x:Key="ReplaceFieldToggleTemplate">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Panel.ZIndex="2"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                              Width="50" Height="25" Margin="0,0,5,0"
                              Checked="ReplaceFieldToggle_Checked"
                              Unchecked="ReplaceFieldToggle_Unchecked" >
                    <ToggleButton.IsChecked>
                        <MultiBinding Converter="{StaticResource BitToBoolConverter}" Mode="OneWay" >
                            <Binding Path="DataContext.ReplaceFieldFlags"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="Index"/>
                        </MultiBinding>
                    </ToggleButton.IsChecked>

                    <ToggleButton.Content>
                        <materialDesign:PackIcon Kind="CloseThick" Foreground="Red" Width="auto" Height="24" Padding="0" Margin="0" />
                    </ToggleButton.Content>
                    <materialDesign:ToggleButtonAssist.OnContent>
                        <materialDesign:PackIcon Kind="CheckOutline" Width="20" Height="20" />
                    </materialDesign:ToggleButtonAssist.OnContent>
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchSecondaryToggleButton}" >
                            <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOffBackground" Value="Red" />
                            <Setter Property="Background" Value="Red" />
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOnBackground" Value="Blue" />
                                    <Setter Property="Background" Value="Green" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ImportDataToggleTemplate">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Panel.ZIndex="2"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                              Width="50" Height="25" Margin="0,0,5,0"
                              Checked="ImportDataToggle_Checked"
                              Unchecked="ImportDataToggle_Unchecked" >
                    <ToggleButton.IsChecked>
                        <MultiBinding Converter="{StaticResource BitToBoolConverter}" Mode="OneWay" >
                            <Binding Path="DataContext.ImportDataFlags"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="Index"/>
                        </MultiBinding>
                    </ToggleButton.IsChecked>

                    <ToggleButton.Content>
                        <materialDesign:PackIcon Kind="CloseThick" Foreground="Red" Width="auto" Height="24" Padding="0" Margin="0" />
                    </ToggleButton.Content>
                    <materialDesign:ToggleButtonAssist.OnContent>
                        <materialDesign:PackIcon Kind="CheckOutline" Width="20" Height="20" />
                    </materialDesign:ToggleButtonAssist.OnContent>
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchSecondaryToggleButton}" >
                            <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOffBackground" Value="Red" />
                            <Setter Property="Background" Value="Red" />
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOnBackground" Value="Blue" />
                                    <Setter Property="Background" Value="Green" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>

                </ToggleButton>
            </Grid>
        </DataTemplate>

        <Converter:ColorWithOpacityConverter x:Key="ColorWithOpacityConverter"/>
        <Converter:PositiveBoolToVisibilityConverter x:Key="PositiveBoolToVisibilityConverter"/>
        <Converter:NegativeBoolToVisibilityConverter x:Key="NegativeBoolToVisibilityConverter"/>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="DGR_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DGR_Border"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Brushes.Transparent}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Normal_Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DGR_Border"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Brushes.Transparent}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Normal_Editing">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DGR_Border"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Brushes.Transparent}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DGR_Border"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{Binding ThemeColor,
                                                    Source={x:Static ViewModels:UIConfigViewModel.Instance},
                                                    Converter={StaticResource ColorWithOpacityConverter},
                                                    ConverterParameter=0.5}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="MouseOver_Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DGR_Border"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{Binding ThemeColor,
                                                    Source={x:Static ViewModels:UIConfigViewModel.Instance},
                                                    Converter={StaticResource ColorWithOpacityConverter},
                                                    ConverterParameter=1}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DGR_Border"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{Binding ThemeColor,
                                                    Source={x:Static ViewModels:UIConfigViewModel.Instance},
                                                    Converter={StaticResource ColorWithOpacityConverter},
                                                    ConverterParameter=1}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused_Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DGR_Border"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{Binding ThemeColor,
                                                    Source={x:Static ViewModels:UIConfigViewModel.Instance},
                                                    Converter={StaticResource ColorWithOpacityConverter},
                                                    ConverterParameter=1}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </SelectiveScrollingGrid.RowDefinitions>

                                <DataGridCellsPresenter Grid.Column="1"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                                <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1"
                                                          SelectiveScrollingGrid.SelectiveScrollingOrientation=
                                                          "{Binding AreRowDetailsFrozen,
                                    ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical},
                                    Converter={x:Static DataGrid.RowDetailsScrollingConverter},
                                    RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                          Visibility="{TemplateBinding DetailsVisibility}"/>

                                <DataGridRowHeader Grid.RowSpan="2"
                                                   SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                                   Visibility="{Binding HeadersVisibility,
                                    ConverterParameter={x:Static DataGridHeadersVisibility.Row},
                                    Converter={x:Static DataGrid.HeadersVisibilityConverter},
                                    RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                            </SelectiveScrollingGrid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <materialDesign:Card UniformCornerRadius="5"
                         BorderThickness="1,0,1,1"
                         BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         d:FlowDirection="LeftToRight" >
        <Grid Width="550" Height="350" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="blHeader" Grid.Row="0" BorderThickness="0,0,0,0"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    Padding="5,3,5,3" CornerRadius="5" Margin="0,0,0,0" Height="35"
                    MouseLeftButtonDown="blHeader_MouseLeftButtonDown" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Kind="{Binding HeaderIcon}" Grid.Column="0" Width="25" Height="25"
                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />

                    <TextBlock x:Name="txtHeader" Grid.Column="1" Text="{Lag:Localize ItemsEdit}" Margin="10,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />

                    <Button x:Name="btnClose" Grid.Column="2" Width="32" Height="32" Margin="0" Padding="0"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="Transparent" BorderThickness="0" BorderBrush="Transparent"
                            Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                            Command="{Binding CancelCommand}" >
                        <Button.Content>
                            <Viewbox>
                                <materialDesign:PackIcon Kind="WindowClose" Padding="0" Margin="0" />
                            </Viewbox>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}" >
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <TabControl x:Name="tabMain" Grid.Row="1" TabStripPlacement="Top"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top"
                        materialDesign:ColorZoneAssist.Mode="Custom"
                        materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                        materialDesign:NavigationRailAssist.SelectionCornerRadius="40"
                        Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                        Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                        Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                        SelectedIndex="{Binding TabHeaderIndex}" >

                <TabItem HorizontalAlignment="Center" Padding="0" Margin="0" >
                    <Grid Margin="10,0,10,5" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Height="0.5" Margin="0" HorizontalAlignment="Stretch"
                                Background="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />

                        <Grid Grid.Row="1" Margin="2,7,2,7" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0" Panel.ZIndex="2"
                                          IsChecked="{Binding filterSetting.Advanced}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" 
                                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                          Width="55" Height="28" Margin="0,0,10,0" >
                                <ToggleButton.Content>
                                    <materialDesign:PackIcon Kind="CloseThick" Foreground="Red" Width="auto" Height="24" Padding="0" Margin="0" />
                                </ToggleButton.Content>
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <materialDesign:PackIcon Kind="CheckOutline" Width="20" Height="20" />
                                </materialDesign:ToggleButtonAssist.OnContent>
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchSecondaryToggleButton}" >
                                        <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOffBackground" Value="Red" />
                                        <Setter Property="Background" Value="Red" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOnBackground" Value="Blue" />
                                                <Setter Property="Background" Value="Green" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <Viewbox Grid.Column="1" HorizontalAlignment="Left"
                                     Margin="0,0,0,0" Stretch="None" StretchDirection="Both" >
                                <TextBlock Text="{Lag:Localize advanFil}"
                                           Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MaterialDesignTextBlock}" />
                            </Viewbox>

                            <Button Grid.Column="2" Height="30" Margin="0,0,5,0" Padding="14,0,14,0"
                                    Command="{Binding SaveSettingCommand}" Content="{Lag:Localize Save}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Style="{StaticResource ButtonDanger}" />
                        </Grid>

                        <Border Grid.Row="2" Height="1" IsHitTestVisible="False"
                                Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />

                        <Grid x:Name="grAdvancedOption" Grid.Row="3" Margin="2,7,2,7"
                              IsEnabled="{Binding filterSetting.Advanced}" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="chkMatchCase" Grid.Row="0" Grid.Column="0" Content="{Lag:Localize matchCase}"
                                      IsChecked="{Binding filterSetting.MatchCase}" Height="auto" MinHeight="35" Margin="0" Padding="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                            <CheckBox x:Name="chkPrefix" Grid.Row="2" Grid.Column="0" Content="{Lag:Localize prefix}"
                                      IsChecked="{Binding filterSetting.Prefix}" Height="auto" MinHeight="35" Margin="0" Padding="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                            <CheckBox x:Name="chkSuffix" Grid.Row="4" Grid.Column="0" Content="{Lag:Localize suffix}"
                                      IsChecked="{Binding filterSetting.Suffix}" Height="auto" MinHeight="35" Margin="0" Padding="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                            <CheckBox x:Name="chkMatchWhole" Grid.Row="0" Grid.Column="2" Content="{Lag:Localize matchWhole}"
                                      IsChecked="{Binding filterSetting.MatchWhole}" Height="auto" MinHeight="35" Margin="0" Padding="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                            <CheckBox x:Name="chkWildcards" Grid.Row="2" Grid.Column="2" Content="{Lag:Localize wildcards}"
                                      IsChecked="{Binding filterSetting.Wildcards}" Height="auto" MinHeight="35" Margin="0" Padding="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                            <CheckBox x:Name="chkIgnpunct" Grid.Row="4" Grid.Column="2" Content="{Lag:Localize ignpunct}"
                                      IsChecked="{Binding filterSetting.Ignpunct}" Height="auto" MinHeight="35" Margin="0" Padding="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                            <CheckBox x:Name="chkIgnspace" Grid.Row="6" Grid.Column="2" Content="{Lag:Localize ignspace}"
                                      IsChecked="{Binding filterSetting.Ignpspace}" Height="auto" MinHeight="35" Margin="0" Padding="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                        </Grid>
                    </Grid>
                    
                    <TabItem.Header>
                        <StackPanel Width="auto" Height="auto" Margin="0" Background="{x:Null}" >
                            <materialDesign:PackIcon Width="24" Height="24" Kind="CogOutline" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="12"
                                       Text="{Lag:Localize filterSetting}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />

                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                
                <TabItem HorizontalAlignment="Center" Padding="0" Margin="0" >
                    <Grid Margin="10,0,10,5" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Height="0.5" Margin="0" HorizontalAlignment="Stretch"
                                Background="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        
                        <TextBox x:Name="txtfindwhat" Grid.Row="2" Height="43" Padding="10,13,3,0" BorderThickness="0.7"
                                 Text="{Binding FindWhat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                 VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                 materialDesign:HintAssist.Hint="{Lag:Localize FindWhat}"
                                 Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                 TextOptions.TextFormattingMode="Display"
                                 TextOptions.TextRenderingMode="ClearType"
                                 materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                 materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                 materialDesign:ThemeAssist.Theme="Dark" />
                        
