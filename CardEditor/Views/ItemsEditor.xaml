                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" TextAlignment="Left" TextWrapping="Wrap" />
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                        <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                                    </Style>
                                                </DataGridTextColumn.HeaderStyle>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </materialDesign:DataGridTextColumn>
                                            <materialDesign:DataGridTextColumn Width="*" Binding="{Binding Name}" IsReadOnly="True"
                                                                               Header="{Lag:Localize CreditName}">
                                                <DataGridTextColumn.HeaderStyle>
                                                    <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" TextAlignment="Left" TextWrapping="Wrap" />
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                        <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                                    </Style>
                                                </DataGridTextColumn.HeaderStyle>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </materialDesign:DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <Grid Grid.Row="2" Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Margin="0" Padding="4" BorderThickness="0" Height="30"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            Style="{StaticResource ButtonSuccess}" Command="{Binding AddCreditCommand}" >
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFAAFF90" Offset="0.0"/>
                                                <GradientStop Color="#FF19D400" Offset="0.3"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                                <TextBlock Text="{Lag:Localize tlAdd}"
                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Viewbox>
                                        </Button.Content>
                                    </Button>

                                    <Button Grid.Column="2" Margin="0" Padding="4" BorderThickness="0" Height="30"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            Style="{StaticResource ButtonSuccess}" Command="{Binding ModifyCreditCommand}" >
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF30FFFF" Offset="0.0"/>
                                                <GradientStop Color="#FF008EFF" Offset="0.35"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                                <TextBlock Text="{Lag:Localize tlModify}"
                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Viewbox>
                                        </Button.Content>
                                    </Button>

                                    <Button Grid.Column="4" Margin="0" Padding="4" BorderThickness="0" Height="30"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            Style="{StaticResource ButtonSuccess}" Command="{Binding ResetCreditCommand}" >
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#E633FFFF" Offset="0.0" />
                                                <GradientStop Color="#FFCA00DC" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                                <TextBlock Text="{Lag:Localize tlReset}"
                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Viewbox>
                                        </Button.Content>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="4" Height="30" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Margin="0" Padding="4" BorderThickness="0" Height="30"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            Style="{StaticResource ButtonSuccess}" Command="{Binding ClearCreditCommand}" >
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" >
                                                <GradientStop Color="#FFFFCCA0" Offset="0.0" />
                                                <GradientStop Color="#FFFF8921" Offset="0.3"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" >
                                                <TextBlock Text="{Lag:Localize tlClear}"
                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Viewbox>
                                        </Button.Content>
                                    </Button>

                                    <Button Grid.Column="2" Margin="0" Padding="4" BorderThickness="0" Height="30"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            Style="{StaticResource ButtonSuccess}" Command="{Binding SortCreditCommand}" >
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF326CF3" Offset="0.0" />
                                                <GradientStop Color="#FF00D1FF" Offset="0.4"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                                <TextBlock Text="{Lag:Localize Sort}"
                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Viewbox>
                                        </Button.Content>
                                    </Button>

                                    <Button Grid.Column="4" Margin="0" Padding="4" BorderThickness="0" Height="30"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                            Style="{StaticResource ButtonSuccess}" Command="{Binding DeleteCreditCommand}" >
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFFFA5AA" Offset="0.0" />
                                                <GradientStop Color="#FFF01717" Offset="0.4" />
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                                <TextBlock Text="{Lag:Localize tlDelete}"
                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Viewbox>
                                        </Button.Content>
                                    </Button>

                                </Grid>

                            </Grid>

                            <StackPanel Grid.Column="2" Orientation="Vertical" >

                                <Grid Height="80" Margin="0,0,0,0" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="2" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <ComboBox Grid.Row="0" BorderThickness="0.7" Padding="5,15,10,2" IsEditable="False"
                                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  SelectedIndex="{Binding SelectedScopeCredit, Mode=TwoWay}"
                                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                                  materialDesign:HintAssist.Hint="{Lag:Localize cardLabelScope}"
                                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                                  TextOptions.TextFormattingMode="Display"
                                                  TextOptions.TextRenderingMode="ClearType"
                                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                                            <ComboBoxItem Content="{Lag:Localize SelectCards}" />
                                            <ComboBoxItem Content="{Lag:Localize FoundCards}" />
                                            <ComboBoxItem Content="{Lag:Localize AllCards}" />
                                        </ComboBox>

                                        <ComboBox Grid.Row="2" BorderThickness="0.7" Padding="5,15,10,2" IsEditable="False"
                                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  SelectedIndex="{Binding SelectedWriteModeCredit, Mode=TwoWay}"
                                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                                  materialDesign:HintAssist.Hint="{Lag:Localize WriteMode}"
                                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                                  TextOptions.TextFormattingMode="Display"
                                                  TextOptions.TextRenderingMode="ClearType"
                                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                                            <ComboBoxItem Content="{Lag:Localize AskMe}" />
                                            <ComboBoxItem Content="{Lag:Localize OverwriteDupli}" />
                                            <ComboBoxItem Content="{Lag:Localize OverwriteAll}" />
                                            <ComboBoxItem Content="{Lag:Localize Appendwrite}" />
                                            <ComboBoxItem Content="{Lag:Localize Skip}" />
                                        </ComboBox>

                                    </Grid>

                                    <Grid Grid.Column="2" Width="90" >
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        
                                        <Button Grid.Row="0" Margin="0" Padding="4" BorderThickness="0" Height="26"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                Style="{StaticResource ButtonSuccess}" Command="{Binding RollbackCreditCommand}" >
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#FFEF9AFF" Offset="0.0" />
                                                    <GradientStop Color="#FFA500ED" Offset="0.4"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <Button.Content>
                                                <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                                    <TextBlock Text="{Lag:Localize RollBack}"
                                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Viewbox>
                                            </Button.Content>
                                        </Button>

                                        <Button Grid.Row="2" Margin="0" Padding="4" BorderThickness="0" Height="26"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                Style="{StaticResource ButtonSuccess}" Command="{Binding RemoveCreditCommand}" >
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" >
                                                    <GradientStop Color="#FFFFD1A9" Offset="0.0" />
                                                    <GradientStop Color="#FFE66C00" Offset="0.3"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <Button.Content>
                                                <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" >
                                                    <TextBlock Text="{Lag:Localize Remove}"
                                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Viewbox>
                                            </Button.Content>
                                        </Button>

                                        <Button Grid.Row="4" Margin="0" Padding="4" BorderThickness="0" Height="26"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="1"
                                                Visibility="{Binding IsApplyingCredit, Converter={StaticResource NegativeBoolToVisibilityConverter}}"
                                                FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                Style="{StaticResource ButtonSuccess}" Command="{Binding CancelCreditCommand}" >
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#FFAAFDAC" Offset="0.0" />
                                                    <GradientStop Color="#FF13DD00" Offset="0.4" />
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <Button.Content>
                                                <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                                    <TextBlock Text="{Lag:Localize cancel}"
                                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Viewbox>
                                            </Button.Content>
                                        </Button>
                                        
                                        <Button Grid.Row="4" Margin="0" Padding="4" BorderThickness="0" Height="26"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Panel.ZIndex="2"
                                                Visibility="{Binding IsApplyingCredit, Converter={StaticResource PositiveBoolToVisibilityConverter}}"
                                                FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                Style="{StaticResource ButtonSuccess}" Command="{Binding ApplyCreditCommand}" >
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#FF29E7FF" Offset="0.0" />
                                                    <GradientStop Color="#FF006EDD" Offset="0.4" />
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <Button.Content>
                                                <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" >
                                                    <TextBlock Text="{Lag:Localize Apply}"
                                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Viewbox>
                                            </Button.Content>
                                        </Button>
                                        
                                    </Grid>

                                </Grid>
                                
                                <Grid Grid.Row="2" Margin="0,2,0,0" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="2" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Width="80" Height="39"
                                             Padding="8,10,3,0" BorderThickness="0.7"
                                             Text="{Binding IdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Behaviors:FileDropBehavior.Enable="True"
                                             Behaviors:PasteSanitizerBehavior.Enable="True"
                                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                             materialDesign:HintAssist.Hint="{Lag:Localize dataGridID}"
                                             Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                             TextOptions.TextFormattingMode="Display"
                                             TextOptions.TextRenderingMode="ClearType"
                                             materialDesign:TextFieldAssist.HasClearButton="False"
                                             materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                             materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                             materialDesign:ThemeAssist.Theme="Dark" />

                                    <TextBox Grid.Column="2" Height="39"
                                             Padding="8,10,3,0" BorderThickness="0.7"
                                             Text="{Binding CreditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Behaviors:FileDropBehavior.Enable="True"
                                             Behaviors:PasteSanitizerBehavior.Enable="True"
                                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                             materialDesign:HintAssist.Hint="{Lag:Localize CreditName}"
                                             Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                             TextOptions.TextFormattingMode="Display"
                                             TextOptions.TextRenderingMode="ClearType"
                                             materialDesign:TextFieldAssist.HasClearButton="False"
                                             materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                             materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                             materialDesign:ThemeAssist.Theme="Dark" />
                                </Grid>

                                <Grid Margin="0,2,0,0" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Height="39"
                                             Padding="8,10,3,0" BorderThickness="0.7"
                                             Text="{Binding CreditHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Behaviors:FileDropBehavior.Enable="True"
                                             Behaviors:PasteSanitizerBehavior.Enable="True"
                                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                             materialDesign:HintAssist.Hint="Credit Header"
                                             Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                             TextOptions.TextFormattingMode="Display"
                                             TextOptions.TextRenderingMode="ClearType"
                                             materialDesign:TextFieldAssist.HasClearButton="False"
                                             materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                             materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                             materialDesign:ThemeAssist.Theme="Dark" />

                                    <TextBox Grid.Column="2" Height="39"
                                             Padding="8,10,3,0" BorderThickness="0.7"
                                             Text="{Binding CreditFooter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Behaviors:FileDropBehavior.Enable="True"
                                             Behaviors:PasteSanitizerBehavior.Enable="True"
                                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                             materialDesign:HintAssist.Hint="Credit Footer"
                                             Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                             TextOptions.TextFormattingMode="Display"
                                             TextOptions.TextRenderingMode="ClearType"
                                             materialDesign:TextFieldAssist.HasClearButton="False"
                                             materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                             materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                             materialDesign:ThemeAssist.Theme="Dark" />

                                </Grid>

                            </StackPanel>

                        </Grid>

                        <Grid Grid.Row="4" >
                            <TextBox Padding="6,14,6,0" BorderThickness="0.7"
                                     TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                                     Text="{Binding CreditDesc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Behaviors:FileDropBehavior.Enable="True"
                                     Behaviors:PasteSanitizerBehavior.Enable="True"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                                     materialDesign:HintAssist.Hint="{Lag:Localize CreditDesc}"
                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                     TextOptions.TextFormattingMode="Display"
                                     TextOptions.TextRenderingMode="ClearType"
                                     materialDesign:TextFieldAssist.HasClearButton="False"
                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                     materialDesign:ThemeAssist.Theme="Dark" />
                        </Grid>
                        
                    </Grid>

                    <TabItem.Header>
                        <StackPanel Width="auto" Height="auto" Background="{x:Null}" >
                            <materialDesign:PackIcon Width="24" Height="24" Kind="CreditCardEditOutline" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="12"
                                       Text="{Lag:Localize CreditTeam}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                
            </TabControl>
        </Grid>
    </materialDesign:Card>
</Window>
