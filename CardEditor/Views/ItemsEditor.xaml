<Window x:Class="CardEditor.Views.ItemsEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
        xmlns:Converter="clr-namespace:CardEditor.Converter"
        xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
        xmlns:Lag="clr-namespace:CardEditor.Localization"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        d:DataContext="{Binding RelativeSource={RelativeSource Self}}"
        mc:Ignorable="d"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        Title="Replace" Height="auto" Width="auto">

    <Window.Resources>
        <Converter:BitToBoolConverter x:Key="BitToBoolConverter"/>
        
        <DataTemplate x:Key="ReplaceFieldToggleTemplate">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Panel.ZIndex="2"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                              Width="50" Height="25" Margin="0,0,5,0"
                              Checked="ReplaceFieldToggle_Checked"
                              Unchecked="ReplaceFieldToggle_Unchecked" >
                    <ToggleButton.IsChecked>
                        <MultiBinding Converter="{StaticResource BitToBoolConverter}" Mode="OneWay" >
                            <Binding Path="DataContext.ReplaceFieldFlags"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="Index"/>
                        </MultiBinding>
                    </ToggleButton.IsChecked>

                    <ToggleButton.Content>
                        <materialDesign:PackIcon Kind="CloseThick" Foreground="Red" Width="auto" Height="24" Padding="0" Margin="0" />
                    </ToggleButton.Content>
                    <materialDesign:ToggleButtonAssist.OnContent>
                        <materialDesign:PackIcon Kind="CheckOutline" Width="20" Height="20" />
                    </materialDesign:ToggleButtonAssist.OnContent>
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchSecondaryToggleButton}" >
                            <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOffBackground" Value="Red" />
                            <Setter Property="Background" Value="Red" />
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOnBackground" Value="Blue" />
                                    <Setter Property="Background" Value="Green" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ImportDataToggleTemplate">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Panel.ZIndex="2"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                              Width="50" Height="25" Margin="0,0,5,0"
                              Checked="ImportDataToggle_Checked"
                              Unchecked="ImportDataToggle_Unchecked" >
                    <ToggleButton.IsChecked>
                        <MultiBinding Converter="{StaticResource BitToBoolConverter}" Mode="OneWay" >
                            <Binding Path="DataContext.ImportDataFlags"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="Index"/>
                        </MultiBinding>
                    </ToggleButton.IsChecked>

                    <ToggleButton.Content>
                        <materialDesign:PackIcon Kind="CloseThick" Foreground="Red" Width="auto" Height="24" Padding="0" Margin="0" />
                    </ToggleButton.Content>
                    <materialDesign:ToggleButtonAssist.OnContent>
                        <materialDesign:PackIcon Kind="CheckOutline" Width="20" Height="20" />
                    </materialDesign:ToggleButtonAssist.OnContent>
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchSecondaryToggleButton}" >
                            <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOffBackground" Value="Red" />
                            <Setter Property="Background" Value="Red" />
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOnBackground" Value="Blue" />
                                    <Setter Property="Background" Value="Green" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>

                </ToggleButton>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <materialDesign:Card UniformCornerRadius="5"
                         BorderThickness="1,0,1,1"
                         BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         d:FlowDirection="LeftToRight" >
        <Grid Width="550" Height="350" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="blHeader" Grid.Row="0" BorderThickness="0,0,0,0"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    Padding="5,3,5,3" CornerRadius="5" Margin="0,0,0,0" Height="35"
                    MouseLeftButtonDown="blHeader_MouseLeftButtonDown" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="iconHeader" Grid.Column="0" Width="25" Height="25"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <TextBlock x:Name="txtHeader" Grid.Column="1" Text="{Lag:Localize ItemsEdit}" Margin="10,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />

                    <Button x:Name="btnClose" Grid.Column="2" Width="32" Height="32" Margin="0" Padding="0"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="Transparent" BorderThickness="0" BorderBrush="Transparent"
                            Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                            Command="{Binding CancelCommand}" >
                        <Button.Content>
                            <Viewbox>
                                <materialDesign:PackIcon Kind="WindowClose" Padding="0" Margin="0" />
                            </Viewbox>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}" >
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <TabControl x:Name="tabMain" Grid.Row="1" TabStripPlacement="Left"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top"
                        materialDesign:ColorZoneAssist.Mode="Custom"
                        materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                        materialDesign:NavigationRailAssist.SelectionCornerRadius="50"
                        Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                        Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                        Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                        SelectedIndex="{Binding TabHeaderIndex}" >

                <TabItem HorizontalAlignment="Center" Padding="0" Margin="0" >
                    <Grid Margin="10" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0" Panel.ZIndex="2"
                                          IsChecked="{Binding filterSetting.Advanced}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" 
                                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                          Width="55" Height="28" Margin="0,0,10,0" >
                                <ToggleButton.Content>
                                    <materialDesign:PackIcon Kind="CloseThick" Foreground="Red" Width="auto" Height="24" Padding="0" Margin="0" />
                                </ToggleButton.Content>
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <materialDesign:PackIcon Kind="CheckOutline" Width="20" Height="20" />
                                </materialDesign:ToggleButtonAssist.OnContent>
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchSecondaryToggleButton}" >
                                        <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOffBackground" Value="Red" />
                                        <Setter Property="Background" Value="Red" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOnBackground" Value="Blue" />
                                                <Setter Property="Background" Value="Green" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <Viewbox Grid.Column="1" HorizontalAlignment="Left"
                                     Margin="0,0,0,0" Stretch="None" StretchDirection="Both" >
                                <TextBlock Text="{Lag:Localize advanFil}"
                                           Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MaterialDesignTextBlock}" />
                            </Viewbox>

                            <Button Grid.Column="2" Height="30" Margin="0,0,5,0" Padding="14,0,14,0"
                                    Command="{Binding SaveSettingCommand}" Content="{Lag:Localize Save}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Style="{StaticResource ButtonDanger}" />
                        </Grid>

                        <Border Grid.Row="2" Height="1" IsHitTestVisible="False"
                                Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />

                        <Grid x:Name="grAdvancedOption" Grid.Row="4" Margin="0"
                              IsEnabled="{Binding filterSetting.Advanced}" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="chkMatchCase" Grid.Row="0" Grid.Column="0" Content="{Lag:Localize matchCase}"
                                      IsChecked="{Binding filterSetting.MatchCase}" Height="auto" MinHeight="35" Margin="0" Padding="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                            <CheckBox x:Name="chkPrefix" Grid.Row="2" Grid.Column="0" Content="{Lag:Localize prefix}"
                                      IsChecked="{Binding filterSetting.Prefix}" Height="auto" MinHeight="35" Margin="0" Padding="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                            <CheckBox x:Name="chkSuffix" Grid.Row="4" Grid.Column="0" Content="{Lag:Localize suffix}"
                                      IsChecked="{Binding filterSetting.Suffix}" Height="auto" MinHeight="35" Margin="0" Padding="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                            <CheckBox x:Name="chkMatchWhole" Grid.Row="0" Grid.Column="2" Content="{Lag:Localize matchWhole}"
                                      IsChecked="{Binding filterSetting.MatchWhole}" Height="auto" MinHeight="35" Margin="0" Padding="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                            <CheckBox x:Name="chkWildcards" Grid.Row="2" Grid.Column="2" Content="{Lag:Localize wildcards}"
                                      IsChecked="{Binding filterSetting.Wildcards}" Height="auto" MinHeight="35" Margin="0" Padding="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                            <CheckBox x:Name="chkIgnpunct" Grid.Row="4" Grid.Column="2" Content="{Lag:Localize ignpunct}"
                                      IsChecked="{Binding filterSetting.Ignpunct}" Height="auto" MinHeight="35" Margin="0" Padding="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                            <CheckBox x:Name="chkIgnspace" Grid.Row="6" Grid.Column="2" Content="{Lag:Localize ignspace}"
                                      IsChecked="{Binding filterSetting.Ignpspace}" Height="auto" MinHeight="35" Margin="0" Padding="0"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                        </Grid>
                    </Grid>
                    
                    <TabItem.Header>
                        <StackPanel Width="auto" Height="auto" Background="{x:Null}" >
                            <materialDesign:PackIcon Width="24" Height="24" Kind="CogOutline" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="12"
                                       Text="{Lag:Localize filterSetting}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                
                <TabItem HorizontalAlignment="Center" Padding="0" Margin="0" >
                    <Grid Margin="10" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="txtfindwhat" Grid.Row="0" Height="43" Padding="10,13,3,0" BorderThickness="0.7"
                                 Text="{Binding FindWhat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                 VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                 materialDesign:HintAssist.Hint="{Lag:Localize FindWhat}"
                                 Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                 TextOptions.TextFormattingMode="Display"
                                 TextOptions.TextRenderingMode="ClearType"
                                 materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                 materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                 materialDesign:ThemeAssist.Theme="Dark" />
                        
                        <TextBox x:Name="txtreplacewith" Grid.Row="2" Height="43" Padding="10,13,3,0" BorderThickness="0.7"
                                 Text="{Binding ReplaceWith, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                 VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                 materialDesign:HintAssist.Hint="{Lag:Localize Replacewith}"
                                 Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                 TextOptions.TextFormattingMode="Display"
                                 TextOptions.TextRenderingMode="ClearType"
                                 materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                 materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                 materialDesign:ThemeAssist.Theme="Dark" />

                        <Grid Grid.Row="4" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="cmbScope" Grid.Column="0" Height="43"
                                      BorderThickness="0.7" Padding="10,18,12,5" IsEditable="False"
                                      BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      SelectedIndex="{Binding Scope, Mode=TwoWay}"
                                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                      VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                      materialDesign:ColorZoneAssist.Mode="Custom"
                                      materialDesign:HintAssist.Hint="{Lag:Localize cardLabelScope}"
                                      Style="{StaticResource MaterialDesignFilledComboBox}"
                                      TextOptions.TextFormattingMode="Display"
                                      TextOptions.TextRenderingMode="ClearType"
                                      materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                      materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                                <ComboBoxItem Content="{Lag:Localize SelectCards}" />
                                <ComboBoxItem Content="{Lag:Localize FoundCards}" />
                                <ComboBoxItem Content="{Lag:Localize AllCards}" />
                            </ComboBox>

                            <Button Grid.Column="2" Height="auto" MinHeight="35" Padding="10,5,10,5"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Content="{Lag:Localize Replace}"
                                    Command="{Binding ReplaceDescCommand}"
                                    FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Style="{StaticResource ButtonDanger}" />
                        </Grid>
                    </Grid>
                    
                    <TabItem.Header>
                        <StackPanel Width="auto" Height="auto" Background="{x:Null}"
                                    ToolTip="{Lag:Localize toolReplaceText}" >
                            <materialDesign:PackIcon Width="24" Height="24" Kind="ReceiptTextEditOutline" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="12"
                                       Text="{Lag:Localize replaceText}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                
                <TabItem HorizontalAlignment="Center" Padding="0" Margin="0"
                         ToolTip="{Lag:Localize toolReplaceField}">
                    <Grid Margin="10,10,10,5" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="25" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Height="43"
                                     Padding="10,13,3,0" BorderThickness="0.7" IsReadOnly="True"
                                     Text="{Binding ReplaceFieldFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Behaviors:FileDropBehavior.Enable="True"
                                     Behaviors:PasteSanitizerBehavior.Enable="True"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                     materialDesign:HintAssist.Hint="{Lag:Localize ReplaceFieldFilePath}"
                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                     TextOptions.TextFormattingMode="Display"
                                     TextOptions.TextRenderingMode="ClearType"
                                     materialDesign:TextFieldAssist.HasClearButton="False"
                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                     materialDesign:ThemeAssist.Theme="Dark" />

                            <Button Grid.Column="0" Margin="0,0,5,0" Padding="0" Width="25" Height="25"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                    ToolTip="{Lag:Localize Browse}" Command="{Binding BrowseReplaceFieldFilePathCommand}" >
                                <Button.Content>
                                    <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25"
                                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                </Button.Content>
                            </Button>

                            <Button Grid.Column="2" Height="auto" MinHeight="35" Padding="10,5,10,5"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Content="{Lag:Localize Replace}" Command="{Binding ReplaceFieldCommand}"
                                    FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Style="{StaticResource ButtonDanger}" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="5" BorderThickness="1" Padding="0,3,0,3"
                                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                                <ScrollViewer Height="auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                                    <Grid>
                                        <ItemsControl ItemsSource="{Binding ReplaceFieldLeftToggles}" ItemTemplate="{StaticResource ReplaceFieldToggleTemplate}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Column="2" CornerRadius="5" BorderThickness="1" Padding="0,3,0,3"
                                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                                <ScrollViewer Height="auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                                    <Grid>
                                        <ItemsControl ItemsSource="{Binding ReplaceFieldRightToggles}" ItemTemplate="{StaticResource ReplaceFieldToggleTemplate}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="4" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0" Panel.ZIndex="2"
                                          IsChecked="{Binding IsAddNew}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" 
                                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                          Width="40" Height="22" Margin="10,0,10,0" >
                                <ToggleButton.Content>
                                    <materialDesign:PackIcon Kind="CloseThick" Foreground="Red" Width="20" Height="20" Padding="0" Margin="0" />
                                </ToggleButton.Content>
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <materialDesign:PackIcon Kind="CheckOutline" Width="20" Height="20" />
                                </materialDesign:ToggleButtonAssist.OnContent>
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchSecondaryToggleButton}" >
                                        <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOffBackground" Value="Red" />
                                        <Setter Property="Background" Value="Red" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOnBackground" Value="Blue" />
                                                <Setter Property="Background" Value="Green" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <Viewbox Grid.Column="1" HorizontalAlignment="Left"
                                     Margin="0,0,0,0" Stretch="Uniform" StretchDirection="Both" >
                                <TextBlock Text="{Lag:Localize addNewCard}"
                                           Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MaterialDesignTextBlock}" />
                            </Viewbox>
                        </Grid>
                    </Grid>
                    <TabItem.Header>
                        <StackPanel Width="auto" Height="auto" Background="{x:Null}" >
                            <materialDesign:PackIcon Width="24" Height="24" Kind="FileReplaceOutline" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="12"
                                       Text="{Lag:Localize replaceField}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

                <TabItem HorizontalAlignment="Center" Padding="0" Margin="0"
                         ToolTip="{Lag:Localize toolImportData}" >
                    <Grid Margin="10,10,10,5" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="25" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Height="43"
                                     Padding="10,13,3,0" BorderThickness="0.7" IsReadOnly="True"
                                     Text="{Binding ImportDataFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Behaviors:FileDropBehavior.Enable="True"
                                     Behaviors:PasteSanitizerBehavior.Enable="True"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                     materialDesign:HintAssist.Hint="{Lag:Localize ImportDataFilePath}"
                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                     TextOptions.TextFormattingMode="Display"
                                     TextOptions.TextRenderingMode="ClearType"
                                     materialDesign:TextFieldAssist.HasClearButton="False"
                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                     materialDesign:ThemeAssist.Theme="Dark" />
                            
                            <Button Grid.Column="0" Margin="0,0,5,0" Padding="0" Width="25" Height="25"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                    ToolTip="{Lag:Localize Browse}" Command="{Binding BrowseImportDataFilePathCommand}" >
                                <Button.Content>
                                    <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25"
                                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                </Button.Content>
                            </Button>

                            <Button Grid.Column="2" Height="auto" MinHeight="35" Padding="10,5,10,5"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    Content="{Lag:Localize Import}" Command="{Binding ImportDataCommand}"
                                    FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Style="{StaticResource ButtonDanger}" />
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Lag:Localize SelectDataField}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />

                        <Grid Grid.Row="3" Margin="0" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="5" BorderThickness="1" Padding="0,3,0,3"
                                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                                <ScrollViewer Height="auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                                    <Grid>
                                        <ItemsControl ItemsSource="{Binding ImportDataLeftToggles}" ItemTemplate="{StaticResource ImportDataToggleTemplate}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Column="2" CornerRadius="5" BorderThickness="1" Padding="0,3,0,3"
                                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                                <ScrollViewer Height="auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                                    <Grid>
                                        <ItemsControl ItemsSource="{Binding ImportDataRightToggles}" ItemTemplate="{StaticResource ImportDataToggleTemplate}"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <TabItem.Header>
                        <StackPanel Width="auto" Height="auto" Background="{x:Null}" >
                            <materialDesign:PackIcon Width="24" Height="24" Kind="DatabaseImportOutline" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="12"
                                       Text="{Lag:Localize importData}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>

            </TabControl>
        </Grid>
    </materialDesign:Card>
</Window>
