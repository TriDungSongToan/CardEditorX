<Window x:Class="CardEditor.CreateImage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:Lag="clr-namespace:CardEditor.Localization"
        xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
        xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
        xmlns:ImageGen="clr-namespace:CardEditor.ImageGene"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="Transparent"
        Foreground="{Binding Foreground}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        mc:Ignorable="d"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Title="Create Image">

    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderThickness="0.5" Padding="6" CornerRadius="4">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              TextElement.Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                              TextElement.FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <materialDesign:Card UniformCornerRadius="5" Width="auto" Padding="0" BorderThickness="1,0,1,1"
                         BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         d:FlowDirection="LeftToRight" >
        <Grid Width="550" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border x:Name="blCreateImage" Grid.Row="0" BorderThickness="0,0,0,0"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    Height="auto" MinHeight="35" Padding="5,3,5,3" CornerRadius="5" Margin="0,0,0,0"
                    MouseLeftButtonDown="blCreateImage_MouseLeftButtonDown" >
                <StackPanel Orientation="Horizontal" >
                    <Image x:Name="imgHeader" Width="25" Height="25"
                           Source="pack://application:,,,/Images/Menu/Win/Imageditor.ico"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock x:Name="txtHeader" Margin="10,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                               Text="{Lag:Localize CreateImage}"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="10,10,10,0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="3" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="3" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="3" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtArtWorkFolder" Grid.Column="0" Height="auto" MinHeight="47"
                             Margin="0" Padding="10,10,3,2" BorderThickness="0.7"
                             Text="{Binding imageSetting.ArtworkFolder}"
                             TextAlignment="{Binding TextAlignmentC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                             materialDesign:HintAssist.Hint="{Lag:Localize ArtWorkFolder}"
                             Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                             Behaviors:FileDropBehavior.Enable="True"
                             Behaviors:PasteSanitizerBehavior.Enable="True"
                             TextOptions.TextFormattingMode="Display"
                             TextOptions.TextRenderingMode="ClearType"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                             materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                             materialDesign:ThemeAssist.Theme="Dark" />
                    <Button x:Name="btnBrowseArtWorkPath" Grid.Column="0" Margin="0,0,5,0" Padding="0" Width="25" Height="25"
                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                            ToolTip="{Lag:Localize Browse}" Command="{Binding BrowseArtWorkFolder}" >
                        <Button.Content>
                            <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25"
                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </Button.Content>
                    </Button>

                </Grid>

                <Grid Grid.Row="2" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtOutPutFolder" Grid.Column="0" Height="auto" MinHeight="47"
                             Margin="0" Padding="10,10,3,2" BorderThickness="0.7"
                             Text="{Binding imageSetting.OutPutFolder}"
                             TextAlignment="{Binding TextAlignmentC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                             materialDesign:HintAssist.Hint="{Lag:Localize OutPutFolder}"
                             Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                             Behaviors:FileDropBehavior.Enable="True"
                             Behaviors:PasteSanitizerBehavior.Enable="True"
                             TextOptions.TextFormattingMode="Display"
                             TextOptions.TextRenderingMode="ClearType"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                             materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                             materialDesign:ThemeAssist.Theme="Dark" />
                    <Button x:Name="btnBrowseOutPutPath" Grid.Column="0" Margin="0,0,5,0" Padding="0" Width="25" Height="25"
                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                            ToolTip="{Lag:Localize Browse}" Command="{Binding BrowseOutPutFolder}" >
                        <Button.Content>
                            <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25"
                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </Button.Content>
                    </Button>
                    <ComboBox x:Name="cmbOutPut" Grid.Column="2" Height="auto" MinHeight="43" Width="110"
                              BorderThickness="0.7" Padding="10,18,12,5" IsEditable="False"
                              BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              ItemsSource="{Binding imageSettingSource.OutPutImages}"
                              SelectedItem="{Binding imageSetting.SelectedOutPut}"
                              VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                              VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                              materialDesign:ColorZoneAssist.Mode="Custom"
                              materialDesign:HintAssist.Hint="OutPut"
                              Style="{StaticResource MaterialDesignFilledComboBox}"
                              TextOptions.TextFormattingMode="Display"
                              TextOptions.TextRenderingMode="ClearType"
                              materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                              materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" />
                </Grid>

                <Grid Grid.Row="4" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="chkadvanfind" Grid.Column="0"
                              Content="{Lag:Localize advanFil}"
                              Width="110" MinHeight="40" IsChecked="False" Margin="0" Padding="0"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0.7"
                              BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              Checked="chkadvanfind_Checked" Unchecked="chkadvanfind_Unchecked"
                              Style="{StaticResource MaterialDesignFilterChipSecondaryOutlineCheckBox}" />

                    <ComboBox x:Name="cmbScope" Grid.Column="1" Height="45" IsEditable="False"
                                  Margin="5,0,5,0" Padding="10,16,8,0" BorderThickness="0.7"
                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                  materialDesign:HintAssist.Hint="{Lag:Localize cardLabelScope}"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  SelectedIndex="{Binding Scope}"
                                  TextOptions.TextFormattingMode="Display"
                                  TextOptions.TextRenderingMode="ClearType"
                                  materialDesign:TextFieldAssist.HasClearButton="True"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                        <ComboBoxItem Content="{Lag:Localize SelectCards}" />
                        <ComboBoxItem Content="{Lag:Localize FoundCards}" />
                        <ComboBoxItem Content="{Lag:Localize AllCards}" />
                    </ComboBox>

                    <Grid Grid.Column="2" Margin="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" >
                            <Button x:Name="btnCreate" Content="{Lag:Localize CreateImage}" MinHeight="40" Padding="10,5,10,5"
                                    FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="5" 
                                    Style="{StaticResource ButtonDanger}" 
                                    Command="{Binding CreateImageCommand}" />
                            <Button x:Name="btnCreateTest" Content="{Lag:Localize CreateImage}" MinHeight="40" Padding="10,5,10,5"
                                    FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="5" Visibility="Collapsed"
                                    Style="{StaticResource ButtonDanger}" 
                                    Click="btnCreateTest_Click" />
                        </Grid>

                        <Grid Grid.Column="2" >
                            <Button x:Name="btnSave" Content="{Lag:Localize Save}" MinHeight="40" Padding="10,5,10,5"
                                    FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Style="{StaticResource ButtonSuccess}"
                                    Command="{Binding SaveCommand}" />
                        </Grid>

                        <Grid Grid.Column="4" >
                            <Button x:Name="btnCancel" Content="{Lag:Localize cancel}" MinHeight="40" Padding="10,5,10,5"
                                    FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                    materialDesign:ButtonAssist.CornerRadius="5"
                                    Style="{StaticResource ButtonInfo}"
                                    Command="{Binding CacelCommand}" />
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="grAdvancedOption" Grid.Row="6" Margin="0" Visibility="Collapsed" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="cmbFormatName" Grid.Column="0" Width="120" Height="auto"
                                  BorderThickness="0.7" IsEditable="False" Padding="10,18,8,5"
                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  SelectedIndex="{Binding imageSetting.FormatName}"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                  materialDesign:HintAssist.Hint="{Lag:Localize FormatName}"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  TextOptions.TextFormattingMode="Display"
                                  TextOptions.TextRenderingMode="ClearType"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                            <ComboBoxItem Content="OCG" />
                            <ComboBoxItem Content="TCG" />
                        </ComboBox>

                        <ComboBox x:Name="cmbSeries" Grid.Column="2" Width="120" Height="auto" MinHeight="35" IsEditable="False"
                                  BorderThickness="0.7" Padding="10,18,10,5"
                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  ItemsSource="{Binding Series, Source={x:Static ViewModels:GeneraImageViewModel.Instance}}"
                                  SelectedIndex="{Binding imageSetting.Series}"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                  materialDesign:HintAssist.Hint="{Lag:Localize Series}"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  TextOptions.TextFormattingMode="Display"
                                  TextOptions.TextRenderingMode="ClearType"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" />

                        <ComboBox x:Name="cmbRare" Grid.Column="4" Width="115" Height="auto" MinHeight="35" IsEditable="False"
                                  BorderThickness="0.7" Padding="10,18,10,5"
                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  SelectedIndex="{Binding imageSetting.Rare}"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                  materialDesign:HintAssist.Hint="{Lag:Localize cardrare}"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  TextOptions.TextFormattingMode="Display"
                                  TextOptions.TextRenderingMode="ClearType"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                            <ComboBoxItem Content="{Lag:Localize Common}" />
                            <ComboBoxItem Content="{Lag:Localize GoldRare}" />
                            <ComboBoxItem Content="{Lag:Localize PlatiumRare}" />
                        </ComboBox>

                        <ComboBox x:Name="cmbSecret" Grid.Column="6" Height="auto" MinHeight="35" IsEditable="False"
                                  BorderThickness="0.7" Padding="10,18,10,5"
                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  SelectedIndex="{Binding imageSetting.Secret}"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                  materialDesign:HintAssist.Hint="{Lag:Localize Secret}"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  TextOptions.TextFormattingMode="Display"
                                  TextOptions.TextRenderingMode="ClearType"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                            <ComboBoxItem Content="{Lag:Localize Common}" />
                            <ComboBoxItem Content="Secret Rare" />
                            <ComboBoxItem Content="Extra Secret" />
                            <!--<ComboBoxItem Content="Prismatic Secret" />-->
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="cmbFormatEffect" Grid.Column="0" Width="120" Height="auto"
                                  BorderThickness="0.7" IsEditable="False" Padding="10,18,8,5"
                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  SelectedIndex="{Binding imageSetting.FormatEffect}"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                  materialDesign:HintAssist.Hint="{Lag:Localize FormatEffect}"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  TextOptions.TextFormattingMode="Display"
                                  TextOptions.TextRenderingMode="ClearType"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                            <ComboBoxItem Content="OCG" />
                            <ComboBoxItem Content="TCG" />
                        </ComboBox>

                        <ComboBox x:Name="cmbImageFormat" Grid.Column="2" Width="120" Height="auto" MinHeight="35" IsEditable="False"
                                  BorderThickness="0.7" Padding="10,18,10,5"
                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  ItemsSource="{Binding imageSettingSource.ImageFormats}"
                                  SelectedItem="{Binding imageSetting.OutPutFormat}"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                  materialDesign:HintAssist.Hint="Image Format"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  TextOptions.TextFormattingMode="Display"
                                  TextOptions.TextRenderingMode="ClearType"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" />
                        
                        <ComboBox x:Name="cmbFoild" Grid.Column="4" Height="auto" MinHeight="35" IsEditable="False"
                                  BorderThickness="0.7" Padding="10,18,10,5"
                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  ItemsSource="{Binding imageSettingSource.FoildLists}"
                                  SelectedItem="{Binding imageSetting.Foild}"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                  materialDesign:HintAssist.Hint="{Lag:Localize Foild}"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  TextOptions.TextFormattingMode="Display"
                                  TextOptions.TextRenderingMode="ClearType"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" />

                        <ComboBox x:Name="cmbBackgroundArt" Grid.Column="6" Height="auto" MinHeight="35" IsEditable="False"
                                  BorderThickness="0.7" Padding="10,18,10,5"
                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  ItemsSource="{Binding imageSettingSource.BackgroundArts}"
                                  SelectedItem="{Binding imageSetting.BackgroundArt}"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                  materialDesign:HintAssist.Hint="{Lag:Localize BackgroundArt}"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  TextOptions.TextFormattingMode="Display"
                                  TextOptions.TextRenderingMode="ClearType"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" />
                        
                    </Grid>

                    <Border Grid.Row="4" Height="40" BorderThickness="0.5" CornerRadius="5"
                            BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>

                                <Viewbox Grid.Column="0" HorizontalAlignment="Center"
                                         Margin="0,0,0,0" Stretch="None" StretchDirection="Both" >
                                    <TextBlock Text="{Lag:Localize FullArt}"
                                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MaterialDesignTextBlock}" />
                                </Viewbox>
                                <ToggleButton x:Name="tbtnFullArt" Grid.Column="1" Panel.ZIndex="2"
                                              IsChecked="{Binding imageSetting.FullArt}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center" 
                                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                              Width="55" Height="28" Margin="0,0,10,0" >
                                    <ToggleButton.Content>
                                        <materialDesign:PackIcon Kind="CloseThick" Foreground="Red" Width="auto" Height="24" Padding="0" Margin="0" />
                                    </ToggleButton.Content>
                                    <materialDesign:ToggleButtonAssist.OnContent>
                                        <materialDesign:PackIcon Kind="CheckOutline" Width="20" Height="20" />
                                    </materialDesign:ToggleButtonAssist.OnContent>
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchSecondaryToggleButton}" >
                                            <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOffBackground" Value="Red" />
                                            <Setter Property="Background" Value="Red" />
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOnBackground" Value="Blue" />
                                                    <Setter Property="Background" Value="Green" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </Grid>

                            <Grid Grid.Column="1" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>

                                <Viewbox Grid.Column="0" HorizontalAlignment="Center"
                                         Margin="0,0,0,0" Stretch="None" StretchDirection="Both" >
                                    <TextBlock Text="{Lag:Localize IncludeRare}"
                                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MaterialDesignTextBlock}" />
                                </Viewbox>
                                <ToggleButton x:Name="tbtnIncludeStamp" Grid.Column="1" Panel.ZIndex="2"
                                              IsChecked="{Binding imageSetting.IncludeRare}"
                                              VerticalAlignment="Center" HorizontalAlignment="Center" 
                                              VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                              Width="55" Height="28" Margin="0,0,30,0" >
                                    <ToggleButton.Content>
                                        <materialDesign:PackIcon Kind="CloseThick" Foreground="Red" Width="auto" Height="24" Padding="0" Margin="0" />
                                    </ToggleButton.Content>
                                    <materialDesign:ToggleButtonAssist.OnContent>
                                        <materialDesign:PackIcon Kind="CheckOutline" Width="20" Height="20" />
                                    </materialDesign:ToggleButtonAssist.OnContent>
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchSecondaryToggleButton}" >
                                            <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOffBackground" Value="Red" />
                                            <Setter Property="Background" Value="Red" />
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOnBackground" Value="Blue" />
                                                    <Setter Property="Background" Value="Green" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="grProgress" Grid.Row="8" Height="0" Margin="0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="5" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="-15,0,-15,0" >
                            <Image x:Name="imgRunner" Panel.ZIndex="2"
                                   Width="60" Height="60" Margin="0,0,0,-8"
                                   gif:ImageBehavior.AnimatedSource="pack://application:,,,/Images/ImageGene.gif"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   RenderTransformOrigin="0.0,0.5">
                                <Image.RenderTransform>
                                    <TranslateTransform x:Name="runnerTransform" />
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                        <Grid Grid.Row="1" Margin="10,0,3,0" >
                            <ProgressBar x:Name="progressBar" Minimum="0" Maximum="100" Height="12" Value="0"
                                     Panel.ZIndex="1" Visibility="Visible" >
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border CornerRadius="5" >
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FF5EC8FF" Offset="0.0" />
                                                        <GradientStop Color="#FFBDBDBD" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border x:Name="PART_Track" Background="Transparent" CornerRadius="10">
                                                <Border x:Name="PART_Indicator" CornerRadius="10"
                                                    HorizontalAlignment="Left" >
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#90CAF9" Offset="0.0" />
                                                            <GradientStop Color="#1565C0" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="1" >
                        <Button x:Name="btnCancelCreateImg" Width="30" Height="30"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Cursor="Hand" ForceCursor="True" ToolTip="{Lag:Localize cancel}"
                                Margin="0,0,3,8" Padding="0" BorderBrush="Transparent" BorderThickness="0"
                                Background="Transparent"
                                Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                Click="btnCancelCreateImg_Click" >
                            <Button.Content>
                                <materialDesign:PackIcon Kind="Close" Width="30" Height="30" />
                            </Button.Content>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </materialDesign:Card>
</Window>
