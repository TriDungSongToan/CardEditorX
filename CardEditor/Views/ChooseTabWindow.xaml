<Window x:Class="CardEditor.ChooseTabWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
        xmlns:Lag="clr-namespace:CardEditor.Localization"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="Transparent"
        Foreground="{Binding Foreground}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        mc:Ignorable="d"
        AllowsTransparency="True"
        ResizeMode="NoResize" 
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ShowInTaskbar="False"
        Title="Select Tab" Height="auto" Width="auto">

    <materialDesign:Card UniformCornerRadius="5" BorderThickness="2" Width="auto" d:FlowDirection="LeftToRight"
                         FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
        <Grid Margin="5" >
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Width="auto" Height="25" Margin="0" Padding="0,0,5,0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    BorderThickness="1" Cursor="Hand"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    Style="{StaticResource ButtonSuccess}"
                    Command="{Binding ImageEditorCommand}" >
                <Button.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="20" Height="20" Margin="0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="pack://application:,,,/Images/Menu/Win/Imageditor.ico"  />
                        <TextBlock Grid.Column="1" Padding="0" Margin="3,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{Lag:Localize ImageEdit}" FontSize="16"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                    </Grid>
                </Button.Content>
            </Button>

            <Button Grid.Row="2" Width="auto" Height="25" Margin="0" Padding="0,0,5,0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    BorderThickness="1" Cursor="Hand"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    Style="{StaticResource ButtonSuccess}"
                    Command="{Binding DataEditorCommand}" >
                <Button.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="20" Height="20" Margin="0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="pack://application:,,,/Images/Menu/Win/Dataeditor.ico"  />
                        <TextBlock Grid.Column="1" Padding="0" Margin="3,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{Lag:Localize DataEdit}" FontSize="16"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                    </Grid>
                </Button.Content>
            </Button>

            <Button Grid.Row="4" Width="auto" Height="25" Margin="0" Padding="0,0,5,0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    BorderThickness="1" Cursor="Hand"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    Style="{StaticResource ButtonSuccess}"
                    Command="{Binding OmegaDataEditorCommand}" >
                <Button.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="20" Height="20" Margin="0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="pack://application:,,,/Images/Menu/Win/Dataeditor.ico"  />
                        <TextBlock Grid.Column="1" Padding="0" Margin="3,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{Lag:Localize DataEdit}" FontSize="16"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        <TextBlock Grid.Column="2" Padding="0" Margin="5,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="Ω" FontSize="16"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                    </Grid>
                </Button.Content>
            </Button>

            <Button Grid.Row="6" Width="auto" Height="25" Margin="0" Padding="0,0,5,0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    BorderThickness="1" Cursor="Hand"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    Style="{StaticResource ButtonSuccess}"
                    Command="{Binding DeckEditorCommand}" >
                <Button.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="20" Height="20" Margin="0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="pack://application:,,,/Images/Menu/Win/Deckeditor.ico"  />
                        <TextBlock Grid.Column="1" Padding="0" Margin="3,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{Lag:Localize DeckEdit}" FontSize="16"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                    </Grid>
                </Button.Content>
            </Button>

            <Button Grid.Row="8" Width="auto" Height="25" Margin="0" Padding="0,0,5,0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    BorderThickness="1" Cursor="Hand"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    Style="{StaticResource ButtonSuccess}"
                    Command="{Binding CodeEditorCommand}" >
                <Button.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="20" Height="20" Margin="0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="pack://application:,,,/Images/Menu/Win/Codeditor.ico"  />
                        <TextBlock Grid.Column="1" Padding="0" Margin="3,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{Lag:Localize CodeEdit}" FontSize="16"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                    </Grid>
                </Button.Content>
            </Button>

            <Button Grid.Row="10" Width="auto" Height="25" Margin="0" Padding="0,0,5,0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    BorderThickness="1" Cursor="Hand"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    Style="{StaticResource ButtonSuccess}"
                    Command="{Binding BanListEditorCommand}" >
                <Button.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="20" Height="20" Margin="0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="pack://application:,,,/Images/Menu/Win/Banlisteditor.ico"  />
                        <TextBlock Grid.Column="1" Padding="0" Margin="3,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Text="{Lag:Localize BanListEdit}" FontSize="16"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                    </Grid>
                </Button.Content>
            </Button>

        </Grid>
    </materialDesign:Card>
</Window>
