<Window x:Class="CardEditor.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
        xmlns:Lag="clr-namespace:CardEditor.Localization"   
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="Transparent"
        Foreground="{Binding Foreground}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        mc:Ignorable="d"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
        Title="About" Height="450" Width="400">

    <materialDesign:Card UniformCornerRadius="5"
                         FlowDirection="{Binding FlowDirectionC}" d:FlowDirection="LeftToRight"
                         BorderBrush="{Binding ThemeColor}"
                         Background="{Binding Background}"
                         BorderThickness="1,0,1,1" >
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="blsetting" Grid.Row="0" CornerRadius="5"
                    Background="{Binding ThemeColor}" BorderThickness="0,0,0,0" Padding="5,5,5,5"
                    MouseLeftButtonDown="blsetting_MouseLeftButtonDown" >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Lag:Localize About}" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding Foreground}" FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Border Width="300" Height="auto" BorderBrush="{Binding ThemeColor}" BorderThickness="1"
                        Padding="5" Margin="3" CornerRadius="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                    <Grid Grid.Row="0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" HorizontalAlignment="Center" Height="150" Width="150" Margin="0,0,0,0" >
                            <Image x:Name="imgLogo" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0" >
                            <TextBlock Text="CardEditorX" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontFamily="{Binding FontFamily}"
                                       FontSize="30" Foreground="{Binding Foreground}" />
                        </Grid>
                        
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" >
                            <TextBlock Text="{Lag:Localize Version}" Margin="0,0,10,0"
                                       Background="{Binding Background}" Foreground="{Binding Foreground}"
                                       FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" />
                            <TextBlock Text="0.0" Margin="0,0,10,0"
                                        Background="{Binding Background}" Foreground="{Binding Foreground}"
                                        FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" />
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,15,0,5" >
                            <TextBlock Text="{Lag:Localize Creator}" HorizontalAlignment="Center"
                                       Background="{Binding Background}" Foreground="{Binding Foreground}"
                                       FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" />
                        </Grid>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="5,0,5,0" HorizontalAlignment="Center" >
                            <Border Width="25" Height="25" CornerRadius="5" Cursor="Hand"
                                    ClipToBounds="True" Margin="0" Padding="0"
                                    MouseLeftButtonUp="Border_MouseLeftButtonUp">
                                <Border.Background>
                                    <ImageBrush x:Name="Creator" Stretch="Fill" />
                                </Border.Background>
                            </Border>
                            <TextBlock Text="Trí Dũng Song Toàn" Margin="20,0,20,0" VerticalAlignment="Center"
                                       Background="{Binding Background}" Foreground="{Binding Foreground}"
                                       FontFamily="{Binding FontFamily}" FontSize="16" />
                            <Button x:Name="btnGithub" Background="Transparent" ToolTip="{Lag:Localize toolGitHub}"
                                    Width="25" Height="25" Padding="0" Margin="0"
                                    BorderThickness="0" Click="btnGithub_Click" >
                                <materialDesign:PackIcon Width="30" Height="30" Kind="Github" Foreground="{Binding Foreground}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,2,0,7" >
                    <Button x:Name="btnok" Grid.Column="0" Content="{Lag:Localize ok}" Width="auto" Height="32"
                            BorderThickness="0" BorderBrush="{Binding ThemeColor}"
                            FontFamily="{Binding FontFamily}" FontSize="{Binding FontSize}" Padding="15,5,15,5"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Style="{StaticResource ButtonPrimary}"
                            Click="btnok_Click" />
                </Grid>
                
            </Grid>
        </Grid>
    </materialDesign:Card>
</Window>
