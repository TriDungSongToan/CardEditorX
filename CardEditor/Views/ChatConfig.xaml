<Window x:Class="CardEditor.ChatConfig"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
        xmlns:Lag="clr-namespace:CardEditor.Localization"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="Transparent"
        Foreground="{Binding Foreground}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        mc:Ignorable="d"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        DataContext="{Binding Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
        Title="ChatConfig" Height="auto" Width="auto">

    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderThickness="0.5" Padding="6" CornerRadius="4">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              TextElement.Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                              TextElement.FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <materialDesign:Card UniformCornerRadius="5" BorderThickness="1,0,1,1" Width="400" d:FlowDirection="LeftToRight"
                         FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border x:Name="blChatSetting" Grid.Row="0"
                    Background="{Binding ThemeColor}" BorderThickness="0,0,0,0"
                    Padding="5,3,5,3" CornerRadius="5" Margin="0,0,0,0"
                    MouseLeftButtonDown="blChatSetting_MouseLeftButtonDown" >
                <StackPanel Orientation="Horizontal" >
                    <Image x:Name="imgHeader" Width="25" Height="25"
                           Source="pack://application:,,,/Images/Setting/Setting.ico"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock x:Name="txtHeader" Margin="10,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Stretch"
                               Text="{Lag:Localize Setting}"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="10,10,10,10" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" >
                    <TextBox x:Name="txtUserName" Height="47" Padding="10,10,3,2" BorderThickness="0.7"
                             BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                             materialDesign:HintAssist.Hint="{Lag:Localize UserName}"
                             Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                             TextOptions.TextFormattingMode="Display"
                             TextOptions.TextRenderingMode="ClearType"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                             materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                             materialDesign:ThemeAssist.Theme="Dark" />
                </Grid>

                <Grid Grid.Row="2" >
                    <TextBox x:Name="txtApiEndpoint" Height="47" Padding="10,10,3,2" BorderThickness="0.7"   
                             BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                             materialDesign:HintAssist.Hint="{Lag:Localize ApiEndpoint}"
                             Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                             TextOptions.TextFormattingMode="Display"
                             TextOptions.TextRenderingMode="ClearType"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                             materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                             materialDesign:ThemeAssist.Theme="Dark" />
                </Grid>

                <Grid Grid.Row="4" >
                    <TextBox x:Name="txtApiKey" Height="47" Padding="10,10,3,2" BorderThickness="0.7"
                             BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                             materialDesign:HintAssist.Hint="{Lag:Localize ApiKey}"
                             Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                             TextOptions.TextFormattingMode="Display"
                             TextOptions.TextRenderingMode="ClearType"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                             materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                             materialDesign:ThemeAssist.Theme="Dark" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="10,0,10,10" HorizontalAlignment="Center" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0" >
                    <Button x:Name="btnSave" Content="{Lag:Localize Save}" Height="35"
                            FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                            FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                            Padding="10,5,10,5"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Style="{StaticResource ButtonSuccess}"
                            Click="btnSave_Click" />
                </Grid>

                <Grid Grid.Column="2" >
                    <Button x:Name="btnCancel" Content="{Lag:Localize cancel}" Height="35"
                            FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                            FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                            Padding="10,5,10,5"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Style="{StaticResource ButtonInfo}"
                            Click="btnCancel_Click" />
                </Grid>
            </Grid>
        </Grid>
    </materialDesign:Card>
</Window>
