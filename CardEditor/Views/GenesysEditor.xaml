<Window x:Class="CardEditor.GenesysEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        xmlns:viewport="clr-namespace:Han.Wpf.ViewportControl;assembly=Han.Wpf.ViewportControl"
        xmlns:sdl="clr-namespace:Sdl.MultiSelectComboBox.Themes.Generic;assembly=Sdl.MultiSelectComboBox"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
        xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
        xmlns:Lag="clr-namespace:CardEditor.Localization"
        xmlns:Converter="clr-namespace:CardEditor.Converter"
        xmlns:local="clr-namespace:CardEditor"
        xmlns:Beha="clr-namespace:CardEditor.Behaviors"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="Transparent"
        Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        mc:Ignorable="d"
        AllowsTransparency="True"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=ViewModels:GenesysViewModel}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Title="GenesysEditor" Height="auto" Width="auto">

    <Window.Resources>
        <ResourceDictionary>
            <Converter:IntSafeConverter x:Key="IntSafeConverter" />

            <Style x:Key="CustomDataGridHeaderStyle" TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       Height="20" Margin="0" Padding="0" TextAlignment="Left" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
            <Style x:Key="CenterDataGridCellElementStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="3,2,3,2"/>
                <Setter Property="Padding" Value="2"/>
            </Style>
            <Style x:Key="LeftDataGridCellElementStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="3,2,3,2"/>
                <Setter Property="Padding" Value="2"/>
            </Style>

            <Style x:Key="CellWithBorderStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0.3,0.4,0.3,0.4"/>
                <Setter Property="BorderBrush" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridRow">
                            <Border x:Name="DGR_Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <SelectiveScrollingGrid>
                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </SelectiveScrollingGrid.ColumnDefinitions>
                                    <SelectiveScrollingGrid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </SelectiveScrollingGrid.RowDefinitions>
                                    <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    <DataGridDetailsPresenter Grid.Row="1" Grid.Column="1" Visibility="{TemplateBinding DetailsVisibility}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </SelectiveScrollingGrid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DGR_Border" Property="Background" Value="#FFE0F7FF"/>
                                    <Setter Property="Foreground" Value="Blue" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="DGR_Border" Property="Background" Value="#FF1976D2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="DGR_Border" Property="Background" Value="#FF1976D2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Border" x:Key="BorderStyle">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#33FFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.ControlTemplate.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.DropdownItemTemplate.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.SelectedItemTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:Card UniformCornerRadius="5"
                         BorderThickness="1,0,1,1" BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         d:FlowDirection="LeftToRight" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border x:Name="blGenesysManager" Grid.Row="0" BorderThickness="0"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                    Padding="0" CornerRadius="5" Margin="0,0,0,0"
                    Height="auto" MinHeight="35"
                    MouseLeftButtonDown="blGenesysManager_MouseLeftButtonDown" >
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" >

                        <Button x:Name="btnMinimize"
                                Width="50" Height="35" Margin="0" Padding="0"
                                VerticalAlignment="Stretch" HorizontalAlignment="Center"
                                Background="Transparent" Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderThickness="0" BorderBrush="Transparent"
                                Click="btnMinimize_Click" >
                            <Button.Content>
                                <materialDesign:PackIcon Kind="WindowMinimize" Padding="0" Margin="0"
                                                         Width="20" Height="20"/>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}" >
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="btnClose"
                                Width="50" Height="35" Margin="0" Padding="0"
                                VerticalAlignment="Stretch" HorizontalAlignment="Center"
                                Background="Transparent" Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderThickness="0" BorderBrush="Transparent"
                                Click="btnClose_Click" >
                            <Button.Content>
                                <materialDesign:PackIcon Kind="WindowClose" Padding="0" Margin="0"
                                                         Width="20" Height="20"/>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}" >
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>

                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Grid.Column="0" Margin="10,0,0,0" >
                        <Image x:Name="imgHeader" Width="20" Height="20"
                               Source="pack://application:,,,/Images/Manager/Genesys.ico"
                               VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBlock x:Name="txtHeader" Text="{Lag:Localize GenesysManager}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="3" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Border Margin="0" Grid.Column="0" Padding="0" BorderThickness="1" Height="468"
                        Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                        BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                        Panel.ZIndex="0" >
                    <DataGrid x:Name="datagrGenesysCard" BorderThickness="1" Margin="0" Padding="0"
                              Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                              CanUserDeleteRows="False" CanUserResizeColumns="True" CanUserSortColumns="False"
                              CanUserAddRows="False"
                              CanUserReorderColumns="True" CanUserResizeRows="True"
                              ItemsSource="{Binding GenesysCardsView, Mode=OneWay}"
                              SelectedItem="{Binding SelectedGenesysCard, Mode=TwoWay}"
                              Beha:MultiSelectBehavior.SelectedItems="{Binding SelectedGenesysCards, Mode=TwoWay}"
                              AutoGenerateColumns="False" HeadersVisibility="Column" 
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              EnableRowVirtualization="True"       
                              EnableColumnVirtualization="True"      
                              VirtualizingPanel.IsVirtualizing="True" 
                              VirtualizingPanel.VirtualizationMode="Recycling"       
                              VirtualizingPanel.IsContainerVirtualizable="True"
                              VirtualizingPanel.ScrollUnit="Pixel">
                        <DataGrid.Columns>
                            <materialDesign:DataGridTextColumn Header="{Lag:Localize dataGridID}" Binding="{Binding Id}"
                                                               Width="110" MinWidth="90" MaxWidth="120"
                                                               EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"
                                                               HeaderStyle="{StaticResource CustomDataGridHeaderStyle}"
                                                               ElementStyle="{StaticResource CenterDataGridCellElementStyle}"
                                                               CellStyle="{StaticResource CellWithBorderStyle}" />
                            <materialDesign:DataGridTextColumn Header="{Lag:Localize cardName}" Binding="{Binding Name}"
                                                               Width="260" MinWidth="150" MaxWidth="300"
                                                               EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"
                                                               HeaderStyle="{StaticResource CustomDataGridHeaderStyle}"
                                                               ElementStyle="{StaticResource CenterDataGridCellElementStyle}"
                                                               CellStyle="{StaticResource CellWithBorderStyle}" />
                            <materialDesign:DataGridTextColumn Header="{Lag:Localize genesysPoint}" Binding="{Binding GPoints}"
                                                               Width="70"
                                                               EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"
                                                               HeaderStyle="{StaticResource CustomDataGridHeaderStyle}"
                                                               ElementStyle="{StaticResource CenterDataGridCellElementStyle}"
                                                               CellStyle="{StaticResource CellWithBorderStyle}" />
                        </DataGrid.Columns>
                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar">
                                <Setter Property="Background" Value="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                <Setter Property="Opacity" Value="0.5" />
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </Border>

                <Grid Grid.Column="2" Width="375" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <TextBox x:Name="txtCardName" Height="48" Padding="3,10,3,2" Margin="0"
                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                 VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"
                                 VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0.7"
                                 TextAlignment="{Binding TextAlignmentC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                 materialDesign:HintAssist.Hint="{Lag:Localize cardName}"
                                 Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                 Text="{Binding GenesysCardName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 TextOptions.TextFormattingMode="Display"
                                 TextOptions.TextRenderingMode="ClearType"
                                 materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                                 materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                 materialDesign:ThemeAssist.Theme="Dark" />
                    </Grid>

                    <Grid Grid.Row="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1" >
                            <Button x:Name="btnFilterCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Width="48" Height="48" Margin="0" Padding="0"
                                    FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    Style="{StaticResource ButtonSuccess}" ToolTip="{Lag:Localize toolSearch}" BorderThickness="0"
                                    Command="{Binding FilterCardCommand}">
                                <Button.InputBindings>
                                    <MouseBinding Gesture="RightClick" Command="{Binding UnFilterCardCommand}" />
                                </Button.InputBindings>
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" >
                                        <GradientStop Color="#FF00EDFF" Offset="0.0" />
                                        <GradientStop Color="#FF1B8CFF" Offset="0.3" />
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Content>
                                    <materialDesign:PackIcon Kind="Magnify" Padding="0" Margin="0"
                                                             Width="45" Height="45" />
                                </Button.Content>
                            </Button>
                        </Grid>

                        <Grid Grid.Column="2" >
                            <TextBox x:Name="txtCardId" Height="48" Padding="3,10,3,2" Margin="0"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0.7"
                                     TextAlignment="{Binding TextAlignmentC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     materialDesign:HintAssist.Hint="{Lag:Localize cardID}"
                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                     Text="{Binding GenesysCardID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue='', FallbackValue=''}"
                                     Behaviors:NumericOnlyBehavior.Enable="True"
                                     TextOptions.TextFormattingMode="Display"
                                     TextOptions.TextRenderingMode="ClearType"
                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                     materialDesign:ThemeAssist.Theme="Dark" />
                        </Grid>

                        <Grid Grid.Column="4" >
                            <TextBox x:Name="txtGenesysPoint" Width="120" Height="48" Padding="3,10,3,2" Margin="0"
                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0.7"
                                     TextAlignment="{Binding TextAlignmentC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                     materialDesign:HintAssist.Hint="{Lag:Localize genesysPoint}"
                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                     Text="{Binding GenesysCardPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue='', FallbackValue=''}"
                                     Behaviors:NumericOnlyBehavior.Enable="True"
                                     TextOptions.TextFormattingMode="Display"
                                     TextOptions.TextRenderingMode="ClearType"
                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                     materialDesign:ThemeAssist.Theme="Dark" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="4" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" >
                            <Canvas Grid.Row="1" Width="251" Height="366" >
                                <Border x:Name="blimage" Panel.ZIndex="0" Cursor="Hand" BorderThickness="0.5"
                                                    Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                    Width="251" Height="366" Canvas.Left="0" Canvas.Top="0" AllowDrop="False" >
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <viewport:Viewport x:Name="ViewportImage" Grid.Row="0" ToolTip="{Binding ImagecardTooltip}"
                                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                           MinZoom="1" MaxZoom="10" ZoomSpeed="1.1" SnapsToDevicePixels="True" UseLayoutRounding="True" >
                                            <Image x:Name="imagecard" 
                                                   d:Source="pack://application:,,,/Images/Blank.png"
                                                   Source="{Binding ImageCardSource}"
                                                   Stretch="Uniform" Cursor="Hand" >
                                            </Image>
                                        </viewport:Viewport>

                                        <StackPanel Orientation="Horizontal" >
                                            <Button x:Name="btnViewImage" Grid.Row="0" Width="25" Height="25" Margin="0" Padding="0"
                                                    BorderThickness="0" BorderBrush="Transparent" Background="Transparent"
                                                    Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    ToolTip="{Lag:Localize toolViewImg}"
                                                    Command="{Binding ViewImageCommand}">
                                                <materialDesign:PackIcon Width="25" Height="25" Kind="MagnifyExpand"
                                                                                     RenderTransformOrigin="0.5,0.5" >
                                                    <materialDesign:PackIcon.RenderTransform>
                                                        <ScaleTransform ScaleX="-1" />
                                                    </materialDesign:PackIcon.RenderTransform>
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnViewImage}" Value="True">
                                                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPressed, ElementName=btnViewImage}" Value="True">
                                                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                            <Button x:Name="btnOpenFile" Grid.Row="0" Width="25" Height="25" Margin="0" Padding="0"
                                                    BorderThickness="0" BorderBrush="Transparent" Background="Transparent"
                                                    Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    ToolTip="{Lag:Localize toolOpenLocalImg}"
                                                    Command="{Binding OpenFileCommand}">
                                                <materialDesign:PackIcon Width="25" Height="25" Kind="FileMarker" >
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnOpenFile}" Value="True">
                                                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPressed, ElementName=btnOpenFile}" Value="True">
                                                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                            <Button x:Name="btnOpenKonamDB" Grid.Row="0" Width="25" Height="25" Margin="0" Padding="0"
                                                    BorderThickness="0" BorderBrush="Transparent" Background="Transparent"
                                                    Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    ToolTip="{Lag:Localize toolOpenKonamiDB}"
                                                    Command="{Binding OpenKonamiDBCommand}">
                                                <materialDesign:PackIcon Width="30" Height="30" Kind="DotsHexagon"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnOpenKonamDB}" Value="True">
                                                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPressed, ElementName=btnOpenKonamDB}" Value="True">
                                                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                            <Button x:Name="btnOpenYugipedia" Grid.Row="0" Width="25" Height="25" Margin="0" Padding="0"
                                                    BorderThickness="0" BorderBrush="Transparent" Background="Transparent"
                                                    Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    ToolTip="{Lag:Localize toolOpenYugipedia}"
                                                    Command="{Binding OpenYugipediaCommand}">
                                                <materialDesign:PackIcon Width="26" Height="28" Kind="Wikipedia"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnOpenYugipedia}" Value="True">
                                                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPressed, ElementName=btnOpenYugipedia}" Value="True">
                                                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                            <Button x:Name="btnOpenYGOResources" Grid.Row="0" Width="25" Height="25" Margin="0" Padding="0"
                                                    BorderThickness="0" BorderBrush="Transparent" Background="Transparent"
                                                    Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    ToolTip="{Lag:Localize toolOpenYGOResources}"
                                                    Command="{Binding OpenYGOResourcesCommand}">
                                                <materialDesign:PackIcon Width="28" Height="28" Kind="ViewColumnOutline"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=btnOpenYGOResources}" Value="True">
                                                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPressed, ElementName=btnOpenYGOResources}" Value="True">
                                                                    <Setter Property="Foreground" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Canvas>
                        </Grid>

                        <DockPanel Grid.Column="2" Width="120" >
                            <Grid DockPanel.Dock="Bottom" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,5" >
                                    <Button x:Name="btnResetCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"       
                                                        Margin="0" Padding="0,3,0,3" Height="35"
                                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                        Style="{StaticResource ButtonSuccess}" BorderThickness="0"
                                                        Command="{Binding ResetCardCommand}" >
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#E633FFFF" Offset="0.0" />
                                                <GradientStop Color="#FFCA00DC" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Grid Width="118" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="1" x:Name="iconreset" Kind="Restart" Padding="0"
                                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" Width="28" Height="28" />
                                                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="Both">
                                                    <TextBlock Text="{Lag:Localize tlReset}"
                                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Viewbox>
                                            </Grid>
                                        </Button.Content>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,5" >
                                    <Button x:Name="btnClearCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"        
                                                        Margin="0" Padding="0,3,0,3" Height="35" BorderThickness="0"
                                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                        Style="{StaticResource ButtonSuccess}"
                                                        Command="{Binding ClearCardCommand}" >
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" >
                                                <GradientStop Color="#FFFFCCA0" Offset="0.0" />
                                                <GradientStop Color="#FFFF8921" Offset="0.3"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Grid Width="118" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="1" x:Name="iconclear" Kind="EraserVariant" Padding="0"
                                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" Width="28" Height="28" />
                                                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="Both">
                                                    <TextBlock Text="{Lag:Localize tlClear}"
                                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Viewbox>
                                            </Grid>
                                        </Button.Content>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="2" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Menu materialDesign:MenuAssist.TopLevelMenuItemHeight="35"
                                                      materialDesign:MenuAssist.MenuItemsPresenterMargin="0"
                                                      Grid.Column="0" Height="35" Margin="0" Padding="0"
                                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                      HorizontalAlignment="Left" Style="{DynamicResource MaterialDesignMenu}">
                                        <MenuItem Margin="0" Padding="0" >
                                            <MenuItem.Header>
                                                <Border CornerRadius="3" Width="30" Height="35" Margin="0" Padding="0" >
                                                    <materialDesign:PackIcon Width="30" Height="30" Margin="0" Padding="0" Kind="ChevronDoubleDown"
                                                                                         VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                                         Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FFFFA5AA" Offset="0.0" />
                                                            <GradientStop Color="#FFF01717" Offset="0.4" />

                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </MenuItem.Header>

                                            <MenuItem Header="{Lag:Localize SelectCards}" Margin="0" Padding="10,0,15,0"
                                                                  Command="{Binding DeleteSelectedCardCommand}" >
                                                <MenuItem.Icon>
                                                    <Image Source="pack://application:,,,/Images/Selected.ico" Width="auto" Height="auto" Margin="0" />
                                                </MenuItem.Icon>

                                            </MenuItem>

                                            <MenuItem Header="{Lag:Localize FoundCards}" Margin="0" Padding="10,0,15,0"
                                                                  Command="{Binding DeleteFoundCardCommand}" >
                                                <MenuItem.Icon>
                                                    <Image Source="pack://application:,,,/Images/Found.ico" Width="auto" Height="auto" Margin="0" />
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <MenuItem Header="{Lag:Localize AllCards}" Margin="0" Padding="10,0,15,0"
                                                                  Command="{Binding DeleteAllCardCommand}" >
                                                <MenuItem.Icon>
                                                    <Image Source="pack://application:,,,/Images/All.ico" Width="auto" Height="auto" Margin="0" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#FFFF9CA2" Offset="0.0" />
                                                    <GradientStop Color="#FFE96969" Offset="0.4" />
                                                </LinearGradientBrush>
                                            </MenuItem.Background>
                                        </MenuItem>
                                    </Menu>
                                    <Button x:Name="btnDeleteCard" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        Margin="0" Padding="0,3,0,3" Height="35"
                                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                        Style="{StaticResource ButtonSuccess}" BorderThickness="0"
                                                        Command="{Binding DeleteSingleCardCommand}">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFFFA5AA" Offset="0.0" />
                                                <GradientStop Color="#FFF01717" Offset="0.4" />
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Grid Width="75" >
                                                <Viewbox Stretch="Uniform" StretchDirection="Both">
                                                    <TextBlock Text="{Lag:Localize tlDelete}"
                                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Viewbox>
                                            </Grid>
                                        </Button.Content>
                                    </Button>
                                </Grid>
                            </Grid>

                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,5" >
                                    <Button x:Name="btnLoadCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        Margin="0" Padding="0,3,0,3" Height="35" Panel.ZIndex="1"
                                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                        Style="{StaticResource ButtonSuccess}" BorderThickness="0"
                                                        Command="{Binding LoadCardCommand}" >
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF5DD6FF" Offset="0.0"/>
                                                <GradientStop Color="#FF0090FF" Offset="0.3"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Grid Width="118">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="1" Kind="TableArrowUp" Padding="0"
                                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" Width="28" Height="28" />
                                                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="Both">
                                                    <TextBlock Text="{Lag:Localize load}"
                                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Viewbox>
                                            </Grid>
                                        </Button.Content>
                                    </Button>
                                    <Button x:Name="btnCancelLoadCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        Margin="0" Padding="0,3,0,3" Height="35" Panel.ZIndex="2" Visibility="{Binding CancelLoadGenesysCard}"
                                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                        Style="{StaticResource ButtonSuccess}" BorderThickness="0"
                                                        Command="{Binding CancelLoadCardCommand}" >
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF5DD6FF" Offset="0.0"/>
                                                <GradientStop Color="#FF0090FF" Offset="0.3"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Grid Width="118">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="1" Kind="TableArrowUp" Padding="0"
                                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" Width="28" Height="28" />
                                                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="Both">
                                                    <TextBlock Text="{Lag:Localize cancel}"
                                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Viewbox>
                                            </Grid>
                                        </Button.Content>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,5" >
                                    <Button x:Name="btnBrowseCardDatabase" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        Margin="0" Padding="0,3,0,3" Height="35" BorderThickness="0"
                                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                        Style="{StaticResource ButtonSuccess}" 
                                                        Command="{Binding BrowseDBCommand}" >
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFCBFF51" Offset="0.0"/>
                                                <GradientStop Color="#FF19D400" Offset="0.3"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Grid Width="118">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="1" Kind="OpenInApp" Padding="0"
                                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" Width="28" Height="28" />
                                                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="Both">
                                                    <TextBlock Text="{Lag:Localize Browse}"
                                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Viewbox>
                                            </Grid>
                                        </Button.Content>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,0,0,5" >
                                    <Button x:Name="btnAddCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        Margin="0" Padding="0,3,0,3" Height="35" BorderThickness="0"
                                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                        Style="{StaticResource ButtonSuccess}"
                                                        Command="{Binding AddCardCommand}">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FFAAFF90" Offset="0.0"/>
                                                <GradientStop Color="#FF19D400" Offset="0.3"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Grid Width="118">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="1" Kind="CardPlusOutline" Padding="0"
                                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" Width="28" Height="28" />
                                                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="Both">
                                                    <TextBlock Text="{Lag:Localize tlAdd}"
                                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Viewbox>
                                            </Grid>
                                        </Button.Content>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,0,0,5" >
                                    <Button x:Name="btnModifyCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        Margin="0" Padding="0,3,0,3" Height="35" BorderThickness="0"
                                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                        Style="{StaticResource ButtonSuccess}"
                                                        Command="{Binding ModifyCardCommand}">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF30FFFF" Offset="0.0"/>
                                                <GradientStop Color="#FF008EFF" Offset="0.35"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Grid Width="118">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="1" Kind="TextBoxEditOutline" Padding="0"
                                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" Width="28" Height="28" />
                                                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="Both">
                                                    <TextBlock Text="{Lag:Localize tlModify}"
                                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Viewbox>
                                            </Grid>
                                        </Button.Content>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="4" Margin="0,0,0,5" >
                                    <Button x:Name="btnSortCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"                                       
                                                        Margin="0" Padding="0,3,0,3" Height="35" BorderThickness="0"
                                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"         
                                                        Style="{StaticResource ButtonSuccess}" 
                                                        Command="{Binding SortCardCommand}">
                                        <Button.InputBindings>
                                            <MouseBinding Gesture="RightClick" Command="{Binding UnSortCardCommand}" />
                                        </Button.InputBindings>
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF3E78FF" Offset="0.0" />
                                                <GradientStop Color="#FF009DD1" Offset="0.4"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Grid Width="118">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="1" x:Name="iconSort" Padding="0"
                                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" Width="28" Height="28" />
                                                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="Both">
                                                    <TextBlock Text="{Lag:Localize Sort}"
                                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Viewbox>

                                            </Grid>
                                        </Button.Content>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="5" Margin="0,0,0,5" >
                                    <Button x:Name="btnSaveAllCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"                                       
                                                        Margin="0" Padding="0,3,0,3" Height="35" BorderThickness="0"
                                                        FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                        Style="{StaticResource ButtonSuccess}" 
                                                        Command="{Binding SaveAllCommand}">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF9BFD21" Offset="0.0" />
                                                <GradientStop Color="#FFDDA000" Offset="0.4"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <Button.Content>
                                            <Grid Width="118">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="1" Kind="ContentSaveAlert" Padding="0"
                                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" Width="28" Height="28" />
                                                <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="Both">
                                                    <TextBlock Text="{Lag:Localize SaveCard}"
                                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Viewbox>

                                            </Grid>
                                        </Button.Content>
                                    </Button>
                                </Grid>

                            </Grid>
                        </DockPanel>

                    </Grid>
                </Grid>

                <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Panel.ZIndex="10" >
                    <materialDesign:Snackbar x:Name="NotifiSnackbar" 
                                             HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                        <materialDesign:Snackbar.Background>
                            <SolidColorBrush Color="Gray" Opacity="0.9" />
                        </materialDesign:Snackbar.Background>
                    </materialDesign:Snackbar>
                </Grid>

            </Grid>
        </Grid>
    </materialDesign:Card>
</Window>
