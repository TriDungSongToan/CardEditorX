                        <Button x:Name="btncacels" Grid.Column="6" Width="auto" Height="30"
                                BorderThickness="0" Padding="10,5,10,5"
                                BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="5"
                                Style="{StaticResource ButtonInfo}"
                                Click="btncacels_Click" >
                            <Viewbox Stretch="Uniform" StretchDirection="Both" Width="auto" >
                                <TextBlock Text="{Lag:Localize cancel}" FontSize="15"
                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Viewbox>
                        </Button>
                    </Grid>
                </StackPanel>

            </Grid>
        </Grid>
    </materialDesign:Card>
</Window>
