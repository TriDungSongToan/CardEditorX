<Window x:Class="CardEditor.ConfigEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
        xmlns:dockablz="clr-namespace:Dragablz.Dockablz;assembly=Dragablz"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:Lag="clr-namespace:CardEditor.Localization"
        xmlns:Controls="clr-namespace:CardEditor.Controls"
        xmlns:UserControls="clr-namespace:CardEditor.UserControls"
        xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
        xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
        xmlns:Converter="clr-namespace:CardEditor.Converter"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="Transparent"
        Foreground="{Binding displaySetting.Foreground}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        mc:Ignorable="d"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        d:DataContext="{d:DesignInstance Type=ViewModels:SettingViewModel, IsDesignTimeCreatable=True}"
        Title="Setting" Height="auto" Width="auto" >

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/TwoStateToggleStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/TriStateToggleStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <Converter:AscDescConverter x:Key="AscDescConverter"/>
            <Converter:NullableIntConverter x:Key="NullableIntConverter" />
            <Converter:FontFamilyConverter x:Key="FontFamilyConverter" />
            <Converter:EmptyToCollapsedConverter x:Key="EmptyToCollapsedConverter" />

            <Style x:Key="TwoStateToggleStyleSetting" TargetType="{x:Type Controls:TwoStateToggle}"
                   BasedOn="{StaticResource {x:Type Controls:TwoStateToggle}}" >
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="IsThreeState" Value="False"/>
                <Setter Property="FalseBackgroundBrush" Value="#404842"/>
                <Setter Property="TrueBackgroundBrush" Value="#20C853"/>
                <Setter Property="ThumbBackgroundBrush" Value="#90EFEFEF"/>
                <Setter Property="ThumbBackgroundHoverBrush" Value="#AAEFEFEF"/>
                <Setter Property="TrackCornerRadius" Value="8"/>
                <Setter Property="TrackFalseCornerRadius" Value="8,5,5,8"/>
                <Setter Property="TrackTrueCornerRadius" Value="5,8,8,5"/>
                <Setter Property="FalseCellContentZIndex" Value="3"/>
                <Setter Property="TrueCellContentZIndex" Value="3"/>
                <Setter Property="ThumbZIndex" Value="3"/>
                <Setter Property="ThumbBorderBrush" Value="#8A000000"/>
                <Setter Property="ThumbBorderThickness" Value="0.5"/>
            </Style>

            <Style TargetType="TextBlock" >
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:Card UniformCornerRadius="5" d:FlowDirection="LeftToRight"
                         FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         BorderThickness="1,0,1,1" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border x:Name="blsetting" Height="28" Grid.Row="0" CornerRadius="5"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    BorderThickness="0,0,0,0" Padding="5,3,5,3"
                    MouseLeftButtonDown="blsetting_MouseLeftButtonDown" >
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Images/Setting/setting.ico" Width="auto" Height="23" Margin="0,0,7,0"
                           IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Lag:Localize Config}" FontWeight="Medium" IsHitTestVisible="False"
                               HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Padding="5" Margin="5" BorderThickness="1" CornerRadius="5"
                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" >
                <StackPanel Orientation="Vertical" >
                    
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden"
                                  CanContentScroll="False" Height="400" >
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Width="500" >

                            <Expander HorizontalAlignment="Stretch" Margin="0,0,0,2"
                                      materialDesign:ExpanderAssist.HorizontalHeaderPadding="10,5,0,5"
                                      materialDesign:ExpanderAssist.VerticalHeaderPadding="0"
                                      materialDesign:ExpanderAssist.HeaderBackground="#7F888888"
                                      Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,2,0,0" >
                                    
                                    <Grid Width="500" Margin="0,0,0,2" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="txtUserName" Grid.Column="0" Height="43"
                                                 Padding="10,13,3,0" BorderThickness="0.7"
                                                 Text="{Binding userSetting.UserName, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                 VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                 materialDesign:HintAssist.Hint="{Lag:Localize UserName}"
                                                 Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                                 Behaviors:FileDropBehavior.Enable="True"
                                                 Behaviors:PasteSanitizerBehavior.Enable="True"
                                                 TextOptions.TextFormattingMode="Display"
                                                 TextOptions.TextRenderingMode="ClearType"
                                                 materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                 materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                                 materialDesign:ThemeAssist.Theme="Dark" />

                                        <ComboBox x:Name="cmblanguage" Grid.Column="2" Height="43"
                                                  BorderThickness="0.7" Padding="10,18,12,5" IsEditable="False"
                                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  ItemsSource="{Binding userSettingSource.Languages}"
                                                  SelectedItem="{Binding userSetting.Language}"
                                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                                  materialDesign:HintAssist.Hint="{Lag:Localize Language}"
                                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                                  TextOptions.TextFormattingMode="Display"
                                                  TextOptions.TextRenderingMode="ClearType"
                                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" />
                                    </Grid>

                                    <Grid Width="500" Margin="0,0,0,2" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="txtdatasource" Grid.Column="0" Height="43"
                                                 Padding="10,13,3,0" BorderThickness="0.7"
                                                 Text="{Binding userSetting.DataSource, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                 VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                 materialDesign:HintAssist.Hint="{Lag:Localize DataSource}"
                                                 Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                                 Behaviors:FileDropBehavior.Enable="True"
                                                 Behaviors:PasteSanitizerBehavior.Enable="True"
                                                 TextOptions.TextFormattingMode="Display"
                                                 TextOptions.TextRenderingMode="ClearType"
                                                 materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                 materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                                 materialDesign:ThemeAssist.Theme="Dark" />
                                        
                                        <Button x:Name="btnBrowseDatasource" Grid.Column="0" Margin="0,0,5,0" Padding="0" Width="25" Height="25"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                ToolTip="{Lag:Localize Browse}" Command="{Binding BrowseDataSource}" >
                                            <Button.Content>
                                                <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25"
                                                                         Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                            </Button.Content>
                                        </Button>

                                        <ComboBox x:Name="cmbgame" Grid.Column="2" Height="43"
                                                  BorderThickness="0.7" IsEditable="False" Padding="10,18,12,5"
                                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  ItemsSource="{Binding userSettingSource.Games}"
                                                  SelectedItem="{Binding userSetting.Game}"
                                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                                  materialDesign:HintAssist.Hint="{Lag:Localize Game}"
                                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                                  TextOptions.TextFormattingMode="Display"
                                                  TextOptions.TextRenderingMode="ClearType"
                                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5" 
                                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" />
                                    </Grid>

                                </StackPanel>

                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Height="24" >
                                        <materialDesign:PackIcon Kind="AccountCog" Width="28" Height="28" Padding="0" Margin="0"
                                                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="{Lag:Localize UserSetting}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                   FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                    </StackPanel>
                                </Expander.Header>
                            </Expander>

                            <Expander HorizontalAlignment="Stretch" Margin="0,0,0,2"
                                      materialDesign:ExpanderAssist.HorizontalHeaderPadding="10,5,0,5"
                                      materialDesign:ExpanderAssist.VerticalHeaderPadding="0"
                                      materialDesign:ExpanderAssist.HeaderBackground="#7F888888"
                                      Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                      Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,2,0,0" >

                                    <Grid Width="500" Margin="0,0,0,2" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtbackground" Grid.Column="0" Height="43" BorderThickness="0.7" Padding="10,13,3,0"
                                                     Text="{Binding displaySetting.Background, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                     materialDesign:HintAssist.Hint="{Lag:Localize Background}"
                                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                                     TextOptions.TextFormattingMode="Display"
                                                     TextOptions.TextRenderingMode="ClearType"
                                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                                     materialDesign:ThemeAssist.Theme="Dark" >
                                            </TextBox>
                                            
                                            <xctk:ColorPicker Grid.Column="2" x:Name="colorbackground" Width="60"
                                                              Background="White" BorderThickness="0.7"
                                                              BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                              SelectedColor="{Binding displaySetting.SelectedBackground}" />
                                        </Grid>

                                        <Grid Grid.Column="2" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtforeground" Grid.Column="0" Height="43" BorderThickness="0.7" Padding="10,13,3,0"
                                                     Text="{Binding displaySetting.Foreground, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                     materialDesign:HintAssist.Hint="{Lag:Localize Foreground}"
                                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                                     TextOptions.TextFormattingMode="Display"
                                                     TextOptions.TextRenderingMode="ClearType"
                                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                                     materialDesign:ThemeAssist.Theme="Dark" >
                                            </TextBox>
                                            
                                            <xctk:ColorPicker Grid.Column="2" x:Name="colorforeground" Width="60"
                                                              Background="Transparent" BorderThickness="0.7"
                                                              BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                              SelectedColor="{Binding displaySetting.SelectedForeground}" />
                                        </Grid>

                                        <ComboBox x:Name="cmbtheme" Grid.Column="4" Height="43"
                                                  BorderThickness="0.7" IsEditable="False" Padding="10,18,12,5"
                                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  ItemsSource="{Binding displaySettingSource.Themes}"
                                                  SelectedItem="{Binding displaySetting.Theme}"
                                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                                  materialDesign:HintAssist.Hint="{Lag:Localize Theme}"
                                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                                  TextOptions.TextFormattingMode="Display"
                                                  TextOptions.TextRenderingMode="ClearType"
                                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                                            <ComboBox.Resources>
                                                <Style TargetType="ScrollBar">
                                                    <Setter Property="Background" Value="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Style>
                                            </ComboBox.Resources>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Width="500" Margin="0,0,0,2" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="cmbfontfamily" Grid.Column="0" Height="43"
                                                  BorderThickness="0.7" IsEditable="True" Padding="10,18,12,5"
                                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  ItemsSource="{Binding displaySettingSource.FontFamilys}"
                                                  SelectedItem="{Binding displaySetting.FontFamily, Converter={StaticResource FontFamilyConverter}, Mode=TwoWay}"
                                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                                  materialDesign:HintAssist.Hint="{Lag:Localize FontFamily}"
                                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                                  TextOptions.TextFormattingMode="Display"
                                                  TextOptions.TextRenderingMode="ClearType"
                                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                                            <ComboBox.Resources>
                                                <Style TargetType="ScrollBar">
                                                    <Setter Property="Background" Value="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Style>
                                            </ComboBox.Resources>
                                        </ComboBox>

                                        <Grid Grid.Column="2" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtfontsize" Grid.Column="0" Width="65" Height="43" BorderThickness="0.7" Padding="3,18,3,2"
                                                     Text="{Binding displaySetting.FontSize, Converter={StaticResource NullableIntConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                     VerticalAlignment="Stretch" HorizontalAlignment="Center"
                                                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                     materialDesign:HintAssist.Hint="{Lag:Localize FontSize}"
                                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                                     Behaviors:NumericOnlyBehavior.Enable="True"
                                                     TextOptions.TextFormattingMode="Display"
                                                     TextOptions.TextRenderingMode="ClearType"
                                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                                     materialDesign:ThemeAssist.Theme="Dark" />
                                            <Slider x:Name="slifontsize" Grid.Column="1" IsSelectionRangeEnabled="True" Margin="3,0,2,0"
                                                    Minimum="1" Maximum="100" Value="{Binding displaySetting.FontSize}" 
                                                    VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                    SelectionStart="10" SelectionEnd="20" TickFrequency="1" TickPlacement="None"
                                                    Style="{StaticResource MaterialDesignDiscreteSlider}" />
                                        </Grid>

                                        <ComboBox x:Name="cmbcodehighlight" Grid.Column="4" Height="43"
                                                  BorderThickness="0.7" IsEditable="False" Padding="10,18,12,5"
                                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  ItemsSource="{Binding displaySettingSource.HighLights}"
                                                  SelectedItem="{Binding displaySetting.HighLight}"
                                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                                  materialDesign:HintAssist.Hint="{Lag:Localize Highlight}"
                                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                                  TextOptions.TextFormattingMode="Display"
                                                  TextOptions.TextRenderingMode="ClearType"
                                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" />
                                    </Grid>

                                    <Grid Width="500" Margin="0,0,0,2" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="cmbFlowDirection" Grid.Column="0" Height="43"
                                                  BorderThickness="0.7" IsEditable="False" Padding="10,18,12,5"
                                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                  ItemsSource="{Binding FlowDirectionItems, Source={x:Static ViewModels:EnumsViewModel.Instance}}"
                                                  SelectedIndex="{Binding displaySetting.FlowDirectionC}"
                                                  DisplayMemberPath="DisplayName"
                                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                                  materialDesign:HintAssist.Hint="{Lag:Localize FlowDirection}"
                                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                                  TextOptions.TextFormattingMode="Display"
                                                  TextOptions.TextRenderingMode="ClearType"
                                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                                        </ComboBox>

                                        <ComboBox x:Name="cmbTextAlignment" Grid.Column="2" Height="43"
                                                  BorderThickness="0.7" IsEditable="False" Padding="10,18,12,5"
