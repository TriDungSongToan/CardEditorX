<Window x:Class="CardEditor.Views.SelectFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
        xmlns:dockablz="clr-namespace:Dragablz.Dockablz;assembly=Dragablz"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:Lag="clr-namespace:CardEditor.Localization"
        xmlns:Controls="clr-namespace:CardEditor.Controls"
        xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
        xmlns:Converter="clr-namespace:CardEditor.Converter"
        xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="Transparent"
        Foreground="{Binding displaySetting.Foreground}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        mc:Ignorable="d"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Title="Setting" Height="auto" Width="auto" >

    <Window.Resources>
        <Converter:EmptyToCollapsedConverter x:Key="EmptyToCollapsedConverter"/>
        <Style TargetType="ToolTip">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderThickness="0.5" Padding="6" CornerRadius="4">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              TextElement.Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                              TextElement.FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <materialDesign:Card UniformCornerRadius="5" d:FlowDirection="LeftToRight"
                         FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         BorderThickness="1,0,1,1" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border x:Name="blHeader" Height="28" Grid.Row="0" CornerRadius="5"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    BorderThickness="0,0,0,0" Padding="5,3,5,3"
                    MouseLeftButtonDown="blHeader_MouseLeftButtonDown" >
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Lag:Localize Open}" FontWeight="Medium" IsHitTestVisible="False"
                               HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5,0,0,0"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                    <TextBlock Text="{Lag:Localize File}" FontWeight="Medium" IsHitTestVisible="False"
                               HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5,0,0,0"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Height="300" Width="400" Margin="10,5,10,5" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" >
                    <TextBlock Text="{Lag:Localize selectOpenFile}"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                </Grid>

                <Border Grid.Row="2" BorderThickness="0.9" CornerRadius="3"
                        BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}">
                    <ListBox HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                             HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                             ItemsSource="{Binding FileList}" SelectionMode="Extended"
                             Behaviors:ListBoxSelectedItemsBehavior.SelectedItems="{Binding SelectedFiles}" >
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="ToolTip" Value="{Binding TooltipText}"/>
                                <EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding PrimaryText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SecondaryText}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding SecondaryText, Converter={StaticResource EmptyToCollapsedConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                
                <Grid Grid.Row="4" >
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" >
                        
                        <Button Width="auto" Height="30"
                                BorderThickness="0" Padding="15,5,15,5"
                                BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="5"
                                Style="{StaticResource ButtonSuccess}"
                                Command="{Binding OpenCommand}" >
                            <Viewbox Stretch="Uniform" StretchDirection="Both" Width="auto" >
                                <TextBlock Text="{Lag:Localize Open}" FontSize="15"
                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Viewbox>
                        </Button>

                        <Button Width="auto" Height="30"
                                BorderThickness="0" Padding="10,5,10,5" Margin="10,0,10,0"
                                BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="5"
                                Style="{StaticResource ButtonSuccess}"
                                Command="{Binding OpenAllCommand}" >
                            <Viewbox Stretch="Uniform" StretchDirection="Both" Width="auto" >
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Lag:Localize Open}" FontSize="15"
                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Lag:Localize All}" FontSize="15" Margin="5,0,0,0"
                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </StackPanel>

                            </Viewbox>
                        </Button>

                        <Button Width="auto" Height="30"
                                BorderThickness="0" Padding="10,5,10,5"
                                BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="5"
                                Style="{StaticResource ButtonSuccess}"
                                Command="{Binding CancelCommand}" >
                            <Viewbox Stretch="Uniform" StretchDirection="Both" Width="auto" >
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Lag:Localize cancel}" FontSize="15"
                                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </StackPanel>

                            </Viewbox>
                        </Button>
                        
                    </StackPanel>
                </Grid>
                
            </Grid>
        </Grid>
    </materialDesign:Card>
</Window>
