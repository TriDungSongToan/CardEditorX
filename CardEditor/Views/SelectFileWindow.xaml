<Window x:Class="CardEditor.Views.SelectFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
        xmlns:dockablz="clr-namespace:Dragablz.Dockablz;assembly=Dragablz"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:Lag="clr-namespace:CardEditor.Localization"
        xmlns:Controls="clr-namespace:CardEditor.Controls"
        xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
        xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
        xmlns:Converter="clr-namespace:CardEditor.Converter"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="Transparent"
        Foreground="{Binding displaySetting.Foreground}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        mc:Ignorable="d"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Title="Setting" Height="auto" Width="auto" >
    <materialDesign:Card UniformCornerRadius="5" d:FlowDirection="LeftToRight"
                         FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         BorderThickness="1,0,1,1" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border x:Name="blHeader" Height="28" Grid.Row="0" CornerRadius="5"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                    BorderThickness="0,0,0,0" Padding="5,3,5,3"
                    MouseLeftButtonDown="blHeader_MouseLeftButtonDown" >
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Images/Setting/setting.ico" Width="auto" Height="23" Margin="0,0,7,0"
                           IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Lag:Localize Config}" FontWeight="Medium" IsHitTestVisible="False"
                               HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="10,10,10,10" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" >
                        <Image x:Name="MessageIcon" Width="50" Height="50" Source="/Images/Message/Question.png" />
                    </Grid>

                    <Grid Grid.Column="2" Width="250" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" >
                            <TextBlock Text="Select File to Open:"
                                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                       FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </Grid>

                        <ComboBox x:Name="cmbFileList" Grid.Row="1" Height="43" Margin="0,10,0,10"
                                  BorderThickness="0.7" Padding="10,18,12,5" IsEditable="False"
                                  BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                  ItemsSource="{Binding FileLists}"
                                  SelectedItem="{Binding SelectedFile}"
                                  DisplayMemberPath="DisplayName"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  TextOptions.TextFormattingMode="Display"
                                  TextOptions.TextRenderingMode="ClearType"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" />

                    </Grid>
                </Grid>

                <Grid Grid.Row="1" >
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" >
                        <Button Content="Select" Width="80" Margin="0,0,10,0" Command="{Binding SelectCommand}" />
                        <Button Content="Cancel" Width="80" Command="{Binding CancelCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </materialDesign:Card>
</Window>
