                                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            </Viewbox>
                                                        </Grid>
                                                    </Button.Content>
                                                </Button>
