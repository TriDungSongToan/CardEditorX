                                                      FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                      FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                      HorizontalAlignment="Left" Style="{DynamicResource MaterialDesignMenu}">

                                                    <Menu.Resources>
                                                        <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
                                                            <Setter Property="Background" Value="Blue" />
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="Margin" Value="0" />
                                                            <Setter Property="Height" Value="35" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FF0044AA"/>
                                                                    <!-- Hover background -->
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <!-- Optional hover text -->
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Menu.Resources>

                                                    <MenuItem Margin="0" Padding="0" >
