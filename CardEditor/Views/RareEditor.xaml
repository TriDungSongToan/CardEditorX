                                                        Style="{StaticResource ButtonSuccess}" 
                                                        Command="{Binding SortCardCommand}">
                                                    <Button.InputBindings>
                                                        <MouseBinding Gesture="RightClick" Command="{Binding UnSortCardCommand}" />
                                                    </Button.InputBindings>
