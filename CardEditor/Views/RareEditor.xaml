                                                        Style="{StaticResource ButtonSuccess}"
                                                        Command="{Binding ModifyCardCommand}">
                                                    <Button.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FF30FFFF" Offset="0.0"/>
                                                            <GradientStop Color="#FF008EFF" Offset="0.35"/>
                                                        </LinearGradientBrush>
                                                    </Button.Background>
                                                    <Button.Content>
                                                        <Grid Width="118">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="5" />
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="2" />
                                                            </Grid.ColumnDefinitions>
                                                            <materialDesign:PackIcon Grid.Column="1" Kind="TextBoxEditOutline" Padding="0"
                                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" Width="28" Height="28" />
