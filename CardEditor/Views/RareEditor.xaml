                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FFAAFF90" Offset="0.0"/>
                                                            <GradientStop Color="#FF19D400" Offset="0.3"/>
                                                        </LinearGradientBrush>
                                                    </Button.Background>
                                                    <Button.Content>
                                                        <Grid Width="118">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="5" />
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="2" />
                                                            </Grid.ColumnDefinitions>
                                                            <materialDesign:PackIcon Grid.Column="1" Kind="CardPlusOutline" Padding="0"
                                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" Width="28" Height="28" />
                                                            <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="Both">
                                                                <TextBlock Text="{Lag:Localize tlAdd}"
                                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            </Viewbox>
                                                        </Grid>
                                                    </Button.Content>
                                                </Button>
