                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FFFFA5AA" Offset="0.0" />
                                                            <GradientStop Color="#FFF01717" Offset="0.4" />
                                                        </LinearGradientBrush>
                                                    </Button.Background>
