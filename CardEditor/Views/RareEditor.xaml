                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FF3E78FF" Offset="0.0" />
                                                            <GradientStop Color="#FF009DD1" Offset="0.4"/>
                                                        </LinearGradientBrush>
                                                    </Button.Background>
                                                    <Button.Content>
                                                        <Grid Width="118">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="5" />
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="2" />
                                                            </Grid.ColumnDefinitions>
                                                            <materialDesign:PackIcon Grid.Column="1" x:Name="iconSort" Padding="0"
                                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" Width="28" Height="28" />
                                                            <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="Both">
                                                                <TextBlock Text="{Lag:Localize Sort}"
                                                                           FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            </Viewbox>

                                                        </Grid>
                                                    </Button.Content>
                                                </Button>
                                            </Grid>

