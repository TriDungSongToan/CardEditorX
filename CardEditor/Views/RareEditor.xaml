                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" >
                        <materialDesign:Snackbar.Background>
                            <SolidColorBrush Color="Gray" Opacity="0.9" />
                        </materialDesign:Snackbar.Background>
                    </materialDesign:Snackbar>
                </Grid>
            </Grid>

            <Grid x:Name="grProgress" Grid.Row="2" Height="{Binding ProgressHeight}" Margin="0,0,0,0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="-15,0,-15,0" >
                        <Image x:Name="imgRunner" Panel.ZIndex="2"
                               Width="60" Height="60" Margin="0,0,0,-8"
                               gif:ImageBehavior.AnimatedSource="pack://application:,,,/Images/ImageGene.gif"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               RenderTransformOrigin="0.0,0.5">
                            <Image.RenderTransform>
                                <TranslateTransform X="{Binding RunnerOffsetX}" />
                            </Image.RenderTransform>
                        </Image>
                    </Grid>

