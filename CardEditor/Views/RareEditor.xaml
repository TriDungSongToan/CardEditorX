<Window x:Class="CardEditor.RareEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
        xmlns:viewport="clr-namespace:Han.Wpf.ViewportControl;assembly=Han.Wpf.ViewportControl"
        xmlns:sdl="clr-namespace:Sdl.MultiSelectComboBox.Themes.Generic;assembly=Sdl.MultiSelectComboBox"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:Behaviors="clr-namespace:CardEditor.Behaviors"
        xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
        xmlns:Lag="clr-namespace:CardEditor.Localization"
        xmlns:Controls="clr-namespace:CardEditor.Controls"
        xmlns:Converter="clr-namespace:CardEditor.Converter"
        xmlns:local="clr-namespace:CardEditor"
        xmlns:Beha="clr-namespace:CardEditor.Behaviors"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="Transparent"
        Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        mc:Ignorable="d"
        AllowsTransparency="True"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=ViewModels:RareViewModel}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Title="RareEditor" Height="auto" Width="auto">

    <Window.Resources>
        <ResourceDictionary>

            <Style TargetType="TextBox" x:Key="TextBoxBrowseStyle"
                   BasedOn="{StaticResource CustomMaterialDesignFilledTextBox}" >
                <Setter Property="BorderBrush" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="Background" Value="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="FontFamily" Value="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="FontSize" Value="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="TextAlignment" Value="{Binding TextAlignmentC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="BorderThickness" Value="0.7" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="10,12,70,2" />
                <Setter Property="Height" Value="auto" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="5" />
                <Setter Property="materialDesign:TextFieldAssist.UnderlineCornerRadius" Value="0,0,10,10" />
                <Setter Property="materialDesign:ThemeAssist.Theme" Value="Dark" />
            </Style>

            <Style TargetType="TextBox" x:Key="TextBoxStyle"
                   BasedOn="{StaticResource TextBoxBrowseStyle}" >
                <Setter Property="Padding" Value="10,12,10,2" />
            </Style>

            <Style TargetType="ComboBox" x:Key="ComboboxStyle"
                   BasedOn="{StaticResource MaterialDesignFilledComboBox}" >
                <Setter Property="BorderBrush" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="Background" Value="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="FontFamily" Value="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="FontSize" Value="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="IsEditable" Value="False" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="8,18,12,5" />
                <Setter Property="Height" Value="auto" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="BorderThickness" Value="0.7" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="5" />
                <Setter Property="materialDesign:TextFieldAssist.UnderlineCornerRadius" Value="0,0,10,10" />
                <Setter Property="materialDesign:ThemeAssist.Theme" Value="Dark" />
                <Setter Property="materialDesign:ColorZoneAssist.Mode" Value="Custom" />
            </Style>

            <Converter:IntSafeConverter x:Key="IntSafeConverter" />

            <Style x:Key="CustomDataGridHeaderStyle" TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                       Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                       Height="20" Margin="0" Padding="0" TextAlignment="Left" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="CenterDataGridCellElementStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="3,2,3,2"/>
                <Setter Property="Padding" Value="2"/>
            </Style>

            <Style x:Key="LeftDataGridCellElementStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="3,2,3,2"/>
                <Setter Property="Padding" Value="2"/>
            </Style>

            <Style x:Key="CellWithBorderStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0.3,0.4,0.3,0.4"/>
                <Setter Property="BorderBrush" Value="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridRow">
                            <Border x:Name="DGR_Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <SelectiveScrollingGrid>
                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </SelectiveScrollingGrid.ColumnDefinitions>
                                    <SelectiveScrollingGrid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </SelectiveScrollingGrid.RowDefinitions>
                                    <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    <DataGridDetailsPresenter Grid.Row="1" Grid.Column="1" Visibility="{TemplateBinding DetailsVisibility}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </SelectiveScrollingGrid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DGR_Border" Property="Background" Value="#FFE0F7FF"/>
                                    <Setter Property="Foreground" Value="Blue" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="DGR_Border" Property="Background" Value="#FF1976D2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="DGR_Border" Property="Background" Value="#FF1976D2"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Border" x:Key="BorderStyle">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#33FFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderThickness="0.5" Padding="6" CornerRadius="4">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                              TextElement.Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                              TextElement.FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.ControlTemplate.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.DropdownItemTemplate.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/MultiSelectComboBox.Custom.SelectedItemTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:Card UniformCornerRadius="5"
                         BorderThickness="1,0,1,1" BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                         d:FlowDirection="LeftToRight" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border x:Name="blRarityManager" Grid.Row="0" BorderThickness="0,0,0,0"
                    Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" 
                    Padding="0" CornerRadius="5" Margin="0,0,0,0"
                    Height="auto" MinHeight="35"
                    MouseLeftButtonDown="blRarityManager_MouseLeftButtonDown" >
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" >

                        <Border x:Name="btnRareFolderBorder" Width="50" CornerRadius="4"
                                VerticalAlignment="Stretch" >
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource BorderStyle}" >
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=btnRareFolder}" Value="True">
                                            <Setter Property="Background" Value="#72FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ToggleButton x:Name="btnRareFolder" Width="35" Height="35" Margin="0,0,0,0" Padding="0"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                          Background="Transparent" Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                          Style="{StaticResource MaterialDesignActionToggleButton}"
                                          BorderThickness="0" BorderBrush="Transparent"
                                          IsChecked="False" Checked="btnRareFolder_Checked" Unchecked="btnRareFolder_Unchecked" >
                                <materialDesign:PackIcon Kind="FolderEdit" Width="25" Height="25" />
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <materialDesign:PackIcon Kind="CardsOutline" Width="25" Height="25" />
                                </materialDesign:ToggleButtonAssist.OnContent>
                            </ToggleButton>
                        </Border>

                        <Border x:Name="btnRareListBorder" Width="50" CornerRadius="4"
                                VerticalAlignment="Stretch"  >
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource BorderStyle}" >
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=btnRareList}" Value="True">
                                            <Setter Property="Background" Value="#72FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <ToggleButton x:Name="btnRareList" Width="35" Height="35" Margin="0,0,0,0" Padding="0"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                          Background="Transparent" Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                          Style="{StaticResource MaterialDesignActionToggleButton}"
                                          BorderThickness="0" BorderBrush="Transparent"
                                          IsChecked="False" Checked="btnRareList_Checked" Unchecked="btnRareList_Unchecked" >
                                <materialDesign:PackIcon Kind="FormatListNumbered" Width="25" Height="25" />
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <materialDesign:PackIcon Kind="CardsOutline" Width="25" Height="25" />
                                </materialDesign:ToggleButtonAssist.OnContent>
                            </ToggleButton>
                        </Border>

                        <Button x:Name="btnMinimize"
                                Width="50" Height="35" Margin="0" Padding="0"
                                VerticalAlignment="Stretch" HorizontalAlignment="Center"
                                Background="Transparent" Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderThickness="0" BorderBrush="Transparent"
                                Click="btnMinimize_Click" >
                            <Button.Content>
                                <materialDesign:PackIcon Kind="WindowMinimize" Padding="0" Margin="0"
                                                         Width="20" Height="20"/>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}" >
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="btnMaximize" Visibility="Collapsed"
                                Width="50" Height="35" Margin="0" Padding="0"
                                VerticalAlignment="Stretch" HorizontalAlignment="Center"
                                Background="Transparent" Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderThickness="0" BorderBrush="Transparent"
                                Click="btnMaximize_Click" >
                            <Button.Content>
                                <materialDesign:PackIcon Kind="WindowMaximize" Padding="0" Margin="0"
                                                         Width="20" Height="20"/>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}" >
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="btnClose"
                                Width="50" Height="35" Margin="0" Padding="0"
                                VerticalAlignment="Stretch" HorizontalAlignment="Center"
                                Background="Transparent" Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                BorderThickness="0" BorderBrush="Transparent"
                                Click="btnClose_Click" >
                            <Button.Content>
                                <materialDesign:PackIcon Kind="WindowClose" Padding="0" Margin="0"
                                                         Width="20" Height="20"/>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}" >
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>

                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Grid.Column="0" Margin="8,0,0,0" >
                        <Image x:Name="imgHeader" Width="20" Height="20"
                               Source="pack://application:,,,/Images/Manager/Rarity.ico"
                               VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBlock x:Name="txtHeader" Margin="7,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                   Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                   FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="3" >
                <materialDesign:DrawerHost x:Name="RareManager" >

                    <materialDesign:DrawerHost.RightDrawerContent>
                        <Grid Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                              HorizontalAlignment="Stretch"
                              Width="{Binding ActualWidth, ElementName=RareManager}" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Margin="0" Padding="0" BorderThickness="1"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="415" Width="742"
                                    Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                    Panel.ZIndex="0" >
                                <DataGrid x:Name="datagrRareList" BorderThickness="1" Margin="0" Padding="0"
                                          Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                          Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                          FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                          FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                          IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                          CanUserDeleteRows="False" CanUserResizeColumns="True" CanUserSortColumns="False"
                                          CanUserAddRows="False"
                                          CanUserReorderColumns="True" CanUserResizeRows="True"
                                          ItemsSource="{Binding RareItemsView, Mode=OneWay}"
                                          SelectedItem="{Binding SelectedRareItem, Mode=TwoWay}"
                                          Beha:MultiSelectBehavior.SelectedItems="{Binding SelectedRareItems, Mode=TwoWay}"
                                          AutoGenerateColumns="False" HeadersVisibility="Column"
                                          SelectionMode="Extended" SelectionUnit="FullRow"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.IsContainerVirtualizable="True" >
                                    <DataGrid.Columns>
                                        <materialDesign:DataGridTextColumn Header="{Lag:Localize RarityIndex}" Binding="{Binding IdRare}"
                                                                           Width="80" MinWidth="60" MaxWidth="90"
                                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"
                                                                           HeaderStyle="{StaticResource CustomDataGridHeaderStyle}"
                                                                           ElementStyle="{StaticResource CenterDataGridCellElementStyle}"
                                                                           CellStyle="{StaticResource CellWithBorderStyle}" />
                                        <materialDesign:DataGridTextColumn Header="{Lag:Localize RarityName}" Binding="{Binding Name}"
                                                                           Width="140" MinWidth="120" MaxWidth="160"
                                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"
                                                                           HeaderStyle="{StaticResource CustomDataGridHeaderStyle}"
                                                                           ElementStyle="{StaticResource LeftDataGridCellElementStyle}"
                                                                           CellStyle="{StaticResource CellWithBorderStyle}" />
                                        <materialDesign:DataGridTextColumn Header="{Lag:Localize RarityCode}" Binding="{Binding DisplayCode}"
                                                                           Width="140" MinWidth="120" MaxWidth="160"
                                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"
                                                                           HeaderStyle="{StaticResource CustomDataGridHeaderStyle}"
                                                                           ElementStyle="{StaticResource LeftDataGridCellElementStyle}"
                                                                           CellStyle="{StaticResource CellWithBorderStyle}" />
                                        <materialDesign:DataGridTextColumn Header="{Lag:Localize RarityImgPath}" Binding="{Binding ImagePath}"
                                                                           EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"
                                                                           HeaderStyle="{StaticResource CustomDataGridHeaderStyle}"
                                                                           ElementStyle="{StaticResource LeftDataGridCellElementStyle}"
                                                                           CellStyle="{StaticResource CellWithBorderStyle}" />
                                    </DataGrid.Columns>
                                    <DataGrid.Resources>
                                        <Style TargetType="ScrollBar">
                                            <Setter Property="Background" Value="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Style>
                                    </DataGrid.Resources>
                                </DataGrid>
                            </Border>

                            <Grid Grid.Row="1" Margin="8,5,8,5" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" >
                                    <TextBox x:Name="txtIdRare" Height="48" Width="80" Padding="8,10,3,2" Margin="0"
                                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0.7"
                                             BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             TextAlignment="{Binding TextAlignmentC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             materialDesign:HintAssist.Hint="{Lag:Localize RarityIndex}"
                                             Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                             Text="{Binding IdRare, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True, TargetNullValue='', FallbackValue=''}"
                                             Behaviors:NumericOnlyBehavior.Enable="True"
                                             TextOptions.TextFormattingMode="Display"
                                             TextOptions.TextRenderingMode="ClearType"
                                             materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                                             materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                             materialDesign:ThemeAssist.Theme="Dark" />
                                </Grid>

                                <Grid Grid.Column="2" >
                                    <TextBox x:Name="txtRareName" Height="48" Width="150" Padding="8,10,3,2" Margin="0"
                                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0.7"
                                             BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             TextAlignment="{Binding TextAlignmentC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             materialDesign:HintAssist.Hint="{Lag:Localize RarityName}"
                                             Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                             Text="{Binding RareName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextOptions.TextFormattingMode="Display"
                                             TextOptions.TextRenderingMode="ClearType"
                                             materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                                             materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                             materialDesign:ThemeAssist.Theme="Dark" />
                                </Grid>

                                <Grid Grid.Column="4" >
                                    <TextBox x:Name="txtRareCode" Height="48" Width="80" Padding="8,10,3,2" Margin="0"
                                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
