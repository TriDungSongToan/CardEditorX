                                                            <MenuItem.Icon>
                                                                <Image Source="pack://application:,,,/Images/Scope/Selected.ico" Width="auto" Height="auto" Margin="0" />
                                                            </MenuItem.Icon>
                                                            
                                                        </MenuItem>

                                                        <MenuItem Header="{Lag:Localize FoundCards}" Margin="0" Padding="10,0,15,0"
                                                                  Command="{Binding DeleteFoundCardCommand}" >
                                                            <MenuItem.Icon>
                                                                <Image Source="pack://application:,,,/Images/Scope/Found.ico" Width="auto" Height="auto" Margin="0" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>

                                                        <MenuItem Header="{Lag:Localize AllCards}" Margin="0" Padding="10,0,15,0"
                                                                  Command="{Binding DeleteAllCardCommand}" >
