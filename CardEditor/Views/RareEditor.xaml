                                                        </MenuItem>
                                                        <MenuItem.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#FFFF9CA2" Offset="0.0" />
                                                                <GradientStop Color="#FFE96969" Offset="0.4" />
                                                            </LinearGradientBrush>
                                                        </MenuItem.Background>
                                                    </MenuItem>
                                                </Menu>
                                                <Button x:Name="btnDeleteCard" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
