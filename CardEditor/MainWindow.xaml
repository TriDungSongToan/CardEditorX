<mah:MetroWindow x:Class="CardEditor.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
                 xmlns:dockablz="clr-namespace:Dragablz.Dockablz;assembly=Dragablz"
                 xmlns:system="clr-namespace:System;assembly=mscorlib"
                 xmlns:main="clr-namespace:CardEditor"
                 xmlns:Commands="clr-namespace:CardEditor.Commands"
                 xmlns:Converter="clr-namespace:CardEditor.Converter"
                 xmlns:ViewModels="clr-namespace:CardEditor.ViewModels"
                 xmlns:Lag="clr-namespace:CardEditor.Localization"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
                 WindowStartupLocation="CenterScreen"
                 TitleCharacterCasing="Normal"
                 Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                 d:DataContext="{Binding Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                 SizeToContent="Manual"
                 ResizeMode="CanResize"
                 WindowState="Normal"
                 Loaded="MetroWindow_Loaded"
                 SizeChanged="MetroWindow_SizeChanged"
                 Closing="MetroWindow_Closing"
                 mc:Ignorable="d"
                 Title="CardEditor X"
                 Width="1220" Height="800"
                 >

    <mah:MetroWindow.WindowButtonCommands>
        <mah:WindowButtonCommands/>
    </mah:MetroWindow.WindowButtonCommands>
    <Window.Resources>
        <system:String x:Key="Partition">Beginning</system:String>

        <Converter:PositiveBoolToVisibilityConverter x:Key="PositiveBoolToVis"/>
        <Converter:NegativeBoolToVisibilityConverter x:Key="NegativeBoolToVis"/>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static Commands:CustomCommands.NewDatabase}" Executed="CommandNewDatabase_Executed" CanExecute="CommandBindingNew_CanExecute" />
        <CommandBinding Command="{x:Static Commands:CustomCommands.NewScript}" Executed="CommandNewScript_Executed" CanExecute="CommandBindingNew_CanExecute" />
        <CommandBinding Command="{x:Static Commands:CustomCommands.NewDeck}" Executed="CommandNewDeck_Executed" CanExecute="CommandBindingNew_CanExecute" />
        <CommandBinding Command="{x:Static Commands:CustomCommands.NewBanList}" Executed="CommandNewBanList_Executed" CanExecute="CommandBindingNew_CanExecute" />

        <CommandBinding Command="{x:Static Commands:CustomCommands.OpenArchive}" Executed="CommandOpenArchive_Executed" CanExecute="CommandBindingOpen_CanExecute" />
        <CommandBinding Command="{x:Static Commands:CustomCommands.OpenDatabase}" Executed="CommandOpenDatabase_Executed" CanExecute="CommandBindingOpen_CanExecute" />
        <CommandBinding Command="{x:Static Commands:CustomCommands.OpenScript}" Executed="CommandOpenScript_Executed" CanExecute="CommandBindingOpen_CanExecute" />
        <CommandBinding Command="{x:Static Commands:CustomCommands.OpenDeck}" Executed="CommandOpenDeck_Executed" CanExecute="CommandBindingOpen_CanExecute" />
        <CommandBinding Command="{x:Static Commands:CustomCommands.OpenBanList}" Executed="CommandOpenBanList_Executed" CanExecute="CommandBindingOpen_CanExecute" />
        
        <CommandBinding Command="{x:Static Commands:CustomCommands.Save}" Executed="CommandSave_Executed" CanExecute="CommandSave_CanExecute" />
        <CommandBinding Command="{x:Static Commands:CustomCommands.SaveAs}" Executed="CommandSaveAs_Executed" CanExecute="CommandSaveAs_CanExecute" />
        <CommandBinding Command="{x:Static Commands:CustomCommands.Setting}" Executed="CommandSetting_Executed" CanExecute="CommandBindingSetting_CanExecute" />
    </Window.CommandBindings>

    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands Background="Transparent">
            <Border x:Name="BorderLeftWindowCommands" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="0"
                    MouseLeftButtonDown="BorderLeftWindowCommands_MouseLeftButtonDown" >
                <StackPanel Orientation="Horizontal" >
                    <TextBlock x:Name="txtTitle" IsHitTestVisible="False" Margin="3,0,5,0"
                               Background="Transparent"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    <TextBlock Text="*" IsHitTestVisible="False" Margin="0,0,5,0"
                               Background="Transparent"
                               Visibility="{Binding IsSaved, Converter={StaticResource PositiveBoolToVis}}"
                               Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                               HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                </StackPanel>
                
            </Border>
        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>
    
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands Background="Transparent">
            <Button x:Name="btnAbout" Width="46" Height="auto" OverridesDefaultStyle="True"
                    Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="0" Margin="0" Padding="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip="{Lag:Localize About}" Click="btnAbout_Click" >
                <Button.Content>
                    <materialDesign:PackIcon Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                             Width="28" Height="28" Kind="InformationSlabSymbol" />
                </Button.Content>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#88808080"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <Grid FlowDirection="{Binding FlowDirectionC, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
          d:FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" >
            <Menu x:Name="menudatamain" materialDesign:MenuAssist.TopLevelMenuItemHeight="25" Margin="0" Padding="0"
                  Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                  Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                  FontFamily="{Binding FontFamily, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                  FontSize="{Binding FontSize, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                  HorizontalAlignment="Stretch" Style="{DynamicResource MaterialDesignMenu}" >

                <MenuItem Header="{Lag:Localize File}" Margin="0" Padding="10,0,10,0" >
                    <!--New-->
                    <MenuItem Header="{Lag:Localize tNew}" Margin="0" Padding="10,0,15,0" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/File/New/New.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>

                        <!--New Database-->
                        <MenuItem Header="{Lag:Localize CardDB}" InputGestureText="Ctrl + N + D  "
                                  Command="{x:Static Commands:CustomCommands.NewDatabase}"
                                  Margin="0" Padding="10,0,0,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/File/New/NewDatabase.ico" Width="auto" Height="auto" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <!--New Script-->
                        <MenuItem Header="{Lag:Localize CardScript}" InputGestureText="Ctrl + N + S  "
                                  Command="{x:Static Commands:CustomCommands.NewScript}"
                                  Margin="0" Padding="10,0,0,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/File/New/NewScript.ico" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <!--New Deck-->
                        <MenuItem Header="{Lag:Localize Deck}" InputGestureText="Ctrl + N + K  "
                                  Command="{x:Static Commands:CustomCommands.NewDeck}"
                                  Margin="0" Padding="10,0,0,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/Win/Deckeditor.ico" Width="auto" Height="auto" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <!--New BanList-->
                        <MenuItem Header="{Lag:Localize BanList}" InputGestureText="Ctrl + N + B  "
                                  Command="{x:Static Commands:CustomCommands.NewBanList}"
                                  Margin="0" Padding="10,0,0,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/Win/Banlisteditor.ico" Width="auto" Height="auto" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <!--Open-->
                    <MenuItem Header="{Lag:Localize Open}" Margin="0" Padding="10,0,15,0" >

                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/File/Open/Open.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>

                        <!--Open Archive-->
                        <MenuItem Header="{Lag:Localize CardArchive}" InputGestureText="Ctrl + O + A  "
                                  Command="{x:Static Commands:CustomCommands.OpenArchive}"
                                  Margin="0" Padding="10,0,0,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/File/Open/OpenDatabase.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <!--Open DB-->
                        <MenuItem Header="{Lag:Localize cardDB}" InputGestureText="Ctrl + O + D  "
                                  Command="{x:Static Commands:CustomCommands.OpenDatabase}"
                                  Margin="0" Padding="10,0,0,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/File/Open/OpenDatabase.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <!--Open Script-->
                        <MenuItem Header="{Lag:Localize cardScript}" InputGestureText="Ctrl + O + S  "
                                  Command="{x:Static Commands:CustomCommands.OpenScript}"
                                  Margin="0" Padding="10,0,0,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/File/Open/OpenScript.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <!--Open Deck-->
                        <MenuItem Header="{Lag:Localize Deck}" InputGestureText="Ctrl + O + K  "
                                  Command="{x:Static Commands:CustomCommands.OpenDeck}"
                                  Margin="0" Padding="10,0,0,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/Win/Deckeditor.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <!--Open BanList-->
                        <MenuItem Header="{Lag:Localize BanList}" InputGestureText="Ctrl + O + B  "
                                  Command="{x:Static Commands:CustomCommands.OpenBanList}"
                                  Margin="0" Padding="10,0,0,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/Win/Banlisteditor.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <!--Recent Open-->
                    <MenuItem x:Name="menuRecentOpen" Header="{Lag:Localize Recently}" Margin="0" Padding="10,0,15,0" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/File/Open/Open.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>

                        <MenuItem x:Name="menuRecentArchive" Header="{Lag:Localize CardArchive}" Margin="0" Padding="10,0,15,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/File/Open/OpenDatabase.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="menuRecentDatabases" Header="{Lag:Localize cardDB}" Margin="0" Padding="10,0,15,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/File/Open/OpenDatabase.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="menuRecentScripts" Header="{Lag:Localize cardScript}" Margin="0" Padding="10,0,15,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/File/Open/OpenScript.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="menuRecentDeck" Header="{Lag:Localize Deck}" Margin="0" Padding="10,0,15,0">
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/Win/Deckeditor.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="menuRecentBanList" Header="{Lag:Localize BanList}" Margin="0" Padding="10,0,15,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/Win/Banlisteditor.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <!--Save cdb-->
                    <MenuItem x:Name="menuSaveCdb" Header="{Lag:Localize Save}"
                              Visibility="{Binding DataEditVisibility}" Margin="0" Padding="10,0,15,0" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/File/Save/Save.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>

                        <!--cdb-->
                        <MenuItem x:Name="menuSaveDB" Header="{Lag:Localize cardDB}" Click="menuSaveDB_Click"
                                  ToolTip="{Lag:Localize toolSaveDB}" Margin="0" Padding="10,0,15,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/File/Save/SaveCdb.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <!--ceds-->
                        <MenuItem x:Name="menuSaveCeds" Header="{Lag:Localize Ceds}" Click="menuSaveCeds_Click"
                                  ToolTip="{Lag:Localize toolSaveCeds}" Margin="0" Padding="10,0,15,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/File/Save/SaveCeds.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <!--excel-->
                        <MenuItem Header="{Lag:Localize Excel}" Click="menuSaveExcel_Click"
                                  ToolTip="{Lag:Localize toolSaveExcel}" Margin="0" Padding="10,0,15,0" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/File/Save/SaveExcel.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <!--Save-->
                    <MenuItem x:Name="menuSave" Header="{Lag:Localize Save}" InputGestureText="Ctrl + S  "
                              Visibility="{Binding SaveVisibility}" Command="{x:Static Commands:CustomCommands.Save}"
                              Margin="0" Padding="10,0,15,0" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/File/Save/SaveLua.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <!--save as cdb-->
                    <MenuItem x:Name="menuSaveAsCdb" Header="{Lag:Localize SaveAs}"
                              Visibility="{Binding DataEditVisibility}" Margin="0" Padding="10,0,15,0"
                              ToolTip="{Lag:Localize toolSaveAsDB}" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/File/Save/SaveAs.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                        <MenuItem x:Name="menuSaveAsSelectedCard" Header="{Lag:Localize SelectCards}" Margin="0" Padding="10,0,15,0"
                                  ToolTip="{Lag:Localize toolSelectCards}" Click="menuSaveAsSelectedCard_Click" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Scope/Selected.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="menuSaveAsFiltedCard" Header="{Lag:Localize foundCards}" Margin="0" Padding="10,0,15,0"
                                  ToolTip="{Lag:Localize toolFoundCards}" Click="menuSaveAsFiltedCard_Click" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Scope/Found.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="menuSaveAsAllCard" Header="{Lag:Localize allCards}" Margin="0" Padding="10,0,15,0"
                                  ToolTip="{Lag:Localize toolAllCards}" Click="menuSaveAsAllCard_Click" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Scope/All.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <!--save as-->
                    <MenuItem x:Name="menuSaveAs" Header="{Lag:Localize SaveAs}" InputGestureText="Ctrl + Shift + S  "
                              Visibility="{Binding SaveVisibility}" Command="{x:Static Commands:CustomCommands.SaveAs}"
                              Margin="0" Padding="10,0,15,0" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/File/Save/SaveAs.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <Separator />
                    <MenuItem x:Name="menuexit" Header="{Lag:Localize Exit}" Click="menuexit_Click" InputGestureText="Alt + F4  "
                              Margin="0" Padding="10,0,15,0" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/File/Exit.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="{Lag:Localize Window}" Margin="0" Padding="10,0,10,0" >
                    <MenuItem Header="{Lag:Localize ImageEdit}" Margin="0" Padding="10,0,15,0" Click="menuimgeditor_Click" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Win/Imageditor.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Lag:Localize DataEdit}" Margin="0" Padding="10,0,15,0" Click="menudataeditor_Click" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Win/Dataeditor.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Lag:Localize DeckEdit}" Margin="0" Padding="10,0,15,0"  Click="menudeckeditor_Click" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Win/Deckeditor.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Lag:Localize CodeEdit}" Margin="0" Padding="10,0,15,0" Click="menucodeeditor_Click" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Win/Codeditor.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Lag:Localize BanListEdit}" Margin="0" Padding="10,0,15,0" Click="menubanlisteditor_Click" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Win/Banlisteditor.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Chat Bot" Margin="0" Padding="10,0,15,0"  Click="menuchatbot_Click" >
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Robot" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Lag:Localize ScriptSupport}" ToolTip="{Lag:Localize toolScriptSP}" Margin="0" Padding="10,0,15,0" Click="menuScriptSupport_Click" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/SSS.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="{Lag:Localize Setting}" Margin="0" Padding="10,0,10,0" >
                    <MenuItem x:Name="menuconfig" Header="{Lag:Localize Config}" InputGestureText="Alt + S  "
                              Command="{x:Static Commands:CustomCommands.Setting}"
                              Margin="0" Padding="10,0,15,0" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Setting/Setting.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem x:Name="menuCard" Header="{Lag:Localize Card}"
                          Visibility="{Binding CardVisibility}" Margin="0" Padding="10,0,10,0" >
                    <MenuItem Header="{Lag:Localize copyCard}" ToolTip="{Lag:Localize toolCopy}" Margin="0" Padding="10,0,15,0" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Card/Copy.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                        <MenuItem Header="{Lag:Localize SelectCards}" ToolTip="{Lag:Localize toolSelectCards}"
                                  Margin="0" Padding="10,0,15,0" Click="MenuItemCopySelected_Click">
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Scope/Selected.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Lag:Localize foundCards}" ToolTip="{Lag:Localize toolFoundCards}"
                                  Margin="0" Padding="10,0,15,0" Click="menuCopyFilted_Click" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Scope/Found.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Lag:Localize allCards}" ToolTip="{Lag:Localize toolAllCards}"
                                  Margin="0" Padding="10,0,15,0" Click="MenuItemCopyAll_Click" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Scope/All.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="{Lag:Localize pasteCard}" ToolTip="{Lag:Localize toolPaste}"
                              Margin="0" Padding="10,0,15,0" Click="MenuItemPaste_Click" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Card/Paste.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem x:Name="menuItemFilterCard" Header="{Lag:Localize tlFilter}"
                              Margin="0" Padding="10,0,15,0" Click="menuItemFilterCard_Click"  >
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="FilterMultipleOutline" Width="auto" Height="auto" Margin="0"
                                                     Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="Filter With CDB File" ToolTip="{Lag:Localize toolFilterCDB}" Visibility="Collapsed"
                              Margin="0" Padding="10,0,15,0" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Card/Filter.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                        <MenuItem x:Name="filterCDBDuplicate" Header="{Lag:Localize DupliCards}" Margin="0" Padding="10,0,15,0"
                                  ToolTip="{Lag:Localize toolFilDupliCDB}" Click="filterCDBDuplicate_Click" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/Card/Duplicate.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="filterCDBDifferent" Header="{Lag:Localize DiffCards}" Margin="0" Padding="10,0,15,0"
                                  ToolTip="{Lag:Localize toolFilDiffCDB}" Click="filterCDBDifferent_Click" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/Card/Different.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="Filter With YDK File" ToolTip="{Lag:Localize toolFilterYDK}" Visibility="Collapsed"
                              Margin="0" Padding="10,0,15,0" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Card/Filter.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
