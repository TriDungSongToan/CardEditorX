                    </MenuItem>
                </MenuItem>

                <MenuItem x:Name="menuData" Header="{Lag:Localize Data}"
                          Visibility="{Binding CardVisibility}" Margin="0" Padding="10,0,10,0" >

                    <MenuItem Header="{Lag:Localize Export}" Visibility="{Binding DataEditVisibility}"
                              Margin="0" Padding="10,0,15,0" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Data/Export/Export.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                        <MenuItem Header="{Lag:Localize ExpoZIP}" Visibility="{Binding DataEditVisibility}"
                                  Margin="0" Padding="10,0,15,0" ToolTip="{Lag:Localize toolExportZIP}">
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/Data/Export/ExportZip.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                            <MenuItem x:Name="exportzipSelected" Header="{Lag:Localize SelectCards}" Margin="0" Padding="10,0,15,0"
                                      ToolTip="{Lag:Localize toolSelectCards}" Click="exportzipSelected_Click" >
                                <MenuItem.Icon>
                                    <Image Source="pack://application:,,,/Images/Scope/Selected.ico" Width="auto" Height="auto" Margin="0" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="exportzipFilted" Header="{Lag:Localize foundCards}" Margin="0" Padding="10,0,15,0"
                                      ToolTip="{Lag:Localize toolFoundCards}" Click="exportzipFilted_Click" >
                                <MenuItem.Icon>
                                    <Image Source="pack://application:,,,/Images/Scope/Found.ico" Width="auto" Height="auto" Margin="0" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="exportzipAll" Header="{Lag:Localize allCards}" Margin="0" Padding="10,0,15,0"
                                      ToolTip="{Lag:Localize toolAllCards}" Click="exportzipAll_Click" >
                                <MenuItem.Icon>
                                    <Image Source="pack://application:,,,/Images/Scope/All.ico" Width="auto" Height="auto" Margin="0" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="{Lag:Localize ExpoCeds}" Visibility="{Binding DataEditVisibility}"
                                  Margin="0" Padding="10,0,15,0" ToolTip="{Lag:Localize toolExportCeds}" >
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/Data/Export/ExportCeds.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                            <MenuItem x:Name="exportcedsSelected" Header="{Lag:Localize SelectCards}" Margin="0" Padding="10,0,15,0"
                                      ToolTip="{Lag:Localize toolSelectCards}" Click="exportcedsSelected_Click" >
                                <MenuItem.Icon>
                                    <Image Source="pack://application:,,,/Images/Scope/Selected.ico" Width="auto" Height="auto" Margin="0" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="exportcedsFilted" Header="{Lag:Localize foundCards}" Margin="0" Padding="10,0,15,0"
                                      ToolTip="{Lag:Localize toolFoundCards}" Click="exportcedsFilted_Click" >
                                <MenuItem.Icon>
                                    <Image Source="pack://application:,,,/Images/Scope/Found.ico" Width="auto" Height="auto" Margin="0" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="exportcedsAll" Header="{Lag:Localize allCards}" Margin="0" Padding="10,0,15,0"
                                      ToolTip="{Lag:Localize toolAllCards}" Click="exportcedsAll_Click" >
                                <MenuItem.Icon>
                                    <Image Source="pack://application:,,,/Images/Scope/All.ico" Width="auto" Height="auto" Margin="0" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="{Lag:Localize ExpoExcel}" Visibility="{Binding DataEditVisibility}"
                                  Margin="0" Padding="10,0,15,0" ToolTip="{Lag:Localize toolExportExcel}">
                            <MenuItem.Icon>
                                <Image Source="pack://application:,,,/Images/Menu/Data/Export/ExportExcel.ico" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                            <MenuItem x:Name="exportExcelSelected" Header="{Lag:Localize SelectCards}" Margin="0" Padding="10,0,15,0"
                                      ToolTip="{Lag:Localize toolSelectCards}" Click="exportExcelSelected_Click" >
                                <MenuItem.Icon>
                                    <Image Source="pack://application:,,,/Images/Scope/Selected.ico" Width="auto" Height="auto" Margin="0" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="exportExcelFilted" Header="{Lag:Localize foundCards}" Margin="0" Padding="10,0,15,0"
                                      ToolTip="{Lag:Localize toolFoundCards}" Click="exportExcelFilted_Click" >
                                <MenuItem.Icon>
                                    <Image Source="pack://application:,,,/Images/Scope/Found.ico" Width="auto" Height="auto" Margin="0" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="exportExcelAll" Header="{Lag:Localize allCards}" Margin="0" Padding="10,0,15,0"
                                      ToolTip="{Lag:Localize toolAllCards}" Click="exportExcelAll_Click" >
                                <MenuItem.Icon>
                                    <Image Source="pack://application:,,,/Images/Scope/All.ico" Width="auto" Height="auto" Margin="0" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="{Lag:Localize importData}" Visibility="{Binding CardVisibility}"
                              Margin="0" Padding="10,0,15,0" Click="menuImport_Click" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Data/Import/Import.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="{Lag:Localize replaceText}" Visibility="{Binding DataEditVisibility}"
                              Margin="0" Padding="10,0,15,0" ToolTip="{Lag:Localize toolReplaceText}" Click="menuReplace_Click" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Data/Replace.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="{Lag:Localize ItemsEdit}" Visibility="{Binding CardVisibility}"
                              Margin="0" Padding="10,0,15,0" Click="menuItemEditor_Click">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="TextBoxEditOutline" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="{Lag:Localize Manager}" Margin="0" Padding="10,0,10,0" >
                    <MenuItem Header="{Lag:Localize RarityManager}" Margin="0" Padding="10,0,15,0"
                              ToolTip="{Lag:Localize toolRarityManager}" Click="menuRarity_Click" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Manager/Rarity.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Lag:Localize GenesysManager}" Margin="0" Padding="10,0,15,0"
                              ToolTip="{Lag:Localize toolGenesysManager}" Click="MenuGenesys_Click">
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Manager/Genesys.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="{Lag:Localize Help}" Margin="0" Padding="10,0,10,0" >
                    <MenuItem x:Name="menulinter" Header="{Lag:Localize LinScript}" Click="menulinter_Click"
                              Visibility="{Binding ScriptEditVisibility}" ToolTip="{Lag:Localize toolAnalyze}"
                              Margin="0" Padding="10,0,15,0" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Help/Linter.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="{Lag:Localize chkUpdate}" Margin="0" Padding="10,0,15,0" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Help/Update.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                        <MenuItem Header="Card Data" Margin="0" Padding="10,0,15,0" Click="CardDataChkUpdate_Click" >
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="DatabaseSyncOutline" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Card Image" Margin="0" Padding="10,0,15,0" Click="CardImageChkUpdate_Click" >
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="ImageRefresh" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="Registry" Margin="0" Padding="10,0,15,0" >
                        <MenuItem.Icon>
                            <Image Source="pack://application:,,,/Images/Menu/Help/Registry.ico" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                        <MenuItem Header="Register Registry" Margin="0" Padding="10,0,15,0"
                                  ToolTip="{Lag:Localize toolRegistry}" Click="RegisterRegistry_Click" >
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="KeyPlus" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Unregister Registry" Margin="0" Padding="10,0,15,0"
                                  Click="UnregisterRegistry_Click" >
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="KeyMinus" Width="auto" Height="auto" Margin="0" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                </MenuItem>

                <MenuItem x:Name="menuDev" Header="Developer" Margin="0" Padding="10,0,10,0" >
                    <MenuItem Header="Developer Tools" Margin="0" Padding="10,0,15,0" Click="DevrloperTool_Click" >
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="DeveloperBoard" Width="auto" Height="auto" Margin="0" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>
        </Grid>

        <Grid Grid.Row="1" >
            
            <Grid IsHitTestVisible="True" Panel.ZIndex="0" >
                <Grid.RowDefinitions>
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Panel.ZIndex="0" >
                    <Image x:Name="imgmainbg" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>

                <!--SelectedItem="{Binding Source={x:Static local:DataViewModel.Instance}, Path=SelectedTab, Mode=TwoWay}"-->
                <Grid Grid.Row="0" Panel.ZIndex="1" >
                    <dockablz:Layout Background="Transparent" Partition="{StaticResource Partition}" >
                        <dragablz:TabablzControl x:Name="TabControlMain"
                                                 
                                                 Background="Transparent"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch"
                                                 HorizontalContentAlignment="Stretch"
                                                 VerticalContentAlignment="Stretch"
                                                 ShowDefaultCloseButton="True"
                                                 ShowDefaultAddButton="True"
                                                 SnapsToDevicePixels="True"
                                                 AdjacentHeaderItemOffset="0"
                                                 TabStripPlacement="Top"
                                                 ConsolidateOrphanedItems="True"
                                                 FixedHeaderCount="0"    
                                                 ItemsSource="{Binding Tabs, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 materialDesign:NavigationRailAssist.SelectionCornerRadius="10"
                                                 materialDesign:ColorZoneAssist.Mode="PrimaryMid"
                                                 materialDesign:NavigationRailAssist.ShowSelectionBackground="False"
                                                 NewItemFactory="TabControlMain_NewItemFactory"
                                                 SelectionChanged="TabControlMain_SelectionChanged"
                                                 ClosingItemCallback="TabControlMain_ClosingItemCallback"
                                                 >

                            <dragablz:TabablzControl.InterTabController>
                                <dragablz:InterTabController Partition="{StaticResource Partition}" />
                            </dragablz:TabablzControl.InterTabController>

                            <!--<dragablz:TabablzControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Header, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               Background="{Binding Source={x:Static Core:DataViewModel.Instance}, Path=Background, FallbackValue=Black}"
                                               Foreground="{Binding Source={x:Static Core:DataViewModel.Instance}, Path=Foreground, FallbackValue=White}"
                                               />
                                </DataTemplate>
                            </dragablz:TabablzControl.ItemTemplate>-->

                            <dragablz:TabablzControl.ContentTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding Content}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch" />
                                </DataTemplate>
                            </dragablz:TabablzControl.ContentTemplate>
                        </dragablz:TabablzControl>
                    </dockablz:Layout>

                    <Canvas x:Name="canvas" >
                        <materialDesign:PackIcon x:Name="ChatIcon"
                                                 Opacity="0.7"
                                                 Kind="MessageReplyText" Cursor="Hand"
                                                 Width="40" Height="40"
                                                 Foreground="{Binding Foreground, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                                 Background="Transparent"
                                                 MouseEnter="ChatIcon_MouseEnter"
                                                 MouseLeftButtonDown="ChatIcon_MouseLeftButtonDown"
                                                 MouseMove="ChatIcon_MouseMove"
                                                 MouseLeftButtonUp="ChatIcon_MouseLeftButtonUp"
                                                 MouseLeave="ChatIcon_MouseLeave" />
                    </Canvas>
                </Grid>
            </Grid>

            <Grid x:Name="gridChat" Panel.ZIndex="3" Background="Transparent" 
                  VerticalAlignment="Stretch" HorizontalAlignment="Right"
                  IsHitTestVisible="True" Visibility="Visible" Margin="0,1,0,4" >
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="DrawerTransform" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="13" x:Name="grHeader" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" >
                    <Border x:Name="blMainChat" Background="{Binding Background, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                            BorderThickness="0,1,1,1" BorderBrush="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                            Padding="0" Margin="0" CornerRadius="5"
                            HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.3" />
                        </Border.Effect>
                        <main:ChatBotControl />
                    </Border>

                    <Border x:Name="DragHandle" Grid.Column="0" Width="9" Panel.ZIndex="3"
                            Background="Transparent" Cursor="SizeWE" Margin="-4,0,0,0"
                            HorizontalAlignment="Left"
                            MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                            MouseMove="DragHandle_MouseMove"
                            MouseLeftButtonUp="DragHandle_MouseLeftButtonUp"
                            MouseLeave="DragHandle_MouseLeave" >
                        <Border Background="{Binding ThemeColor, Source={x:Static ViewModels:UIConfigViewModel.Instance}}"
                                Width="1" HorizontalAlignment="Center" Margin="0" />
                    </Border>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
    
</mah:MetroWindow>
